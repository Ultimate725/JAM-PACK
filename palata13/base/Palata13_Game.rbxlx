<Item class="ReplicatedStorage" referent="RBX00004D95"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00004D96"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00004D97"><Properties><string name="Name">BattlePass</string><ProtectedString name="Source"><![CDATA[-- БАТЛПАСС: 30 уровней, бесплатная и премиум дорожки
local Config = require(script.Parent.Config)

local BP = {}
BP.SeasonName = "СЕЗОН 1: БЕССОННИЦА"
BP.XPPerTier = 120
BP.MaxTier = 30

local function coins(n)
	return { type = "coins", amount = n }
end
local function light(id)
	return { type = "flashlight", id = id }
end
local function title(id)
	return { type = "title", id = id }
end
local function revive(n)
	return { type = "revive", amount = n }
end

local free = {
	coins(50), coins(60), revive(1), coins(70), title("Survivor"),
	coins(80), coins(90), revive(1), coins(100), light("Moon"),
	coins(110), coins(120), title("Nightwalker"), coins(130), revive(1),
	coins(140), coins(150), coins(160), revive(1), light("Ember"),
	coins(170), coins(180), coins(190), revive(1), title("Insomniac"),
	coins(200), coins(210), coins(220), revive(1), title("Ward13"),
}

local premium = {
	coins(150), light("Blood"), coins(200), revive(2), title("Butcher"),
	coins(250), coins(250), revive(2), coins(300), light("Void"),
	coins(300), title("Patient"), coins(350), revive(2), coins(400),
	coins(400), revive(3), coins(450), coins(450), light("Aurora"),
	coins(500), revive(3), coins(500), coins(550), title("Nightmare"),
	coins(600), revive(3), coins(700), coins(800), title("Eye"),
}

BP.Tiers = {}
for i = 1, BP.MaxTier do
	BP.Tiers[i] = { free = free[i], premium = premium[i] }
end

function BP.tierFromXP(xp)
	return math.clamp(math.floor((xp or 0) / BP.XPPerTier), 0, BP.MaxTier)
end

function BP.progress(xp)
	local tier = BP.tierFromXP(xp)
	if tier >= BP.MaxTier then
		return tier, 1
	end
	return tier, ((xp or 0) % BP.XPPerTier) / BP.XPPerTier
end

function BP.describe(reward)
	if not reward then
		return "—"
	end
	if reward.type == "coins" then
		return reward.amount .. " монет"
	elseif reward.type == "revive" then
		return "Жетон возр. x" .. reward.amount
	elseif reward.type == "flashlight" then
		return "Фонарик: " .. Config.getFlashlight(reward.id).name
	elseif reward.type == "title" then
		local t = Config.getTitle(reward.id)
		return "Титул: " .. (t and t.name or reward.id)
	end
	return "?"
end

function BP.icon(reward)
	if not reward then
		return ""
	end
	if reward.type == "coins" then
		return "🪙"
	elseif reward.type == "revive" then
		return "✚"
	elseif reward.type == "flashlight" then
		return "🔦"
	elseif reward.type == "title" then
		return "🏷"
	end
	return "?"
end

return BP
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D98"><Properties><string name="Name">ClientData</string><ProtectedString name="Source"><![CDATA[-- Клиентская копия данных игрока (монеты, батлпасс, фонарики...)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientData = {}
ClientData.data = nil

local changed = Instance.new("BindableEvent")
ClientData.Changed = changed.Event

local started = false

function ClientData.start()
	if started then
		return
	end
	started = true
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes:WaitForChild("DataUpdated").OnClientEvent:Connect(function(data)
		ClientData.data = data
		changed:Fire(data)
	end)
	task.spawn(function()
		local getData = remotes:WaitForChild("GetData")
		for _ = 1, 30 do
			local ok, data = pcall(function()
				return getData:InvokeServer()
			end)
			if ok and data then
				ClientData.data = data
				changed:Fire(data)
				return
			end
			task.wait(1)
		end
	end)
end

function ClientData.get()
	return ClientData.data
end

function ClientData.wait()
	while not ClientData.data do
		ClientData.Changed:Wait()
	end
	return ClientData.data
end

return ClientData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D99"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	ПАЛАТА 13 — ГЛАВНЫЙ КОНФИГ
	Этот файл лежит в ОБОИХ плейсах (Лобби и Больница). Меняй его одинаково в обоих!
	Все ID — просто числа. 0 = не настроено (игра не сломается, просто функция будет выключена).
]]

local Config = {}

Config.GameName = "ПАЛАТА 13"
Config.Version = "v1.0"

-- 1) ID ПЛЕЙСОВ ------------------------------------------------------------
-- Creator Hub -> твоя игра -> Places. Лобби = стартовый плейс, Больница = второй плейс.
Config.LobbyPlaceId = 0
Config.GamePlaceId = 0

Config.MaxPlayersPerRound = 4
Config.QueueCountdown = 20 -- секунд на вратах перед телепортом

-- 2) ЗВУКИ (загрузи .ogg из папки Sounds и вставь ID) -------------------
Config.Sounds = {
	FlashlightOn = 0,
	FlashlightOff = 0,
	MonsterStep = 0,
	MonsterBreath = 0,
	MonsterScream = 0,
	ChaseSting = 0,
	Ambience = 0,
	MenuMusic = 0,
	Heartbeat = 0,
	Static = 0,
	UIHover = 0,
	UIClick = 0,
	Pickup = 0,
	FuseInsert = 0,
	GeneratorOn = 0,
	Purchase = 0,
	Teleport = 0,
	Whisper = 0,
	LightBuzz = 0,
	MetalBang = 0,
}

-- 3) МАГАЗИН ЗА РОБУКСЫ ----------------------------------------------------
-- Game Pass (покупается 1 раз): Creator Hub -> Monetization -> Passes
Config.GamePasses = {
	PremiumPass = 0, -- Премиум-дорожка батлпасса
	VIP = 0, -- x2 монет за раунды + титул VIP
	BigBattery = 0, -- батарея фонарика садится в 2 раза медленнее + ярче луч
}

-- Developer Products (можно покупать много раз): Monetization -> Developer Products
Config.Products = {
	Coins100 = 0,
	Coins500 = 0,
	Coins1500 = 0,
	SkipTier = 0, -- +1 уровень батлпасса
	Revive = 0, -- возрождение в раунде (или +1 жетон, если куплено в лобби)
}

-- Как предметы выглядят в магазине (цена берётся из Roblox автоматически)
Config.ShopRobux = {
	{ kind = "pass", key = "PremiumPass", name = "ПРЕМИУМ БАТЛПАСС", desc = "Открывает красную дорожку наград: редкие фонарики, титулы и монеты.", icon = "🩸" },
	{ kind = "pass", key = "VIP", name = "VIP", desc = "x2 монет за каждый раунд и золотой титул VIP.", icon = "👑" },
	{ kind = "pass", key = "BigBattery", name = "ВЕЧНАЯ БАТАРЕЯ", desc = "Фонарик садится в 2 раза медленнее и светит дальше.", icon = "🔋" },
	{ kind = "product", key = "Coins100", name = "100 МОНЕТ", desc = "Горсть старых монет.", icon = "🪙" },
	{ kind = "product", key = "Coins500", name = "500 МОНЕТ", desc = "Кошелёк пропавшего врача.", icon = "💰" },
	{ kind = "product", key = "Coins1500", name = "1500 МОНЕТ", desc = "Сейф главврача.", icon = "🏦" },
	{ kind = "product", key = "SkipTier", name = "ПРОПУСК УРОВНЯ", desc = "+1 уровень батлпасса прямо сейчас.", icon = "⏭" },
	{ kind = "product", key = "Revive", name = "ЖЕТОН ВОЗРОЖДЕНИЯ", desc = "Вернись в раунд после смерти.", icon = "✚" },
}

Config.ProductRewards = {
	Coins100 = { coins = 100 },
	Coins500 = { coins = 500 },
	Coins1500 = { coins = 1500 },
	SkipTier = { tiers = 1 },
	Revive = { revive = 1 },
}

-- 4) ФОНАРИКИ (скины света) ----------------------------------------------------
-- price > 0 = продаётся за монеты; source = "bp" = только из батлпасса
Config.Flashlights = {
	{ id = "Standard", name = "Стандарт", color = Color3.fromRGB(255, 236, 205), price = 0 },
	{ id = "Cold", name = "Холодный", color = Color3.fromRGB(200, 225, 255), price = 250 },
	{ id = "Toxic", name = "Ядовитый", color = Color3.fromRGB(150, 255, 120), price = 600 },
	{ id = "Ghost", name = "Призрачный", color = Color3.fromRGB(140, 255, 245), price = 900 },
	{ id = "Gold", name = "Золотой", color = Color3.fromRGB(255, 200, 90), price = 1500 },
	{ id = "Moon", name = "Лунный", color = Color3.fromRGB(180, 190, 255), price = 0, source = "bp" },
	{ id = "Ember", name = "Тлеющий", color = Color3.fromRGB(255, 140, 60), price = 0, source = "bp" },
	{ id = "Blood", name = "Кровавый", color = Color3.fromRGB(255, 50, 50), price = 0, source = "bp" },
	{ id = "Void", name = "Пустота", color = Color3.fromRGB(170, 90, 255), price = 0, source = "bp" },
	{ id = "Aurora", name = "Северное сияние", color = Color3.fromRGB(90, 255, 200), price = 0, source = "bp" },
}

Config.Titles = {
	{ id = "Newbie", name = "Новенький пациент", color = Color3.fromRGB(190, 180, 170) },
	{ id = "Survivor", name = "Выживший", color = Color3.fromRGB(150, 220, 150) },
	{ id = "Nightwalker", name = "Ночной странник", color = Color3.fromRGB(150, 170, 255) },
	{ id = "Insomniac", name = "Бессонница", color = Color3.fromRGB(200, 160, 255) },
	{ id = "Ward13", name = "Жилец палаты 13", color = Color3.fromRGB(255, 120, 120) },
	{ id = "Butcher", name = "Мясник", color = Color3.fromRGB(200, 30, 30) },
	{ id = "Patient", name = "Пациент № 13", color = Color3.fromRGB(230, 230, 230) },
	{ id = "Nightmare", name = "Живой кошмар", color = Color3.fromRGB(255, 60, 60) },
	{ id = "Eye", name = "Глаз Пациента", color = Color3.fromRGB(255, 220, 80) },
	{ id = "VIP", name = "VIP", color = Color3.fromRGB(255, 205, 60) },
}

Config.ShowTitlesAboveHead = true -- только в лобби

-- 5) НАГРАДЫ ЗА РАУНД -----------------------------------------------------
Config.Rewards = {
	Escape = { coins = 100, xp = 150 },
	Death = { coins = 20, xp = 40 },
	Fuse = { coins = 15, xp = 25 },
	SurviveXPPer10s = 1,
}

-- 6) РАУНД ------------------------------------------------------------------
Config.Round = {
	Fuses = 5,
	Batteries = 16,
	TimeLimit = 900, -- 15 минут
	MonsterWakeDelay = 25,
	ReturnToLobbyDelay = 12,
	WaitForPlayers = 15,
}

Config.Monster = {
	PatrolSpeed = 9,
	InvestigateSpeed = 13,
	ChaseSpeed = 17,
	ChaseSpeedPerFuse = 0.5,
	EnragedBonus = 2.5,
	SightRange = 90,
	FlashlightSightRange = 125,
	HearSprintRange = 45,
	FOV = 150,
	KillRange = 5.5,
	LoseTargetTime = 6,
	HuntChance = 0.45, -- шанс что патруль пойдёт к случайному игроку
}

Config.Player = {
	WalkSpeed = 12,
	SprintSpeed = 20,
	StaminaMax = 100,
	StaminaDrain = 20,
	StaminaRegen = 13,
	BatteryDrainPerSec = 0.55,
}

-- хелперы ------------------------------------------------------------------
function Config.getFlashlight(id)
	for _, f in ipairs(Config.Flashlights) do
		if f.id == id then
			return f
		end
	end
	return Config.Flashlights[1]
end

function Config.getTitle(id)
	for _, t in ipairs(Config.Titles) do
		if t.id == id then
			return t
		end
	end
	return nil
end

function Config.productKeyById(productId)
	for key, id in pairs(Config.Products) do
		if id ~= 0 and id == productId then
			return key
		end
	end
	return nil
end

function Config.passKeyById(passId)
	for key, id in pairs(Config.GamePasses) do
		if id ~= 0 and id == passId then
			return key
		end
	end
	return nil
end

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D9A"><Properties><string name="Name">FlashlightClient</string><ProtectedString name="Source"><![CDATA[--[[
	Локальный фонарик (клиент). Сервер решает вкл/выкл и батарею (атрибуты игрока),
	а тут красивый луч из камеры: плавное запаздывание, покачивание при ходьбе,
	мерцание при низком заряде и когда Пациент рядом.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FL = {}

function FL.start()
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local action = remotes:WaitForChild("Action")

	local part = Instance.new("Part")
	part.Name = "LocalFlashlight"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Parent = workspace

	local beam = Instance.new("SpotLight")
	beam.Face = Enum.NormalId.Front
	beam.Angle = 50
	beam.Range = 62
	beam.Brightness = 2.6
	beam.Shadows = true
	beam.Parent = part

	local hot = Instance.new("SpotLight")
	hot.Face = Enum.NormalId.Front
	hot.Angle = 20
	hot.Range = 75
	hot.Brightness = 1.6
	hot.Shadows = false
	hot.Parent = part

	local fill = Instance.new("PointLight")
	fill.Range = 7
	fill.Brightness = 0.25
	fill.Shadows = false
	fill.Parent = part

	local api = { part = part, forceFlicker = 0, disabled = false }
	local current = workspace.CurrentCamera.CFrame
	local swayT = 0
	local flickerUntil = 0
	local flickerOn = true

	local function isOn()
		return player:GetAttribute("FlashlightOn") == true and not api.disabled
	end

	local function hideServerBeam(char)
		if not char then
			return
		end
		local function apply(d)
			if d:IsA("Light") and d.Parent and d.Parent.Name == "ServerBeam" then
				d.Brightness = 0
			end
		end
		for _, d in ipairs(char:GetDescendants()) do
			apply(d)
		end
		char.DescendantAdded:Connect(apply)
	end
	hideServerBeam(player.Character)
	player.CharacterAdded:Connect(hideServerBeam)

	function api.toggle()
		action:FireServer("flashlight")
	end

	ContextActionService:BindAction("Flashlight", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			api.toggle()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonL1)
	ContextActionService:SetTitle("Flashlight", "Фонарь")
	ContextActionService:SetPosition("Flashlight", UDim2.new(1, -200, 1, -150))

	local lastPitchSent = 0
	local lastSend = 0

	RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera
		local on = isOn()
		local color = player:GetAttribute("FlashColor")
		if typeof(color) == "Color3" then
			beam.Color = color
			hot.Color = color
			fill.Color = color
		end
		local big = player:GetAttribute("BigBattery") == true
		beam.Range = big and 78 or 62
		hot.Range = big and 90 or 75

		-- сглаженное следование за камерой + покачивание
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local moveSpeed = hum and hum.MoveDirection.Magnitude * hum.WalkSpeed or 0
		swayT += dt * (1 + moveSpeed * 0.45)
		local swayAmt = 0.012 + moveSpeed * 0.0018
		local sway = CFrame.Angles(math.sin(swayT * 2) * swayAmt, math.sin(swayT) * swayAmt * 1.4, 0)
		local target = cam.CFrame * CFrame.new(0.45, -0.35, -0.2) * sway
		current = current:Lerp(target, math.clamp(dt * 16, 0, 1))
		part.CFrame = current

		-- мерцание
		local battery = player:GetAttribute("Battery") or 100
		local monsterNear = 0
		local monster = workspace:FindFirstChild("Monster")
		if monster and monster:FindFirstChild("HumanoidRootPart") then
			local d = (monster.HumanoidRootPart.Position - cam.CFrame.Position).Magnitude
			monsterNear = math.clamp(1 - d / 32, 0, 1)
		end
		local flickerChance = 0
		if battery < 20 then
			flickerChance += (20 - battery) / 20 * 0.06
		end
		flickerChance += monsterNear * 0.18 + api.forceFlicker
		local now = os.clock()
		if now > flickerUntil then
			if math.random() < flickerChance then
				flickerOn = false
				flickerUntil = now + 0.03 + math.random() * 0.12
			else
				flickerOn = true
			end
		end
		local lit = on and flickerOn
		local dim = (battery < 10) and (0.45 + battery / 20) or 1
		beam.Enabled = lit
		hot.Enabled = lit
		fill.Enabled = lit
		beam.Brightness = 2.6 * dim
		hot.Brightness = 1.6 * dim

		-- отправляем серверу наклон луча, чтобы другие видели, куда ты светишь
		if on and now - lastSend > 0.2 then
			local pitch = math.asin(math.clamp(cam.CFrame.LookVector.Y, -1, 1))
			if math.abs(pitch - lastPitchSent) > 0.05 then
				lastPitchSent = pitch
				lastSend = now
				action:FireServer("aim", pitch)
			end
		end
	end)

	return api
end

return FL
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D9B"><Properties><string name="Name">MonsterAnimator</string><ProtectedString name="Source"><![CDATA[--[[
	Процедурные анимации Пациента 13 (клиент):
	- ходьба / бег с рваной походкой (хромание, длинные руки волочатся)
	- дыхание в покое, дёрганья головы, подёргивание пальцев
	- режим погони: наклон вперёд, руки тянутся к жертве, челюсть открыта
	- атака: пасть раскрывается настежь, руки вверх
	- звуки шагов из стоп + тряска камеры рядом
	Работает через Motor6D.C0 (без загрузки анимаций на сайт).
]]
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Sound = require(script.Parent.Sound)

local Animator = {}
Animator.onFootstep = nil -- function(position, intensity)

local tracked = {}
local clock = os.clock

local function noise(t, seed)
	return math.noise(t, seed or 0, 0)
end

local function collectJoints(model)
	local joints = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then
			joints[d.Name] = { motor = d, base = d.C0 }
		end
	end
	return joints
end

function Animator.track(model)
	if tracked[model] then
		return
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local joints = collectJoints(model)
	local st = {
		model = model,
		root = root,
		joints = joints,
		phase = 0,
		walk = 0,
		lastSide = 0,
		headTarget = Vector3.zero,
		headCurrent = Vector3.zero,
		nextTwitch = clock() + 1,
		jaw = 0,
		lean = 0,
		reach = 0,
		seed = math.random() * 100,
		footL = model:FindFirstChild("LFoot", true),
		footR = model:FindFirstChild("RFoot", true),
	}
	tracked[model] = st
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			tracked[model] = nil
		end
	end)
end

local function set(st, name, cf)
	local j = st.joints[name]
	if j then
		j.motor.C0 = j.base * cf
	end
end

local A = CFrame.Angles

local function step(st, dt)
	local now = clock()
	local state = st.model:GetAttribute("State") or "Patrol"
	local vel = st.root.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local moving = math.clamp(speed / 9, 0, 1.6)
	st.walk += (moving - st.walk) * math.min(dt * 6, 1)
	local w = st.walk

	-- частота шага растёт со скоростью
	st.phase += dt * (2.2 + speed * 0.32)
	local p = st.phase
	local s = math.sin(p)
	local c = math.cos(p)

	local chasing = state == "Chase"
	local attacking = state == "Attack"
	local leanTarget = chasing and -0.38 or (attacking and 0.15 or -0.08)
	st.lean += (leanTarget - st.lean) * math.min(dt * 4, 1)
	local reachTarget = chasing and 1 or (attacking and 1.4 or 0)
	st.reach += (reachTarget - st.reach) * math.min(dt * 5, 1)
	local jawTarget = attacking and 1 or (chasing and 0.55 or 0.08 + 0.06 * math.sin(now * 1.7))
	st.jaw += (jawTarget - st.jaw) * math.min(dt * (attacking and 18 or 6), 1)

	local breath = math.sin(now * (chasing and 5 or 1.6)) * 0.035
	local limp = 0.2 -- асимметрия походки: правая нога "хромает"

	-- таз / корпус
	local bob = -math.abs(s) * 0.32 * w
	set(st, "RootJoint", CFrame.new(0, bob, 0) * A(st.lean * 0.4, s * 0.12 * w, s * 0.09 * w))
	set(st, "Waist", A(st.lean + breath - math.abs(c) * 0.06 * w, -s * 0.22 * w, -s * 0.06 * w))

	-- голова: резкие неестественные дёрганья
	if now > st.nextTwitch then
		st.nextTwitch = now + (chasing and 0.25 or 0.5) + math.random() * (chasing and 0.6 or 2.2)
		st.headTarget = Vector3.new((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.9, (math.random() - 0.5) * 1.3)
	end
	st.headCurrent = st.headCurrent:Lerp(st.headTarget, math.min(dt * 22, 1)) -- очень быстрый рывок
	local hc = st.headCurrent
	local shiver = noise(now * 9, st.seed) * 0.05
	set(st, "NeckBase", A(-st.lean * 0.6 + 0.1, hc.Y * 0.3, 0))
	set(st, "Neck", A(hc.X - st.lean * 0.5 + shiver, hc.Y, hc.Z + shiver))

	-- челюсть
	local tremble = (chasing or attacking) and noise(now * 30, st.seed + 3) * 0.08 or 0
	set(st, "Jaw", A(-st.jaw * 0.85 + tremble, 0, 0))

	-- ноги (колени согнуты, шаг широкий)
	local legSwing = 0.65 * w
	local function leg(side, ph, amp)
		local sp = math.sin(ph)
		local lift = math.max(0, math.cos(ph))
		set(st, side .. "Hip", A(sp * legSwing * amp + 0.1, 0, 0))
		set(st, side .. "Knee", A(-(lift * 1.0 * w + 0.05), 0, 0))
		set(st, side .. "Ankle", A(-sp * 0.35 * w + lift * 0.4 * w, 0, 0))
	end
	leg("L", p, 1)
	leg("R", p + math.pi, 1 - limp)

	-- руки: длинные, болтаются с запаздыванием; в погоне тянутся вперёд
	local r = st.reach
	local function arm(side, ph, sign)
		local sw = math.sin(ph - 0.5) * 0.55 * w
		local twitch = noise(now * 3, st.seed + (sign > 0 and 10 or 20)) * 0.12
		set(st, side .. "Shoulder", A(-sw + r * 1.15 + twitch, 0, sign * (0.12 + r * 0.15)))
		set(st, side .. "Elbow", A(0.25 + math.max(0, -math.sin(ph)) * 0.35 * w + r * 0.3, 0, 0))
		set(st, side .. "Wrist", A(0.15 + twitch * 2 - r * 0.4, 0, 0))
		for i = 1, 4 do
			local fn = noise(now * (attacking and 12 or 4), st.seed + i * 7 + sign * 3)
			local curl = 0.25 + fn * 0.35 - r * 0.2
			set(st, side .. "F" .. i .. "a", A(curl, 0, 0))
			set(st, side .. "F" .. i .. "b", A(curl * 1.3, 0, 0))
		end
	end
	arm("L", p + math.pi, -1)
	arm("R", p, 1)

	-- шаги: каждые полпериода одна нога бьёт о пол
	local side = s >= 0 and 1 or -1
	if side ~= st.lastSide then
		st.lastSide = side
		if w > 0.25 then
			local foot = side > 0 and st.footR or st.footL
			local pos = foot and foot.Position or st.root.Position
			Sound.play("MonsterStep", foot or st.root, {
				Volume = 0.6 + 0.5 * math.min(w, 1.4),
				PlaybackSpeed = 0.85 + math.random() * 0.2,
				RollOffMinDistance = 10,
				RollOffMaxDistance = 110,
			})
			if Animator.onFootstep then
				Animator.onFootstep(pos, w)
			end
		end
	end
end

local started = false
function Animator.start()
	if started then
		return
	end
	started = true
	RunService.RenderStepped:Connect(function(dt)
		for model, st in pairs(tracked) do
			if model.Parent and st.root.Parent then
				step(st, dt)
			else
				tracked[model] = nil
			end
		end
	end)
end

-- камера трясётся от шагов рядом
function Animator.shakeAmountFor(position)
	local cam = workspace.CurrentCamera
	if not cam then
		return 0
	end
	local d = (cam.CFrame.Position - position).Magnitude
	return math.clamp(1 - d / 35, 0, 1)
end

local _ = Players
return Animator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D9C"><Properties><string name="Name">Sound</string><ProtectedString name="Source"><![CDATA[-- Проигрывание звуков по ключу из Config.Sounds. Если ID = 0 — тихо пропускаем (без ошибок).
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Config = require(script.Parent.Config)

local Sound = {}

function Sound.id(key)
	local v = Config.Sounds[key]
	if v == nil or v == 0 or v == "" then
		return nil
	end
	if typeof(v) == "number" then
		return "rbxassetid://" .. tostring(v)
	end
	return tostring(v)
end

-- создать Sound (не запуская). parent = часть/аттачмент для 3D, nil = 2D
function Sound.make(key, parent, props)
	local id = Sound.id(key)
	if not id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = id
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 8
	s.RollOffMaxDistance = 90
	if props then
		for k, v in pairs(props) do
			s[k] = v
		end
	end
	s.Parent = parent or SoundService
	return s
end

-- одноразовый звук
function Sound.play(key, parent, props)
	local s = Sound.make(key, parent, props)
	if not s then
		return nil
	end
	if not s.Looped then
		s.Ended:Connect(function()
			s:Destroy()
		end)
		Debris:AddItem(s, 25)
	end
	s:Play()
	return s
end

-- звук в точке пространства
function Sound.playAt(key, position, props)
	if not Sound.id(key) then
		return nil
	end
	local a = Instance.new("Attachment")
	a.WorldPosition = position
	a.Parent = workspace.Terrain
	Debris:AddItem(a, 25)
	return Sound.play(key, a, props)
end

return Sound
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D9D"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Криповый UI-кит: кнопки с мерцанием, окна, тосты, виньетка
local TweenService = game:GetService("TweenService")
local Sound = require(script.Parent.Sound)

local UI = {}

UI.Colors = {
	Bg = Color3.fromRGB(6, 5, 5),
	Panel = Color3.fromRGB(14, 11, 11),
	Panel2 = Color3.fromRGB(22, 16, 16),
	Red = Color3.fromRGB(150, 14, 14),
	BrightRed = Color3.fromRGB(235, 40, 40),
	Text = Color3.fromRGB(222, 212, 200),
	Dim = Color3.fromRGB(125, 115, 110),
	Gold = Color3.fromRGB(235, 185, 70),
	Green = Color3.fromRGB(110, 200, 110),
}

local function safeFont(name, fallback)
	local ok, f = pcall(function()
		return Enum.Font[name]
	end)
	if ok and f then
		return f
	end
	return fallback
end

-- шрифты с кириллицей
UI.FontTitle = safeFont("Oswald", Enum.Font.SourceSansBold)
UI.FontMono = safeFont("RobotoMono", Enum.Font.Code)
UI.FontText = safeFont("SourceSans", Enum.Font.SourceSans)
UI.FontBold = safeFont("SourceSansBold", Enum.Font.SourceSansBold)

function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(r)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 6) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Red,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function UI.tween(obj, time, props, style, dir)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function UI.label(props)
	local base = {
		BackgroundTransparency = 1,
		Font = UI.FontText,
		TextColor3 = UI.Colors.Text,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	return UI.new("TextLabel", base)
end

-- жуткая кнопка: мерцает при наведении, текст краснеет
function UI.button(props, onClick)
	local base = {
		AutoButtonColor = false,
		BackgroundColor3 = UI.Colors.Panel2,
		BackgroundTransparency = 0.15,
		Font = UI.FontTitle,
		TextColor3 = UI.Colors.Text,
		TextSize = 20,
		Text = "КНОПКА",
	}
	for k, v in pairs(props or {}) do
		if k ~= "NoStroke" then
			base[k] = v
		end
	end
	local btn = UI.new("TextButton", base)
	if not props or props.NoStroke ~= true then
		UI.stroke(UI.Colors.Red, 1, 0.4).Parent = btn
	end
	local normalColor = btn.TextColor3
	local hovering = false
	btn.MouseEnter:Connect(function()
		hovering = true
		Sound.play("UIHover", nil, { Volume = 0.5, PlaybackSpeed = 0.9 + math.random() * 0.2 })
		UI.tween(btn, 0.12, { TextColor3 = UI.Colors.BrightRed })
		task.spawn(function()
			for _ = 1, 6 do
				if not hovering then
					break
				end
				btn.TextTransparency = math.random() < 0.5 and 0.6 or 0
				task.wait(0.03 + math.random() * 0.05)
			end
			btn.TextTransparency = 0
		end)
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		btn.TextTransparency = 0
		UI.tween(btn, 0.2, { TextColor3 = normalColor })
	end)
	btn.Activated:Connect(function()
		Sound.play("UIClick", nil, { Volume = 0.7 })
		if onClick then
			onClick()
		end
	end)
	return btn
end

-- чёрная виньетка по краям экрана
function UI.vignette(parent, strength)
	strength = strength or 0
	local holder = UI.new("Frame", {
		Name = "Vignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = parent,
	})
	local function edge(rot, size, pos, anchor)
		local f = UI.new("Frame", {
			Size = size,
			Position = pos,
			AnchorPoint = anchor,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			BackgroundTransparency = strength,
			ZIndex = 1,
			Parent = holder,
		})
		UI.new("UIGradient", {
			Rotation = rot,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = f,
		})
		return f
	end
	edge(0, UDim2.fromScale(0.28, 1), UDim2.fromScale(0, 0), Vector2.new(0, 0))
	edge(180, UDim2.fromScale(0.28, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0))
	edge(90, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0), Vector2.new(0, 0))
	edge(-90, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 1), Vector2.new(0, 1))
	return holder
end

-- окно-панель с заголовком и крестиком
function UI.window(parent, titleText, size)
	local win = UI.new("Frame", {
		Name = "Window",
		Size = size or UDim2.fromOffset(760, 480),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	}, {
		UI.corner(4),
		UI.stroke(UI.Colors.Red, 2, 0.2),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(980, 640) }),
	})
	UI.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(30, 14, 14), Color3.fromRGB(8, 6, 6)),
		Parent = win,
	})
	local title = UI.label({
		Name = "Title",
		Text = titleText,
		Font = UI.FontTitle,
		TextSize = 30,
		TextColor3 = UI.Colors.BrightRed,
		Size = UDim2.new(1, -80, 0, 44),
		Position = UDim2.fromOffset(18, 6),
		ZIndex = 21,
		Parent = win,
	})
	local line = UI.new("Frame", {
		Size = UDim2.new(1, -36, 0, 1),
		Position = UDim2.fromOffset(18, 52),
		BackgroundColor3 = UI.Colors.Red,
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = win,
	})
	local close = UI.button({
		Text = "✕",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -50, 0, 8),
		TextSize = 22,
		ZIndex = 22,
		Parent = win,
	})
	local content = UI.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -36, 1, -72),
		Position = UDim2.fromOffset(18, 62),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = win,
	})
	local api = { frame = win, content = content, title = title, line = line, onClose = nil }
	function api.open()
		win.Visible = true
		win.Size = (size or UDim2.fromOffset(760, 480)) - UDim2.fromOffset(40, 30)
		UI.tween(win, 0.18, { Size = size or UDim2.fromOffset(760, 480) }, Enum.EasingStyle.Back)
		task.spawn(function()
			for _ = 1, 5 do
				title.TextTransparency = math.random() < 0.5 and 0.7 or 0
				task.wait(0.05)
			end
			title.TextTransparency = 0
		end)
	end
	function api.close()
		win.Visible = false
		if api.onClose then
			api.onClose()
		end
	end
	close.Activated:Connect(api.close)
	return api
end

-- всплывающее уведомление
local toastHolders = {}
function UI.toast(screenGui, text, color)
	local holder = toastHolders[screenGui]
	if not holder or not holder.Parent then
		holder = UI.new("Frame", {
			Name = "Toasts",
			Size = UDim2.new(0, 420, 1, -40),
			Position = UDim2.new(1, -20, 0, 20),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			ZIndex = 50,
			Parent = screenGui,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 6),
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		toastHolders[screenGui] = holder
	end
	local t = UI.label({
		Text = text,
		Font = UI.FontMono,
		TextSize = 16,
		TextColor3 = color or UI.Colors.Text,
		BackgroundColor3 = Color3.fromRGB(10, 6, 6),
		BackgroundTransparency = 0.15,
		Size = UDim2.fromOffset(400, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 51,
		Parent = holder,
	}, nil)
	UI.padding(10).Parent = t
	UI.stroke(UI.Colors.Red, 1, 0.3).Parent = t
	task.delay(4, function()
		if t.Parent then
			UI.tween(t, 0.4, { TextTransparency = 1, BackgroundTransparency = 1 })
			task.wait(0.45)
			t:Destroy()
		end
	end)
	return t
end

-- глитч-заголовок: три слоя (белый + красный + голубой со сдвигом)
function UI.glitchTitle(parent, text, size, position, textSize)
	local holder = UI.new("Frame", {
		Size = size,
		Position = position,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = parent,
	})
	local function layer(color, z, tr)
		return UI.label({
			Text = text,
			Font = UI.FontTitle,
			TextSize = textSize,
			TextColor3 = color,
			TextTransparency = tr,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = false,
			ZIndex = z,
			Parent = holder,
		})
	end
	local cyan = layer(Color3.fromRGB(60, 220, 255), 5, 0.55)
	local red = layer(Color3.fromRGB(255, 20, 20), 6, 0.25)
	local main = layer(Color3.fromRGB(235, 225, 215), 7, 0)
	local alive = true
	task.spawn(function()
		while alive and holder.Parent do
			local glitch = math.random() < 0.12
			if glitch then
				for _ = 1, math.random(3, 8) do
					red.Position = UDim2.fromOffset(math.random(-9, 9), math.random(-3, 3))
					cyan.Position = UDim2.fromOffset(math.random(-9, 9), math.random(-3, 3))
					main.Position = UDim2.fromOffset(math.random(-3, 3), 0)
					main.TextTransparency = math.random() < 0.3 and 0.8 or 0
					task.wait(0.03)
				end
			end
			red.Position = UDim2.fromOffset(2, 1)
			cyan.Position = UDim2.fromOffset(-2, 0)
			main.Position = UDim2.fromOffset(0, 0)
			main.TextTransparency = 0
			task.wait(0.08 + math.random() * 0.25)
		end
	end)
	return holder, function()
		alive = false
	end
end

return UI
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00004D9E"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00004D9F"><Properties><string name="Name">Core</string></Properties><Item class="ModuleScript" referent="RBX00004DA0"><Properties><string name="Name">BattlePassService</string><ProtectedString name="Source"><![CDATA[-- Серверная логика батлпасса: опыт и выдача наград
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local Config = require(ReplicatedStorage.Shared.Config)
local BattlePass = require(ReplicatedStorage.Shared.BattlePass)

local BPService = {}

function BPService.addXP(player, amount)
	local data = DataService.get(player)
	if not data or amount <= 0 then
		return
	end
	local before = BattlePass.tierFromXP(data.xp)
	data.xp += math.floor(amount)
	local after = BattlePass.tierFromXP(data.xp)
	if after > before then
		Remotes.notify(player, "БАТЛПАСС: уровень " .. after .. "! Забери награду в лобби.", Color3.fromRGB(235, 40, 40))
	end
end

local function grantReward(player, data, reward)
	if reward.type == "coins" then
		data.coins += reward.amount
	elseif reward.type == "revive" then
		data.revives += reward.amount
	elseif reward.type == "flashlight" then
		data.flashlights[reward.id] = true
	elseif reward.type == "title" then
		data.titles[reward.id] = true
	end
end

function BPService.claim(player, tier, track)
	local data = DataService.get(player)
	if not data then
		return false, "Данные ещё загружаются"
	end
	tier = tonumber(tier)
	if not tier or tier < 1 or tier > BattlePass.MaxTier or tier ~= math.floor(tier) then
		return false, "Неверный уровень"
	end
	if track ~= "free" and track ~= "premium" then
		return false, "?"
	end
	if BattlePass.tierFromXP(data.xp) < tier then
		return false, "Уровень ещё не открыт"
	end
	if track == "premium" and not ShopService.hasPass(player, "PremiumPass") then
		return false, "Нужен ПРЕМИУМ БАТЛПАСС"
	end
	local k = tostring(tier)
	if data.bpClaimed[track][k] then
		return false, "Уже получено"
	end
	local reward = BattlePass.Tiers[tier][track]
	if not reward then
		return false, "Нет награды"
	end
	data.bpClaimed[track][k] = true
	grantReward(player, data, reward)
	ShopService.applyCosmetics(player)
	DataService.push(player)
	return true, "Получено: " .. BattlePass.describe(reward)
end

function BPService.start()
	Remotes.ClaimReward.OnServerInvoke = function(player, tier, track)
		return BPService.claim(player, tier, track)
	end
end

local _ = Config
return BPService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA1"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	Сохранение прогресса (DataStore). Общий для лобби и игрового плейса
	(оба плейса должны быть в одном Experience).
	Защита от гонки при телепорте: в TeleportData передаём savedAt, и
	принимающий сервер ждёт, пока в DataStore появится версия не старше.
]]
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Remotes = require(script.Parent.Remotes)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local BattlePass = require(Shared.BattlePass)

local DataService = {}
DataService.passChecker = nil -- function(player) -> table of pass flags (ставит ShopService)

local STORE_NAME = "Palata13_PlayerData_v1"
local store = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)
if not storeOk then
	store = nil
end

local profiles = {}
local loadedEvent = Instance.new("BindableEvent")
DataService.Loaded = loadedEvent.Event

local function defaults()
	return {
		version = 1,
		coins = 100,
		xp = 0,
		bpClaimed = { free = {}, premium = {} },
		flashlights = { Standard = true },
		flashlight = "Standard",
		titles = { Newbie = true },
		title = "Newbie",
		revives = 0,
		stats = { escapes = 0, deaths = 0, games = 0 },
		receipts = {},
		receiptOrder = {},
		savedAt = 0,
		settings = { sensitivity = 1, music = 0.6 },
	}
end

local function merge(data, def)
	for k, v in pairs(def) do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			merge(data[k], v)
		end
	end
	return data
end

local function key(player)
	return "u_" .. player.UserId
end

local function setupLeaderstats(player, data)
	local ls = player:FindFirstChild("leaderstats") or Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = ls:FindFirstChild("Монеты") or Instance.new("IntValue")
	coins.Name = "Монеты"
	coins.Value = data.coins
	coins.Parent = ls
	local tier = ls:FindFirstChild("Уровень") or Instance.new("IntValue")
	tier.Name = "Уровень"
	tier.Value = BattlePass.tierFromXP(data.xp)
	tier.Parent = ls
	ls.Parent = player
end

local function snapshot(player, data)
	-- то, что уходит клиенту
	local passes = DataService.passChecker and DataService.passChecker(player) or {}
	return {
		coins = data.coins,
		xp = data.xp,
		tier = BattlePass.tierFromXP(data.xp),
		bpClaimed = data.bpClaimed,
		flashlights = data.flashlights,
		flashlight = data.flashlight,
		titles = data.titles,
		title = data.title,
		revives = data.revives,
		stats = data.stats,
		passes = passes,
		settings = data.settings,
	}
end

function DataService.push(player)
	local data = profiles[player]
	if not data then
		return
	end
	setupLeaderstats(player, data)
	Remotes.DataUpdated:FireClient(player, snapshot(player, data))
end

function DataService.get(player)
	return profiles[player]
end

function DataService.waitFor(player, timeout)
	local t0 = os.clock()
	while not profiles[player] and player.Parent and os.clock() - t0 < (timeout or 30) do
		task.wait(0.2)
	end
	return profiles[player]
end

function DataService.update(player, fn)
	local data = profiles[player]
	if not data then
		return false
	end
	fn(data)
	DataService.push(player)
	return true
end

function DataService.saveAsync(player)
	local data = profiles[player]
	if not data then
		return false, 0
	end
	data.savedAt = os.time() + os.clock() % 1
	if not store then
		return true, data.savedAt
	end
	local ok, err
	for attempt = 1, 3 do
		ok, err = pcall(function()
			store:SetAsync(key(player), data, { player.UserId })
		end)
		if ok then
			break
		end
		task.wait(attempt)
	end
	if not ok then
		warn("[Палата13] Не удалось сохранить", player.Name, err)
	end
	return ok, data.savedAt
end

local function loadPlayer(player)
	local expectedSavedAt = 0
	pcall(function()
		local join = player:GetJoinData()
		local td = join and join.TeleportData
		if type(td) == "table" then
			if type(td.savedAt) == "number" then
				expectedSavedAt = td.savedAt
			elseif type(td.savedAt) == "table" then
				expectedSavedAt = tonumber(td.savedAt[tostring(player.UserId)]) or 0
			end
		end
	end)

	local data = nil
	if store then
		for attempt = 1, 8 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				if type(result) == "table" and (result.savedAt or 0) + 0.001 < expectedSavedAt and attempt < 8 then
					-- предыдущий сервер ещё не дописал данные — подождём
					task.wait(1.5)
				else
					data = result
					break
				end
			else
				warn("[Палата13] Ошибка загрузки", result)
				if RunService:IsStudio() then
					warn("[Палата13] В Studio включи: Game Settings → Security → Enable Studio Access to API Services")
					break
				end
				task.wait(attempt)
			end
		end
	end
	if not player.Parent then
		return
	end
	if type(data) ~= "table" then
		data = defaults()
	else
		data = merge(data, defaults())
	end
	profiles[player] = data
	setupLeaderstats(player, data)
	loadedEvent:Fire(player, data)
	DataService.push(player)
end

-- квитанции покупок (защита от двойного начисления)
function DataService.hasReceipt(data, purchaseId)
	return data.receipts[purchaseId] == true
end

function DataService.addReceipt(data, purchaseId)
	data.receipts[purchaseId] = true
	table.insert(data.receiptOrder, purchaseId)
	while #data.receiptOrder > 50 do
		local old = table.remove(data.receiptOrder, 1)
		data.receipts[old] = nil
	end
end

function DataService.start()
	Remotes.GetData.OnServerInvoke = function(player)
		local data = DataService.waitFor(player, 20)
		if not data then
			return nil
		end
		return snapshot(player, data)
	end

	Players.PlayerAdded:Connect(loadPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(loadPlayer, p)
	end

	Players.PlayerRemoving:Connect(function(player)
		if profiles[player] then
			if not player:GetAttribute("AlreadySaved") then
				DataService.saveAsync(player)
			end
			profiles[player] = nil
		end
	end)

	task.spawn(function()
		while true do
			task.wait(120)
			for _, p in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.saveAsync, p)
			end
		end
	end)

	game:BindToClose(function()
		local threads = 0
		for _, p in ipairs(Players:GetPlayers()) do
			threads += 1
			task.spawn(function()
				DataService.saveAsync(p)
				threads -= 1
			end)
		end
		local t0 = os.clock()
		while threads > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

local _ = HttpService
return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA2"><Properties><string name="Name">FlashlightService</string><ProtectedString name="Source"><![CDATA[--[[
	Серверная часть фонарика: вкл/выкл, батарея, звук щелчка (3D — слышат другие),
	луч "ServerBeam" на голове — его видят другие игроки (и монстр замечает свет).
	У самого игрока он скрыт — ему светит красивый локальный фонарь.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(script.Parent.Remotes)
local Config = require(ReplicatedStorage.Shared.Config)
local Sound = require(ReplicatedStorage.Shared.Sound)

local FS = {}
FS.infinite = false -- в лобби батарея бесконечная
FS.actionHandlers = {} -- доп. обработчики Action (name -> fn(player, ...))

local function beamOf(player)
	local char = player.Character
	return char and char:FindFirstChild("ServerBeam")
end

function FS.setOn(player, on)
	if on and (player:GetAttribute("Battery") or 0) <= 0 then
		on = false
	end
	if player:GetAttribute("FlashlightOn") == on then
		return
	end
	player:SetAttribute("FlashlightOn", on)
	local beam = beamOf(player)
	if beam then
		for _, l in ipairs(beam:GetChildren()) do
			if l:IsA("Light") then
				l.Enabled = on
			end
		end
		Sound.play(on and "FlashlightOn" or "FlashlightOff", beam, { Volume = 0.8, RollOffMaxDistance = 40 })
	end
end

function FS.addBattery(player, amount)
	local b = player:GetAttribute("Battery") or 0
	player:SetAttribute("Battery", math.clamp(b + amount, 0, 100))
end

local function makeBeam(player, char)
	local head = char:WaitForChild("Head", 10)
	if not head then
		return
	end
	local old = char:FindFirstChild("ServerBeam")
	if old then
		old:Destroy()
	end
	local p = Instance.new("Part")
	p.Name = "ServerBeam"
	p.Size = Vector3.new(0.3, 0.3, 0.6)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	local w = Instance.new("Weld")
	w.Name = "AimWeld"
	w.Part0 = head
	w.Part1 = p
	w.C0 = CFrame.new(0.4, 0, -0.6)
	w.Parent = p
	local s = Instance.new("SpotLight")
	s.Face = Enum.NormalId.Front
	s.Angle = 45
	s.Range = 55
	s.Brightness = 2.5
	s.Shadows = true
	s.Enabled = player:GetAttribute("FlashlightOn") == true
	local color = player:GetAttribute("FlashColor")
	if typeof(color) == "Color3" then
		s.Color = color
	end
	s.Parent = p
	p.Parent = char
	player:GetAttributeChangedSignal("FlashColor"):Connect(function()
		local c = player:GetAttribute("FlashColor")
		if typeof(c) == "Color3" and s.Parent then
			s.Color = c
		end
	end)
end

function FS.start(infinite)
	FS.infinite = infinite == true
	local function onPlayer(player)
		player:SetAttribute("Battery", 100)
		player:SetAttribute("FlashlightOn", false)
		player.CharacterAdded:Connect(function(char)
			makeBeam(player, char)
		end)
		if player.Character then
			task.spawn(makeBeam, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end

	Remotes.Action.OnServerEvent:Connect(function(player, name, ...)
		if name == "flashlight" then
			FS.setOn(player, not player:GetAttribute("FlashlightOn"))
		elseif name == "aim" then
			local pitch = ...
			if type(pitch) == "number" and pitch == pitch then
				pitch = math.clamp(pitch, -1.3, 1.3)
				local beam = beamOf(player)
				local weld = beam and beam:FindFirstChild("AimWeld")
				if weld then
					weld.C0 = CFrame.new(0.4, 0, -0.6) * CFrame.Angles(pitch, 0, 0)
				end
			end
		elseif name == "sprint" then
			local on = ...
			player:SetAttribute("Sprinting", on == true)
		else
			local h = FS.actionHandlers[name]
			if h then
				h(player, ...)
			end
		end
	end)

	task.spawn(function()
		local dt = 0.25
		while true do
			task.wait(dt)
			if not FS.infinite then
				for _, player in ipairs(Players:GetPlayers()) do
					if player:GetAttribute("FlashlightOn") then
						local drain = Config.Player.BatteryDrainPerSec * dt
						if player:GetAttribute("BigBattery") then
							drain *= 0.5
						end
						local b = (player:GetAttribute("Battery") or 0) - drain
						if b <= 0 then
							b = 0
							player:SetAttribute("Battery", 0)
							FS.setOn(player, false)
							Remotes.notify(player, "Батарея села. Темнота смотрит на тебя.", Color3.fromRGB(235, 40, 40))
						else
							player:SetAttribute("Battery", b)
						end
					end
				end
			end
		end
	end)
end

return FS
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA3"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Создаёт все RemoteEvent / RemoteFunction в ReplicatedStorage.Remotes
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local events = { "DataUpdated", "Notify", "Action", "Jumpscare", "RoundUpdate", "Teleporting", "Power", "Results", "Scare" }
local functions = { "GetData", "ShopRequest", "ClaimReward", "UseRevive" }

for _, name in ipairs(events) do
	local e = folder:FindFirstChild(name)
	if not e then
		e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
	end
	Remotes[name] = e
end
for _, name in ipairs(functions) do
	local f = folder:FindFirstChild(name)
	if not f then
		f = Instance.new("RemoteFunction")
		f.Name = name
		f.Parent = folder
	end
	Remotes[name] = f
end

function Remotes.notify(player, text, color)
	Remotes.Notify:FireClient(player, text, color)
end

function Remotes.notifyAll(text, color)
	Remotes.Notify:FireAllClients(text, color)
end

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA4"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--[[
	Магазин: Game Pass'ы, Developer Products (за Робуксы), покупка фонариков за монеты,
	экипировка фонариков и титулов.
	ProcessReceipt слушается в обоих плейсах (в раунде можно купить возрождение).
]]
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local Config = require(ReplicatedStorage.Shared.Config)
local BattlePass = require(ReplicatedStorage.Shared.BattlePass)

local ShopService = {}
ShopService.onRevivePurchased = nil -- function(player) -> true, если возродили в раунде
ShopService.isLobby = false

local passCache = {} -- [player][key] = bool

function ShopService.hasPass(player, key)
	local id = Config.GamePasses[key]
	if not id or id == 0 then
		return false
	end
	passCache[player] = passCache[player] or {}
	local cached = passCache[player][key]
	if cached ~= nil then
		return cached
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
	end)
	local value = ok and owns == true
	if ok then
		passCache[player][key] = value
	end
	return value
end

local function passFlags(player)
	local flags = {}
	for key in pairs(Config.GamePasses) do
		flags[key] = ShopService.hasPass(player, key)
	end
	return flags
end
DataService.passChecker = passFlags

-- цвет фонарика + титул в атрибутах и над головой
function ShopService.applyCosmetics(player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local fl = Config.getFlashlight(data.flashlight)
	player:SetAttribute("FlashColor", fl.color)
	player:SetAttribute("FlashlightId", fl.id)
	local titleId = data.title
	if ShopService.hasPass(player, "VIP") then
		data.titles.VIP = true
	end
	local t = Config.getTitle(titleId) or Config.getTitle("Newbie")
	player:SetAttribute("Title", t.name)
	player:SetAttribute("BigBattery", ShopService.hasPass(player, "BigBattery"))
	player:SetAttribute("VIP", ShopService.hasPass(player, "VIP"))

	local char = player.Character
	if ShopService.isLobby and Config.ShowTitlesAboveHead and char then
		local head = char:FindFirstChild("Head")
		if head then
			local bb = head:FindFirstChild("TitleTag")
			if not bb then
				bb = Instance.new("BillboardGui")
				bb.Name = "TitleTag"
				bb.Size = UDim2.fromOffset(220, 26)
				bb.StudsOffset = Vector3.new(0, 2.6, 0)
				bb.MaxDistance = 60
				bb.AlwaysOnTop = false
				local l = Instance.new("TextLabel")
				l.Name = "L"
				l.Size = UDim2.fromScale(1, 1)
				l.BackgroundTransparency = 1
				l.Font = Enum.Font.SourceSansBold
				l.TextSize = 18
				l.TextStrokeTransparency = 0.4
				l.Parent = bb
				bb.Parent = head
			end
			bb.L.Text = "« " .. t.name .. " »"
			bb.L.TextColor3 = t.color
		end
	end
end

local function grantProduct(player, key)
	local reward = Config.ProductRewards[key]
	if not reward then
		return false
	end
	local data = DataService.get(player)
	if not data then
		return false
	end
	if reward.coins then
		data.coins += reward.coins
		Remotes.notify(player, "+" .. reward.coins .. " монет. Спасибо за покупку!", Color3.fromRGB(235, 185, 70))
	end
	if reward.tiers then
		local tier = BattlePass.tierFromXP(data.xp)
		if tier < BattlePass.MaxTier then
			data.xp = (tier + 1) * BattlePass.XPPerTier
		else
			data.coins += 300 -- батлпасс уже закрыт — компенсация
		end
		Remotes.notify(player, "Уровень батлпасса повышен!", Color3.fromRGB(235, 40, 40))
	end
	if reward.revive then
		local used = false
		if ShopService.onRevivePurchased then
			used = ShopService.onRevivePurchased(player) == true
		end
		if not used then
			data.revives += reward.revive
			Remotes.notify(player, "+1 жетон возрождения", Color3.fromRGB(110, 200, 110))
		end
	end
	return true
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.waitFor(player, 15)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if DataService.hasReceipt(data, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = Config.productKeyById(info.ProductId)
	if not key then
		warn("[Палата13] Неизвестный продукт", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not grantProduct(player, key) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	DataService.addReceipt(data, info.PurchaseId)
	local ok = DataService.saveAsync(player)
	DataService.push(player)
	if not ok then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function handleShopRequest(player, action, arg)
	local data = DataService.get(player)
	if not data then
		return false, "Данные ещё загружаются"
	end
	if action == "buyFlashlight" then
		local fl = nil
		for _, f in ipairs(Config.Flashlights) do
			if f.id == arg then
				fl = f
			end
		end
		if not fl then
			return false, "Нет такого фонарика"
		end
		if fl.source == "bp" then
			return false, "Только из батлпасса"
		end
		if data.flashlights[fl.id] then
			return false, "Уже куплено"
		end
		if data.coins < fl.price then
			return false, "Не хватает монет"
		end
		data.coins -= fl.price
		data.flashlights[fl.id] = true
		data.flashlight = fl.id
		ShopService.applyCosmetics(player)
		DataService.push(player)
		return true, "Куплено: " .. fl.name
	elseif action == "equipFlashlight" then
		if not data.flashlights[arg] then
			return false, "Не куплено"
		end
		data.flashlight = arg
		ShopService.applyCosmetics(player)
		DataService.push(player)
		return true, "Экипировано"
	elseif action == "equipTitle" then
		if arg == "VIP" and ShopService.hasPass(player, "VIP") then
			data.titles.VIP = true
		end
		if not data.titles[arg] then
			return false, "Титул не получен"
		end
		data.title = arg
		ShopService.applyCosmetics(player)
		DataService.push(player)
		return true, "Титул установлен"
	end
	return false, "?"
end

function ShopService.start(isLobby)
	ShopService.isLobby = isLobby == true
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = Config.passKeyById(passId)
		if key then
			passCache[player] = passCache[player] or {}
			passCache[player][key] = true
			local data = DataService.get(player)
			if key == "VIP" and data then
				data.titles.VIP = true
			end
			Remotes.notify(player, "Пропуск активирован. Оно теперь знает твоё имя.", Color3.fromRGB(235, 185, 70))
			ShopService.applyCosmetics(player)
			DataService.push(player)
		end
	end)

	Remotes.ShopRequest.OnServerInvoke = function(player, action, arg)
		if type(action) ~= "string" then
			return false, "?"
		end
		return handleShopRequest(player, action, arg)
	end

	DataService.Loaded:Connect(function(player)
		ShopService.applyCosmetics(player)
	end)

	local function onPlayer(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			ShopService.applyCosmetics(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		passCache[p] = nil
	end)
end

return ShopService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA8"><Properties><string name="Name">MonsterAI</string><ProtectedString name="Source"><![CDATA[--[[
	ИИ Пациента 13.
	Состояния: Sleep -> Patrol -> Investigate (услышал бег) -> Chase (увидел) -> Search (потерял) -> Attack
	- видит дальше, если у игрока включён фонарик
	- слышит бегущих
	- игроки в шкафчиках невидимы, если монстр не видел, как они туда залезли
	- с каждым предохранителем быстрее, после запуска генератора — в ярости
]]
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Sound = require(ReplicatedStorage.Shared.Sound)
local Remotes = require(ServerScriptService.Core.Remotes)

local C = Config.Monster

local AI = {}
AI.__index = AI

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function AI.new(model, map, opts)
	local self = setmetatable({}, AI)
	self.model = model
	self.hum = model:FindFirstChildOfClass("Humanoid")
	self.root = model:FindFirstChild("HumanoidRootPart")
	self.head = model:FindFirstChild("Head") or self.root
	self.map = map
	self.opts = opts or {}
	self.state = "Sleep"
	self.target = nil
	self.lastSeen = 0
	self.lastSeenPos = nil
	self.investigatePos = nil
	self.searchUntil = 0
	self.enraged = false
	self.fuses = 0
	self.alive = true
	self.exposed = {}
	self.cooldownUntil = 0
	self.lastScream = 0
	self.patrolGoal = nil
	self.waypoints = nil
	self.wpIndex = 1
	self.pathDest = nil
	self.pathTime = 0
	self.lastPos = self.root.Position
	self.lastStuckCheck = os.clock()
	self.stuckCount = 0

	self.nodes = {}
	local nodesFolder = map:FindFirstChild("AINodes")
	if nodesFolder then
		for _, n in ipairs(nodesFolder:GetChildren()) do
			if n:IsA("BasePart") then
				table.insert(self.nodes, n.Position)
			end
		end
	end

	self.path = PathfindingService:CreatePath({
		AgentRadius = 2.6,
		AgentHeight = 10,
		AgentCanJump = false,
		WaypointSpacing = 6,
	})

	self.ray = RaycastParams.new()
	self.ray.FilterType = Enum.RaycastFilterType.Exclude
	self.ray.RespectCanCollide = true

	self.hum.WalkSpeed = 0
	self.hum.AutoRotate = true
	model:SetAttribute("State", "Sleep")

	-- дыхание (3D, слышно из-за угла)
	self.breath = Sound.make("MonsterBreath", self.head, {
		Looped = true,
		Volume = 0.6,
		RollOffMinDistance = 6,
		RollOffMaxDistance = 70,
	})
	if self.breath then
		self.breath:Play()
	end
	return self
end

function AI:setState(s)
	if self.state == s then
		return
	end
	self.state = s
	self.model:SetAttribute("State", s)
	if self.breath then
		self.breath.PlaybackSpeed = (s == "Chase") and 1.35 or 1
		self.breath.Volume = (s == "Chase") and 1 or 0.6
	end
end

function AI:refreshFilter()
	local list = { self.model }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local lf = workspace:FindFirstChild("LocalFlashlight")
	if lf then
		table.insert(list, lf)
	end
	self.ray.FilterDescendantsInstances = list
end

function AI:isCandidate(player)
	if self.opts.isAlive and not self.opts.isAlive(player) then
		return false
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return false
	end
	return true, hrp
end

function AI:eye()
	return self.head.Position
end

function AI:lineClear(fromPos, toPos)
	local dir = toPos - fromPos
	if dir.Magnitude < 0.1 then
		return true
	end
	local hit = workspace:Raycast(fromPos, dir, self.ray)
	return hit == nil
end

function AI:canSee(player)
	local ok, hrp = self:isCandidate(player)
	if not ok then
		return false
	end
	if player:GetAttribute("Hiding") and not self.exposed[player] then
		return false
	end
	local eye = self:eye()
	local targetPos = hrp.Position + Vector3.new(0, 1.2, 0)
	local toT = targetPos - eye
	local dist = toT.Magnitude
	local range = player:GetAttribute("FlashlightOn") and C.FlashlightSightRange or C.SightRange
	if self.enraged then
		range += 30
	end
	if dist > range then
		return false
	end
	if dist > 14 then
		local look = flat(self.root.CFrame.LookVector)
		local d = flat(toT)
		if look.Magnitude > 0 and d.Magnitude > 0 then
			local ang = math.deg(math.acos(math.clamp(look.Unit:Dot(d.Unit), -1, 1)))
			if ang > C.FOV / 2 then
				return false
			end
		end
	end
	if player:GetAttribute("Hiding") then
		return true -- видел, как залез в шкаф
	end
	return self:lineClear(eye, targetPos)
end

function AI:notifyHide(player)
	if self.target == player and os.clock() - self.lastSeen < 1.5 then
		self.exposed[player] = true
	else
		self.exposed[player] = nil
	end
end

function AI:notifyUnhide(player)
	self.exposed[player] = nil
end

function AI:speedFor(state)
	local bonus = self.fuses * C.ChaseSpeedPerFuse + (self.enraged and C.EnragedBonus or 0)
	if state == "Chase" then
		return C.ChaseSpeed + bonus
	elseif state == "Investigate" or state == "Search" then
		return C.InvestigateSpeed + bonus * 0.5
	end
	return C.PatrolSpeed + bonus * 0.3
end

function AI:computePath(dest)
	local ok = pcall(function()
		self.path:ComputeAsync(self.root.Position, dest)
	end)
	self.pathTime = os.clock()
	self.pathDest = dest
	if ok and self.path.Status == Enum.PathStatus.Success then
		self.waypoints = self.path:GetWaypoints()
		self.wpIndex = math.min(2, #self.waypoints)
		return true
	end
	self.waypoints = nil
	return false
end

-- движение к точке; возвращает true, когда дошёл
function AI:moveTowards(dest, repathEvery)
	local pos = self.root.Position
	if (flat(dest) - flat(pos)).Magnitude < 4 then
		return true
	end
	-- прямая видимость — идём напрямую (быстрее и страшнее)
	local destAtRoot = Vector3.new(dest.X, pos.Y, dest.Z)
	local right = self.root.CFrame.RightVector * 2.4
	if (destAtRoot - pos).Magnitude < 70
		and self:lineClear(pos, destAtRoot)
		and self:lineClear(pos + Vector3.new(0, 3.5, 0), destAtRoot + Vector3.new(0, 3.5, 0))
		and self:lineClear(pos + right, destAtRoot + right)
		and self:lineClear(pos - right, destAtRoot - right)
	then
		self.waypoints = nil
		self.hum:MoveTo(dest)
		return false
	end
	if
		not self.waypoints
		or not self.pathDest
		or (self.pathDest - dest).Magnitude > 6
		or os.clock() - self.pathTime > (repathEvery or 2)
	then
		if not self:computePath(dest) then
			self.hum:MoveTo(dest)
			return false
		end
	end
	local wp = self.waypoints[self.wpIndex]
	while wp and (flat(wp.Position) - flat(self.root.Position)).Magnitude < 3.5 do
		self.wpIndex += 1
		wp = self.waypoints[self.wpIndex]
	end
	if not wp then
		self.waypoints = nil
		return true
	end
	self.hum:MoveTo(wp.Position)
	return false
end

function AI:pickPatrolGoal()
	if #self.nodes == 0 then
		return self.root.Position
	end
	-- иногда он "чувствует" игрока и идёт в его сторону
	if math.random() < (self.enraged and 0.8 or C.HuntChance) then
		local candidates = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local ok, hrp = self:isCandidate(p)
			if ok then
				table.insert(candidates, hrp.Position)
			end
		end
		if #candidates > 0 then
			local target = candidates[math.random(1, #candidates)]
			local best, bestD = nil, math.huge
			for _, n in ipairs(self.nodes) do
				local d = (n - target).Magnitude + math.random() * 40
				if d < bestD then
					best, bestD = n, d
				end
			end
			if best then
				return best
			end
		end
	end
	return self.nodes[math.random(1, #self.nodes)]
end

function AI:scream()
	if os.clock() - self.lastScream > 18 then
		self.lastScream = os.clock()
		Sound.play("MonsterScream", self.head, {
			Volume = 0.9,
			PlaybackSpeed = 1.15,
			RollOffMinDistance = 12,
			RollOffMaxDistance = 160,
		})
	end
end

function AI:catch(player)
	local ok, hrp = self:isCandidate(player)
	if not ok then
		return
	end
	self:setState("Attack")
	self.target = nil
	self.hum:MoveTo(self.root.Position)
	player:SetAttribute("Caught", true)
	if player:GetAttribute("Hiding") and self.opts.onDragOut then
		self.opts.onDragOut(player)
	end
	hrp.Anchored = true
	local look = Vector3.new(hrp.Position.X, self.root.Position.Y, hrp.Position.Z)
	if (look - self.root.Position).Magnitude > 0.1 then
		self.root.Anchored = true
		self.root.CFrame = CFrame.lookAt(self.root.Position, look)
	end
	-- жертву разворачиваем лицом к монстру
	local facePos = Vector3.new(self.root.Position.X, hrp.Position.Y, self.root.Position.Z)
	if (facePos - hrp.Position).Magnitude > 0.1 then
		hrp.CFrame = CFrame.lookAt(hrp.Position, facePos)
	end
	Remotes.Jumpscare:FireClient(player, self.model)
	Sound.play("MonsterScream", self.head, { Volume = 1.3, RollOffMinDistance = 15, RollOffMaxDistance = 180 })
	task.wait(2.4)
	if self.opts.onCatch then
		self.opts.onCatch(player)
	end
	self.exposed[player] = nil
	self.root.Anchored = false
	pcall(function()
		self.root:SetNetworkOwner(nil)
	end)
	self.cooldownUntil = os.clock() + 3
	self:setState("Patrol")
	self.patrolGoal = self:pickPatrolGoal()
end

function AI:wake()
	if self.state ~= "Sleep" then
		return
	end
	self:setState("Patrol")
	self:scream()
	pcall(function()
		self.root:SetNetworkOwner(nil)
	end)
	task.spawn(function()
		self:loop()
	end)
end

function AI:hunt()
	-- идёт к ближайшему игроку (после запуска генератора)
	local best, bestD = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, hrp = self:isCandidate(p)
		if ok and not p:GetAttribute("Hiding") then
			local d = (hrp.Position - self.root.Position).Magnitude
			if d < bestD then
				best, bestD = hrp.Position, d
			end
		end
	end
	if best then
		self.investigatePos = best
		self:setState("Investigate")
	end
end

function AI:stop()
	self.alive = false
	if self.breath then
		self.breath:Stop()
	end
end

function AI:loop()
	local filterTick = 0
	while self.alive and self.model.Parent and self.hum.Health > 0 do
		local dt = task.wait(0.1)
		filterTick += dt
		if filterTick > 1 then
			filterTick = 0
			self:refreshFilter()
		end
		if self.state == "Attack" or os.clock() < self.cooldownUntil then
			continue
		end

		-- кого видим / слышим
		local seen, seenD, seenHrp = nil, math.huge, nil
		local heardPos = nil
		for _, p in ipairs(Players:GetPlayers()) do
			local ok, hrp = self:isCandidate(p)
			if ok then
				local d = (hrp.Position - self.root.Position).Magnitude
				if self:canSee(p) then
					if d < seenD then
						seen, seenD, seenHrp = p, d, hrp
					end
				elseif p:GetAttribute("Sprinting") and not p:GetAttribute("Hiding") and d < C.HearSprintRange then
					heardPos = hrp.Position
				end
			end
		end

		if seen then
			if self.state ~= "Chase" then
				self:scream()
			end
			self.target = seen
			self.lastSeen = os.clock()
			self.lastSeenPos = seenHrp.Position
			self:setState("Chase")
		elseif heardPos and self.state ~= "Chase" then
			self.investigatePos = heardPos
			self:setState("Investigate")
		end

		local state = self.state
		self.hum.WalkSpeed = self:speedFor(state)

		if state == "Chase" then
			local ok, hrp = false, nil
			if self.target then
				ok, hrp = self:isCandidate(self.target)
			end
			if not ok then
				self.target = nil
				self:setState("Search")
				self.searchUntil = os.clock() + 5
			else
				local d = (hrp.Position - self.root.Position).Magnitude
				local hiddenSafe = self.target:GetAttribute("Hiding") and not self.exposed[self.target]
				if d <= C.KillRange and not hiddenSafe and math.abs(hrp.Position.Y - self.root.Position.Y) < 8 then
					self:catch(self.target)
					continue
				end
				if os.clock() - self.lastSeen > C.LoseTargetTime or hiddenSafe then
					self.target = nil
					self:setState("Search")
					self.searchUntil = os.clock() + 6
				else
					-- пока видит — бежит к игроку, потерял — к последней точке (недолго "чует")
					local dest = (os.clock() - self.lastSeen < 2) and hrp.Position or self.lastSeenPos
					self:moveTowards(dest, 0.6)
				end
			end
		elseif state == "Investigate" then
			if not self.investigatePos or self:moveTowards(self.investigatePos, 1.5) then
				self:setState("Search")
				self.searchUntil = os.clock() + 4
			end
		elseif state == "Search" then
			if self.lastSeenPos and (flat(self.lastSeenPos) - flat(self.root.Position)).Magnitude > 5 then
				if self:moveTowards(self.lastSeenPos, 1.5) then
					self.lastSeenPos = nil
				end
			else
				-- осматривается: резкие повороты на месте
				if math.random() < 0.15 then
					local a = math.random() * math.pi * 2
					self.hum:MoveTo(self.root.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * 3)
				end
			end
			if os.clock() > self.searchUntil then
				self.lastSeenPos = nil
				self:setState("Patrol")
				self.patrolGoal = self:pickPatrolGoal()
			end
		elseif state == "Patrol" then
			if not self.patrolGoal then
				self.patrolGoal = self:pickPatrolGoal()
			end
			if self:moveTowards(self.patrolGoal, 4) then
				self.patrolGoal = self:pickPatrolGoal()
			end
		end

		-- застрял?
		if os.clock() - self.lastStuckCheck > 1.5 then
			local moved = (flat(self.root.Position) - flat(self.lastPos)).Magnitude
			self.lastPos = self.root.Position
			self.lastStuckCheck = os.clock()
			if moved < 1 and self.state ~= "Search" then
				self.stuckCount += 1
				self.waypoints = nil
				if self.stuckCount >= 2 then
					self.stuckCount = 0
					if self.state == "Patrol" or self.state == "Investigate" then
						self:setState("Patrol")
						self.patrolGoal = self:pickPatrolGoal()
					end
					-- небольшой сдвиг назад
					self.hum:MoveTo(self.root.Position - self.root.CFrame.LookVector * 4)
				end
			else
				self.stuckCount = 0
			end
		end
	end
end

return AI
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Script" referent="RBX00004DA9"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	ПАЛАТА 13 — сервер раунда (плейс "Больница").
	Цель: найти 5 предохранителей, вставить в генератор, выбежать через ворота во дворе.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local TeleportService = game:GetService("TeleportService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Core = ServerScriptService:WaitForChild("Core")
local Remotes = require(Core.Remotes)
local DataService = require(Core.DataService)
local ShopService = require(Core.ShopService)
local BPService = require(Core.BattlePassService)
local FS = require(Core.FlashlightService)
local MonsterAI = require(Core.MonsterAI)

local Config = require(ReplicatedStorage.Shared.Config)
local Sound = require(ReplicatedStorage.Shared.Sound)

Players.CharacterAutoLoads = false

DataService.start()
ShopService.start(false)
BPService.start()
FS.start(false)

local Map = workspace:WaitForChild("Map")
local Spawns = Map:WaitForChild("Spawns")
local Generator = Map:WaitForChild("Generator")
local Slot = Generator:WaitForChild("Slot")
local ExitZone = Map:WaitForChild("ExitZone")

local R = Config.Round
local round = nil -- текущий раунд
local ai = nil
local pickupFolder = Instance.new("Folder")
pickupFolder.Name = "Pickups"
pickupFolder.Parent = workspace

workspace:SetAttribute("RoundState", "Waiting")
workspace:SetAttribute("Power", false)
workspace:SetAttribute("FusesInserted", 0)
workspace:SetAttribute("FusesNeeded", R.Fuses)
workspace:SetAttribute("TimeLeft", R.TimeLimit)

local function message(text, color)
	Remotes.RoundUpdate:FireAllClients("message", text, color)
end

local function shuffle(t)
	for i = #t, 2, -1 do
		local j = math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

local function ps(player)
	return round and round.players[player]
end

local function isAlive(player)
	local s = ps(player)
	return s ~= nil and s.alive and not s.escaped and not player:GetAttribute("Caught")
end

-- ПРЕДМЕТЫ ---------------------------------------------------------------
local function makeFuse(position)
	local m = Instance.new("Model")
	m.Name = "Fuse"
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Cylinder
	body.Size = Vector3.new(1.4, 0.55, 0.55)
	body.Material = Enum.Material.Glass
	body.Color = Color3.fromRGB(255, 190, 60)
	body.Transparency = 0.25
	body.Anchored = true
	body.CanCollide = false
	body.CFrame = CFrame.new(position + Vector3.new(0, 0.35, 0)) * CFrame.Angles(0, math.random() * 6.28, 0)
	body.Parent = m
	for _, x in ipairs({ -0.6, 0.6 }) do
		local cap = Instance.new("Part")
		cap.Shape = Enum.PartType.Cylinder
		cap.Size = Vector3.new(0.22, 0.62, 0.62)
		cap.Material = Enum.Material.Metal
		cap.Color = Color3.fromRGB(170, 170, 160)
		cap.Anchored = true
		cap.CanCollide = false
		cap.CFrame = body.CFrame * CFrame.new(x, 0, 0)
		cap.Parent = m
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 170, 50)
	glow.Range = 7
	glow.Brightness = 0.9
	glow.Parent = body
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Взять"
	prompt.ObjectText = "Предохранитель"
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	m.PrimaryPart = body
	m.Parent = pickupFolder
	prompt.Triggered:Connect(function(player)
		if not isAlive(player) or not m.Parent then
			return
		end
		if player:GetAttribute("Fuse") then
			Remotes.notify(player, "Ты уже несёшь предохранитель. Отнеси его в генераторную.")
			return
		end
		Sound.playAt("Pickup", body.Position, { Volume = 0.8 })
		m:Destroy()
		player:SetAttribute("Fuse", true)
		Remotes.notify(player, "Предохранитель у тебя. Генератор — в северо-восточном крыле.", Color3.fromRGB(255, 190, 60))
	end)
	return m
end

local function makeBattery(position)
	local p = Instance.new("Part")
	p.Name = "Battery"
	p.Size = Vector3.new(0.5, 0.9, 0.5)
	p.Shape = Enum.PartType.Block
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(40, 140, 60)
	p.Anchored = true
	p.CanCollide = false
	p.CFrame = CFrame.new(position + Vector3.new(0, 0.45, 0)) * CFrame.Angles(0, math.random() * 6.28, 0)
	local tip = Instance.new("Part")
	tip.Size = Vector3.new(0.25, 0.15, 0.25)
	tip.Material = Enum.Material.Metal
	tip.Color = Color3.fromRGB(200, 200, 190)
	tip.Anchored = true
	tip.CanCollide = false
	tip.CFrame = p.CFrame * CFrame.new(0, 0.52, 0)
	tip.Parent = p
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(120, 255, 140)
	glow.Range = 5
	glow.Brightness = 0.6
	glow.Parent = p
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Взять"
	prompt.ObjectText = "Батарейка"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = p
	p.Parent = pickupFolder
	prompt.Triggered:Connect(function(player)
		if not isAlive(player) or not p.Parent then
			return
		end
		if (player:GetAttribute("Battery") or 0) >= 99 then
			Remotes.notify(player, "Батарея и так полная.")
			return
		end
		Sound.playAt("Pickup", p.Position, { Volume = 0.6, PlaybackSpeed = 1.2 })
		p:Destroy()
		FS.addBattery(player, 40)
		Remotes.notify(player, "+40% батареи", Color3.fromRGB(120, 255, 140))
	end)
	return p
end

local function spawnPickups()
	pickupFolder:ClearAllChildren()
	local fuseSpots = {}
	for _, s in ipairs(Spawns:WaitForChild("Fuse"):GetChildren()) do
		table.insert(fuseSpots, s.Position)
	end
	shuffle(fuseSpots)
	for i = 1, math.min(R.Fuses, #fuseSpots) do
		makeFuse(fuseSpots[i])
	end
	local batSpots = {}
	for _, s in ipairs(Spawns:WaitForChild("Battery"):GetChildren()) do
		table.insert(batSpots, s.Position)
	end
	shuffle(batSpots)
	for i = 1, math.min(R.Batteries, #batSpots) do
		makeBattery(batSpots[i])
	end
end

-- ШКАФЧИКИ -------------------------------------------------------------
local lockers = {}

local function exitLocker(player)
	for locker, occ in pairs(lockers) do
		if occ == player then
			lockers[locker] = nil
			local door = locker:FindFirstChild("Door")
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and door then
				hrp.Anchored = false
				hrp.CFrame = door.CFrame * CFrame.new(0, 0, -3)
			end
			if door then
				Sound.playAt("MetalBang", door.Position, { Volume = 0.25, PlaybackSpeed = 1.7 })
			end
		end
	end
	player:SetAttribute("Hiding", false)
	if ai then
		ai:notifyUnhide(player)
	end
end

local function setupLockers()
	local folder = Map:FindFirstChild("Lockers")
	if not folder then
		return
	end
	for _, locker in ipairs(folder:GetChildren()) do
		local door = locker:FindFirstChild("Door")
		local inside = locker:FindFirstChild("Inside")
		if door and inside then
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = "Спрятаться / Выйти"
			prompt.ObjectText = "Шкафчик"
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 7
			prompt.RequiresLineOfSight = false
			prompt.Parent = door
			prompt.Triggered:Connect(function(player)
				if lockers[locker] == player then
					exitLocker(player)
					return
				end
				if not isAlive(player) or player:GetAttribute("Hiding") then
					return
				end
				if lockers[locker] then
					Remotes.notify(player, "Здесь уже кто-то есть...")
					return
				end
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then
					return
				end
				lockers[locker] = player
				hrp.Anchored = true
				hrp.CFrame = inside.CFrame
				player:SetAttribute("Hiding", true)
				FS.setOn(player, false)
				Sound.playAt("MetalBang", door.Position, { Volume = 0.25, PlaybackSpeed = 1.6 })
				if ai then
					ai:notifyHide(player)
				end
			end)
		end
	end
end
setupLockers()

-- ГЕНЕРАТОР / ДВЕРИ ---------------------------------------------------------
local doorStates = {}
local function rememberDoor(part)
	if part and part:IsA("BasePart") and not doorStates[part] then
		doorStates[part] = part.CFrame
	end
end
local function doorParts(name)
	local obj = Map:FindFirstChild(name)
	local list = {}
	if obj then
		if obj:IsA("BasePart") then
			table.insert(list, obj)
		end
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(list, d)
			end
		end
	end
	for _, p in ipairs(list) do
		rememberDoor(p)
	end
	return list
end
local entranceParts = doorParts("EntranceDoor")
local exitParts = doorParts("ExitGate")

local function openDoors(parts, offset, time)
	for _, p in ipairs(parts) do
		TweenService:Create(p, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			CFrame = doorStates[p] + offset,
		}):Play()
	end
end

local function closeDoors()
	for p, cf in pairs(doorStates) do
		p.CFrame = cf
	end
end

local indicators = {}
for i = 1, R.Fuses do
	local ind = Generator:FindFirstChild("I" .. i)
	if ind then
		indicators[i] = ind
	end
end
local function setIndicators(n)
	for i, ind in pairs(indicators) do
		local on = i <= n
		ind.Material = Enum.Material.Neon
		ind.Color = on and Color3.fromRGB(60, 255, 90) or Color3.fromRGB(120, 10, 10)
	end
end
setIndicators(0)

local function powerOn()
	if workspace:GetAttribute("Power") then
		return
	end
	workspace:SetAttribute("Power", true)
	Sound.playAt("GeneratorOn", Slot.Position, { Volume = 1.5, RollOffMaxDistance = 250 })
	message("ГЕНЕРАТОР ЗАПУЩЕН. ВЫХОД ОТКРЫТ. БЕГИ.", Color3.fromRGB(255, 60, 60))
	openDoors(entranceParts, Vector3.new(0, 12, 0), 3)
	openDoors(exitParts, Vector3.new(0, -13, 0), 5)
	if ai then
		ai.enraged = true
		ai:hunt()
	end
end

local slotPrompt = Instance.new("ProximityPrompt")
slotPrompt.ActionText = "Вставить предохранитель"
slotPrompt.ObjectText = "Генератор"
slotPrompt.HoldDuration = 1.2
slotPrompt.MaxActivationDistance = 9
slotPrompt.RequiresLineOfSight = false
slotPrompt.Parent = Slot
slotPrompt.Triggered:Connect(function(player)
	if not round or not isAlive(player) then
		return
	end
	if not player:GetAttribute("Fuse") then
		Remotes.notify(player, "Нужен предохранитель. Ищи их в палатах.")
		return
	end
	player:SetAttribute("Fuse", false)
	round.fuses += 1
	workspace:SetAttribute("FusesInserted", round.fuses)
	setIndicators(round.fuses)
	Sound.playAt("FuseInsert", Slot.Position, { Volume = 1, RollOffMaxDistance = 120 })
	local s = ps(player)
	if s then
		s.fuses += 1
		s.coins += Config.Rewards.Fuse.coins
		s.xp += Config.Rewards.Fuse.xp
	end
	if ai then
		ai.fuses = round.fuses
	end
	if round.fuses >= R.Fuses then
		powerOn()
	else
		message("ПРЕДОХРАНИТЕЛЬ " .. round.fuses .. "/" .. R.Fuses .. ". Оно стало быстрее...", Color3.fromRGB(255, 190, 60))
	end
end)

-- ИГРОКИ -----------------------------------------------------------------
local function dropFuse(player, position)
	if player:GetAttribute("Fuse") then
		player:SetAttribute("Fuse", false)
		if position then
			makeFuse(position - Vector3.new(0, 2.6, 0))
		end
	end
end

local function spawnCharacter(player)
	player:SetAttribute("Caught", false)
	player:SetAttribute("Hiding", false)
	player:SetAttribute("Dead", false)
	player:SetAttribute("Escaped", false)
	player:LoadCharacter()
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	hum.WalkSpeed = Config.Player.WalkSpeed
	hum.JumpPower = 38
	hum.UseJumpPower = true
	hum.Died:Connect(function()
		local s = ps(player)
		if s and s.alive and not s.escaped then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			dropFuse(player, hrp and hrp.Position)
			s.alive = false
			player:SetAttribute("Dead", true)
		end
	end)
	return char
end

local function killPlayer(player)
	local s = ps(player)
	if not s or not s.alive then
		return
	end
	exitLocker(player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	dropFuse(player, hrp and hrp.Position)
	s.alive = false
	s.coins += Config.Rewards.Death.coins
	s.xp += Config.Rewards.Death.xp
	player:SetAttribute("Dead", true)
	player:SetAttribute("Caught", false)
	FS.setOn(player, false)
	if char then
		-- тело остаётся лежать — страшная находка для других
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hrp then
			hrp.Anchored = false
		end
		if hum then
			hum.BreakJointsOnDeath = true
			hum.Health = 0
		end
	end
	local data = DataService.get(player)
	if data then
		data.stats.deaths += 1
	end
	message(player.DisplayName .. " больше не отвечает...", Color3.fromRGB(200, 40, 40))
end

local function revive(player)
	local s = ps(player)
	if not round or round.ended or not s or s.alive or s.escaped then
		return false
	end
	s.alive = true
	task.spawn(function()
		spawnCharacter(player)
		player:SetAttribute("Battery", 60)
		Remotes.notify(player, "Ты вернулся. Оно знает.", Color3.fromRGB(110, 200, 110))
	end)
	return true
end

ShopService.onRevivePurchased = function(player)
	return revive(player)
end

Remotes.UseRevive.OnServerInvoke = function(player)
	local s = ps(player)
	if not s or s.alive or s.escaped or not round or round.ended then
		return false, "Сейчас нельзя"
	end
	local data = DataService.get(player)
	if not data or data.revives <= 0 then
		return false, "Нет жетонов"
	end
	data.revives -= 1
	DataService.push(player)
	return revive(player), "Возрождение..."
end

Players.PlayerAdded:Connect(function(player)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMaxZoomDistance = 0.5
	if round and not round.ended then
		-- опоздавший: если раунд идёт < 90 сек, запускаем в игру, иначе зритель
		round.players[player] = { alive = false, escaped = false, fuses = 0, coins = 0, xp = 0, joined = os.clock() }
		if os.clock() - round.start < 90 then
			round.players[player].alive = true
			task.spawn(spawnCharacter, player)
		else
			player:SetAttribute("Dead", true)
			Remotes.notify(player, "Раунд уже идёт. Ты наблюдаешь.")
		end
	end
end)
for _, p in ipairs(Players:GetPlayers()) do
	p.CameraMode = Enum.CameraMode.LockFirstPerson
end

Players.PlayerRemoving:Connect(function(player)
	exitLocker(player)
	if round then
		local s = round.players[player]
		if s and player:GetAttribute("Fuse") then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			dropFuse(player, hrp and hrp.Position)
		end
		round.players[player] = nil
	end
end)

-- МОНСТР -----------------------------------------------------------------
local function spawnMonster()
	local template = ServerStorage:FindFirstChild("Monster")
	if not template then
		warn("[Палата13] Нет ServerStorage.Monster")
		return nil
	end
	local old = workspace:FindFirstChild("Monster")
	if old then
		old:Destroy()
	end
	local m = template:Clone()
	m.Name = "Monster"
	local spawnPart = Map:FindFirstChild("MonsterSpawn")
	if spawnPart then
		m:PivotTo(spawnPart.CFrame)
	end
	m.Parent = workspace
	return MonsterAI.new(m, Map, {
		isAlive = isAlive,
		onCatch = function(player)
			killPlayer(player)
		end,
		onDragOut = function(player)
			exitLocker(player)
		end,
	})
end

-- РАУНД ------------------------------------------------------------------
local function countAlive()
	local n = 0
	for p, s in pairs(round.players) do
		if p.Parent and s.alive and not s.escaped then
			n += 1
		end
	end
	return n
end

local function finishRound()
	round.ended = true
	workspace:SetAttribute("RoundState", "Ended")
	if ai then
		ai:stop()
	end
	local savedAt = {}
	for player, s in pairs(round.players) do
		if player.Parent then
			local data = DataService.get(player)
			local survived = os.clock() - round.start
			local surviveXP = math.floor(survived / 10) * Config.Rewards.SurviveXPPer10s
			s.xp += surviveXP
			if s.escaped then
				s.coins += Config.Rewards.Escape.coins
				s.xp += Config.Rewards.Escape.xp
			end
			local vip = ShopService.hasPass(player, "VIP")
			local coins = vip and s.coins * 2 or s.coins
			if data then
				data.coins += coins
				data.stats.games += 1
				if s.escaped then
					data.stats.escapes += 1
				end
			end
			BPService.addXP(player, s.xp)
			DataService.push(player)
			Remotes.Results:FireClient(player, {
				escaped = s.escaped,
				fuses = s.fuses,
				coins = coins,
				vip = vip,
				xp = s.xp,
				time = math.floor(survived),
				totalFuses = round.fuses,
			})
		end
	end
	task.wait(R.ReturnToLobbyDelay)

	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, t = DataService.saveAsync(player)
		if ok then
			savedAt[tostring(player.UserId)] = t
		end
		table.insert(list, player)
	end

	if Config.LobbyPlaceId == 0 or RunService:IsStudio() then
		message(RunService:IsStudio() and "В Studio телепорт в лобби не работает. Новый раунд..." or "LobbyPlaceId не задан в Config. Новый раунд...")
		return false
	end
	for _, p in ipairs(list) do
		p:SetAttribute("AlreadySaved", true)
	end
	Remotes.Teleporting:FireAllClients()
	task.wait(1.2)
	local options = Instance.new("TeleportOptions")
	options:SetTeleportData({ savedAt = savedAt, from = "game" })
	local ok, err = pcall(function()
		return TeleportService:TeleportAsync(Config.LobbyPlaceId, list, options)
	end)
	if not ok then
		warn("[Палата13] Телепорт в лобби не удался:", err)
		for _, p in ipairs(list) do
			p:SetAttribute("AlreadySaved", nil)
		end
		message("Телепорт не удался. Новый раунд...")
		return false
	end
	return true
end

TeleportService.TeleportInitFailed:Connect(function(player, _, msg)
	player:SetAttribute("AlreadySaved", nil)
	Remotes.notify(player, "Ошибка телепорта: " .. tostring(msg) .. ". Перезайди в игру.")
end)

local function resetMap()
	workspace:SetAttribute("Power", false)
	workspace:SetAttribute("FusesInserted", 0)
	closeDoors()
	setIndicators(0)
	for _, p in ipairs(Players:GetPlayers()) do
		exitLocker(p)
	end
	lockers = {}
	spawnPickups()
end

local function runRound()
	-- ждём игроков (остальные из группы ещё грузятся)
	workspace:SetAttribute("RoundState", "Waiting")
	while #Players:GetPlayers() == 0 do
		task.wait(0.5)
	end
	for i = R.WaitForPlayers, 1, -1 do
		workspace:SetAttribute("TimeLeft", i)
		Remotes.RoundUpdate:FireAllClients("waiting", i)
		task.wait(1)
	end

	resetMap()
	round = { players = {}, fuses = 0, start = os.clock(), ended = false }
	for _, player in ipairs(Players:GetPlayers()) do
		round.players[player] = { alive = true, escaped = false, fuses = 0, coins = 0, xp = 0, joined = os.clock() }
		player:SetAttribute("Battery", 100)
		player:SetAttribute("Fuse", false)
		player:SetAttribute("FlashlightOn", false)
		player:SetAttribute("AlreadySaved", nil)
		task.spawn(spawnCharacter, player)
	end
	workspace:SetAttribute("RoundState", "Playing")
	message("НАЙДИ 5 ПРЕДОХРАНИТЕЛЕЙ. ЗАПУСТИ ГЕНЕРАТОР. НЕ ШУМИ.", Color3.fromRGB(235, 225, 215))

	ai = spawnMonster()
	local woke = false
	local lastXpTick = os.clock()
	while true do
		task.wait(0.25)
		local elapsed = os.clock() - round.start
		local left = math.max(0, R.TimeLimit - elapsed)
		workspace:SetAttribute("TimeLeft", math.floor(left))

		if not woke and elapsed >= R.MonsterWakeDelay and ai then
			woke = true
			ai:wake()
			message("В МОРГЕ ЧТО-ТО ПРОСНУЛОСЬ.", Color3.fromRGB(255, 40, 40))
		end

		-- побег
		if workspace:GetAttribute("Power") then
			for player, s in pairs(round.players) do
				if s.alive and not s.escaped then
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if hrp then
						local rel = ExitZone.CFrame:PointToObjectSpace(hrp.Position)
						local half = ExitZone.Size / 2
						if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y + 4 and math.abs(rel.Z) <= half.Z then
							s.escaped = true
							player:SetAttribute("Escaped", true)
							FS.setOn(player, false)
							message(player.DisplayName .. " сбежал из Палаты 13!", Color3.fromRGB(110, 220, 110))
							if char then
								char:Destroy()
							end
						end
					end
				end
			end
		end

		-- время вышло: оно забирает всех
		if left <= 0 then
			for player, s in pairs(round.players) do
				if s.alive and not s.escaped and player.Parent then
					Remotes.Jumpscare:FireClient(player, workspace:FindFirstChild("Monster"))
				end
			end
			task.wait(2.4)
			for player, s in pairs(round.players) do
				if s.alive and not s.escaped then
					killPlayer(player)
				end
			end
		end

		if os.clock() - lastXpTick > 1 then
			lastXpTick = os.clock()
		end

		if countAlive() == 0 then
			break
		end
	end
	local anyEscaped = false
	for _, s in pairs(round.players) do
		if s.escaped then
			anyEscaped = true
		end
	end
	message(anyEscaped and "РАУНД ОКОНЧЕН. КТО-ТО ВЫБРАЛСЯ." or "НИКТО НЕ ВЫШЕЛ ИЗ ПАЛАТЫ 13.", Color3.fromRGB(255, 60, 60))
	task.wait(2.5)
	return finishRound()
end

task.spawn(function()
	while true do
		local teleported = runRound()
		if teleported then
			-- сервер опустеет и закроется; если кто-то остался — новый раунд
			task.wait(10)
		end
		local m = workspace:FindFirstChild("Monster")
		if m then
			m:Destroy()
		end
		ai = nil
		round = nil
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				p.Character:Destroy()
			end
			p:SetAttribute("Dead", false)
			p:SetAttribute("Escaped", false)
		end
	end
end)

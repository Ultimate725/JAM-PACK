		name = "КОШМАР",
		icon = "💀",
		desc = "Слепое — и поэтому слышит ВСЁ: шаги, присядку, фонарик, щелчки. Каждые полминуты кричит, и эхо выдаёт всех, кто шевелится. 4 генератора. Очень быстрое.",
		color = Color3.fromRGB(190, 60, 255),
		blind = true,
		hear = { crouch = 14, walk = 55, sprint = 140, flashlight = 70, interact = 110 },
		sight = 0,
		flashlightSight = 0,
		fov = 360,
		speed = { patrol = 11, investigate = 16, chase = 20 },
		loseTime = 12,
		wakeDelay = 10,
		generators = 4,
		timeLimit = 780,
		sonar = 30, -- секунд между эхо-криками (0 = нет)
		sense = 9,
		xpMult = 2,
		coinMult = 2,
	},
}

-- 9) РАУНД ------------------------------------------------------------------
Config.Round = {
	Fuses = 5, -- запасной параметр (реально = генераторов + 1)
	Batteries = 16,
	TimeLimit = 900,
	MonsterWakeDelay = 25,
	ReturnToLobbyDelay = 12,
	WaitForPlayers = 15,
	RepairTime = 14, -- секунд удержания на одном генераторе
	IntroTime = 9, -- показ сюжета карты
}

Config.Monster = {
	PatrolSpeed = 9,
	InvestigateSpeed = 13,
	ChaseSpeed = 17,
	ChaseSpeedPerGenerator = 0.6,
	EnragedBonus = 2.5,
	SightRange = 90,
	FlashlightSightRange = 125,
	HearSprintRange = 45,
	FOV = 150,
	KillRange = 5.5,
	LoseTargetTime = 6,
	HuntChance = 0.45, -- шанс что патруль пойдёт к случайному игроку
}

Config.Player = {
	WalkSpeed = 12,
	SprintSpeed = 20,
	CrouchSpeed = 6.5,
	StaminaMax = 100,
	StaminaDrain = 20,
	StaminaRegen = 13,
	BatteryDrainPerSec = 0.55,
	-- шум игрока (множитель к радиусу слуха монстра)
	Noise = { crouch = 1, walk = 1, sprint = 1 },
}

-- хелперы ------------------------------------------------------------------
function Config.getFlashlight(id)
	for _, f in ipairs(Config.Flashlights) do
		if f.id == id then
			return f
		end
	end
	return Config.Flashlights[1]
end

function Config.getTitle(id)
	for _, t in ipairs(Config.Titles) do
		if t.id == id then
			return t
		end
	end
	return nil
end

function Config.getMap(id)
	for _, m in ipairs(Config.Maps) do
		if m.id == id then
			return m
		end
	end
	return Config.Maps[1]
end

function Config.getDifficulty(id)
	for _, d in ipairs(Config.Difficulties) do
		if d.id == id then
			return d
		end
	end
	return Config.Difficulties[2]
end

function Config.getPerk(id)
	for _, p in ipairs(Config.Perks) do
		if p.id == id then
			return p
		end
	end
	return nil
end

function Config.productKeyById(productId)
	for key, id in pairs(Config.Products) do
		if id ~= 0 and id == productId then
			return key
		end
	end
	return nil
end

function Config.passKeyById(passId)
	for key, id in pairs(Config.GamePasses) do
		if id ~= 0 and id == passId then
			return key
		end
	end
	return nil
end

return Config
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D9A"><Properties><string name="Name">FlashlightClient</string><ProtectedString name="Source">--[[
	Локальный фонарик (клиент). Сервер решает вкл/выкл и батарею (атрибуты игрока),
	а тут красивый луч из камеры: плавное запаздывание, покачивание при ходьбе,
	мерцание при низком заряде и когда Пациент рядом.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FL = {}

function FL.start()
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local action = remotes:WaitForChild("Action")

	local part = Instance.new("Part")
	part.Name = "LocalFlashlight"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Parent = workspace

	local beam = Instance.new("SpotLight")
	beam.Face = Enum.NormalId.Front
	beam.Angle = 50
	beam.Range = 62
	beam.Brightness = 2.6
	beam.Shadows = true
	beam.Parent = part

	local hot = Instance.new("SpotLight")
	hot.Face = Enum.NormalId.Front
	hot.Angle = 20
	hot.Range = 75
	hot.Brightness = 1.6
	hot.Shadows = false
	hot.Parent = part

	local fill = Instance.new("PointLight")
	fill.Range = 7
	fill.Brightness = 0.25
	fill.Shadows = false
	fill.Parent = part

	local api = { part = part, forceFlicker = 0, disabled = false, steady = false }
	local current = workspace.CurrentCamera.CFrame
	local swayT = 0
	local flickerUntil = 0
	local flickerOn = true

	local function isOn()
		return player:GetAttribute("FlashlightOn") == true and not api.disabled
	end

	local function hideServerBeam(char)
		if not char then
			return
		end
		local function apply(d)
			if d:IsA("Light") and d.Parent and d.Parent.Name == "ServerBeam" then
				d.Brightness = 0
			end
		end
		for _, d in ipairs(char:GetDescendants()) do
			apply(d)
		end
		char.DescendantAdded:Connect(apply)
	end
	hideServerBeam(player.Character)
	player.CharacterAdded:Connect(hideServerBeam)

	function api.toggle()
		action:FireServer("flashlight")
	end

	ContextActionService:BindAction("Flashlight", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			api.toggle()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonL1)
	ContextActionService:SetTitle("Flashlight", "Фонарь")
	ContextActionService:SetPosition("Flashlight", UDim2.new(1, -200, 1, -150))

	local lastPitchSent = 0
	local lastSend = 0

	RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera
		local on = isOn()
		local color = player:GetAttribute("FlashColor")
		if typeof(color) == "Color3" then
			beam.Color = color
			hot.Color = color
			fill.Color = color
		end
		local big = player:GetAttribute("BigBattery") == true
		beam.Range = big and 78 or 62
		hot.Range = big and 90 or 75

		-- сглаженное следование за камерой + покачивание
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local moveSpeed = hum and hum.MoveDirection.Magnitude * hum.WalkSpeed or 0
		swayT += dt * (1 + moveSpeed * 0.45)
		local swayAmt = 0.012 + moveSpeed * 0.0018
		local sway = CFrame.Angles(math.sin(swayT * 2) * swayAmt, math.sin(swayT) * swayAmt * 1.4, 0)
		local target = cam.CFrame * CFrame.new(0.45, -0.35, -0.2) * sway
		current = current:Lerp(target, math.clamp(dt * 16, 0, 1))
		part.CFrame = current

		-- мерцание
		local battery = player:GetAttribute("Battery") or 100
		local monsterNear = 0
		local monster = workspace:FindFirstChild("Monster")
		if monster and monster:FindFirstChild("HumanoidRootPart") then
			local d = (monster.HumanoidRootPart.Position - cam.CFrame.Position).Magnitude
			monsterNear = math.clamp(1 - d / 32, 0, 1)
		end
		local flickerChance = 0
		if battery &lt; 20 then
			flickerChance += (20 - battery) / 20 * 0.06
		end
		flickerChance += (api.steady and 0 or monsterNear * 0.18) + api.forceFlicker
		local now = os.clock()
		if now &gt; flickerUntil then
			if math.random() &lt; flickerChance then
				flickerOn = false
				flickerUntil = now + 0.03 + math.random() * 0.12
			else
				flickerOn = true
			end
		end
		local lit = on and flickerOn
		local dim = (battery &lt; 10) and (0.45 + battery / 20) or 1
		beam.Enabled = lit
		hot.Enabled = lit
		fill.Enabled = lit
		beam.Brightness = 2.6 * dim
		hot.Brightness = 1.6 * dim

		-- отправляем серверу наклон луча, чтобы другие видели, куда ты светишь
		if on and now - lastSend &gt; 0.2 then
			local pitch = math.asin(math.clamp(cam.CFrame.LookVector.Y, -1, 1))
			if math.abs(pitch - lastPitchSent) &gt; 0.05 then
				lastPitchSent = pitch
				lastSend = now
				action:FireServer("aim", pitch)
			end
		end
	end)

	return api
end

return FL
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D9B"><Properties><string name="Name">MonsterAnimator</string><ProtectedString name="Source">--[[
	Процедурные анимации Пациента 13 (клиент):
	- ходьба / бег с рваной походкой (хромание, длинные руки волочатся)
	- дыхание в покое, дёрганья головы, подёргивание пальцев
	- режим погони: наклон вперёд, руки тянутся к жертве, челюсть открыта
	- атака: пасть раскрывается настежь, руки вверх
	- звуки шагов из стоп + тряска камеры рядом
	Работает через Motor6D.C0 (без загрузки анимаций на сайт).
]]
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Sound = require(script.Parent.Sound)

local Animator = {}
Animator.onFootstep = nil -- function(position, intensity)

local tracked = {}
local clock = os.clock

local function noise(t, seed)
	return math.noise(t, seed or 0, 0)
end

local function collectJoints(model)
	local joints = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then
			joints[d.Name] = { motor = d, base = d.C0 }
		end
	end
	return joints
end

function Animator.track(model)
	if tracked[model] then
		return
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local joints = collectJoints(model)
	local st = {
		model = model,
		root = root,
		joints = joints,
		phase = 0,
		walk = 0,
		lastSide = 0,
		headTarget = Vector3.zero,
		headCurrent = Vector3.zero,
		nextTwitch = clock() + 1,
		jaw = 0,
		lean = 0,
		reach = 0,
		seed = math.random() * 100,
		footL = model:FindFirstChild("LFoot", true),
		footR = model:FindFirstChild("RFoot", true),
		blind = model:GetAttribute("Blind") == true,
		sniffUntil = 0,
		sonarUntil = 0,
		listen = 0,
		eyes = {},
		dust = nil,
		rage = nil,
	}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("PointLight") and d.Parent and d.Parent.Name == "Eye" then
			table.insert(st.eyes, d)
		elseif d:IsA("ParticleEmitter") and d.Name == "Dust" then
			st.dust = d
		elseif d:IsA("PointLight") and d.Name == "Rage" then
			st.rage = d
		end
	end
	model:GetAttributeChangedSignal("Sniff"):Connect(function()
		st.sniffUntil = clock() + 1.6
		st.listen = (math.random() &lt; 0.5) and -1 or 1
	end)
	model:GetAttributeChangedSignal("Sonar"):Connect(function()
		st.sonarUntil = clock() + 1.1
	end)
	model:GetAttributeChangedSignal("Blind"):Connect(function()
		st.blind = model:GetAttribute("Blind") == true
	end)
	tracked[model] = st
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			tracked[model] = nil
		end
	end)
end

local function set(st, name, cf)
	local j = st.joints[name]
	if j then
		j.motor.C0 = j.base * cf
	end
end

local A = CFrame.Angles

local function step(st, dt)
	local now = clock()
	local state = st.model:GetAttribute("State") or "Patrol"
	local vel = st.root.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local moving = math.clamp(speed / 9, 0, 1.6)
	st.walk += (moving - st.walk) * math.min(dt * 6, 1)
	local w = st.walk

	-- частота шага растёт со скоростью
	st.phase += dt * (2.2 + speed * 0.32)
	local p = st.phase
	local s = math.sin(p)
	local c = math.cos(p)

	local chasing = state == "Chase"
	local attacking = state == "Attack"
	local leanTarget = chasing and -0.38 or (attacking and 0.15 or -0.08)
	st.lean += (leanTarget - st.lean) * math.min(dt * 4, 1)
	local reachTarget = chasing and 1 or (attacking and 1.4 or 0)
	st.reach += (reachTarget - st.reach) * math.min(dt * 5, 1)
	local jawTarget = attacking and 1 or (chasing and 0.55 or 0.08 + 0.06 * math.sin(now * 1.7))
	st.jaw += (jawTarget - st.jaw) * math.min(dt * (attacking and 18 or 6), 1)

	local breath = math.sin(now * (chasing and 5 or 1.6)) * 0.035
	local limp = 0.2 -- асимметрия походки: правая нога "хромает"

	-- таз / корпус
	local bob = -math.abs(s) * 0.32 * w
	set(st, "RootJoint", CFrame.new(0, bob, 0) * A(st.lean * 0.4, s * 0.12 * w, s * 0.09 * w))
	set(st, "Waist", A(st.lean + breath - math.abs(c) * 0.06 * w, -s * 0.22 * w, -s * 0.06 * w))

	-- голова: резкие неестественные дёрганья
	if now &gt; st.nextTwitch then
		st.nextTwitch = now + (chasing and 0.25 or 0.5) + math.random() * (chasing and 0.6 or 2.2)
		st.headTarget = Vector3.new((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.9, (math.random() - 0.5) * 1.3)
	end
	local sniffing = now &lt; st.sniffUntil
	local sonar = now &lt; st.sonarUntil
	if sniffing then
		-- прислушивается: голова набок, ухом вперёд, мелкая дрожь
		st.headTarget = Vector3.new(0.15, st.listen * 1.1, st.listen * 0.7)
	elseif sonar then
		st.headTarget = Vector3.new(-0.9, 0, 0) -- запрокидывает голову для крика
	elseif st.blind and not chasing then
		-- слепой постоянно "сканирует" ушами
		st.headTarget = Vector3.new(0.1 + noise(now * 0.7, st.seed + 40) * 0.3, noise(now * 0.5, st.seed + 41) * 1.6, noise(now * 0.6, st.seed + 42) * 0.8)
	end
	st.headCurrent = st.headCurrent:Lerp(st.headTarget, math.min(dt * (sniffing and 30 or 22), 1)) -- очень быстрый рывок
	local hc = st.headCurrent
	local shiver = noise(now * 9, st.seed) * (sniffing and 0.12 or 0.05)
	set(st, "NeckBase", A(-st.lean * 0.6 + 0.1, hc.Y * 0.3, 0))
	set(st, "Neck", A(hc.X - st.lean * 0.5 + shiver, hc.Y, hc.Z + shiver))

	-- челюсть (при эхо-крике пасть раскрыта до предела)
	local tremble = (chasing or attacking) and noise(now * 30, st.seed + 3) * 0.08 or 0
	local jawOpen = sonar and 1.3 or st.jaw
	set(st, "Jaw", A(-jawOpen * 0.85 + tremble, 0, 0))

	-- глаза и "ярость"
	local eyeBright = attacking and 3 or (chasing and 1.8 or 0.35)
	for _, e in ipairs(st.eyes) do
		e.Brightness = eyeBright + noise(now * 6, st.seed + 50) * 0.2
	end
	if st.rage then
		st.rage.Brightness = (st.model:GetAttribute("Enraged") and 0.8 or 0) + (attacking and 1.5 or 0)
	end
	if st.dust then
		st.dust.Enabled = w &gt; 0.3
		st.dust.Rate = 6 + w * 10
	end

	-- ноги (колени согнуты, шаг широкий)
	local legSwing = 0.65 * w
	local function leg(side, ph, amp)
		local sp = math.sin(ph)
		local lift = math.max(0, math.cos(ph))
		set(st, side .. "Hip", A(sp * legSwing * amp + 0.1, 0, 0))
		set(st, side .. "Knee", A(-(lift * 1.0 * w + 0.05), 0, 0))
		set(st, side .. "Ankle", A(-sp * 0.35 * w + lift * 0.4 * w, 0, 0))
	end
	leg("L", p, 1)
	leg("R", p + math.pi, 1 - limp)

	-- руки: длинные, болтаются с запаздыванием; в погоне тянутся вперёд
	local r = st.reach
	local function arm(side, ph, sign)
		local sw = math.sin(ph - 0.5) * 0.55 * w
		local twitch = noise(now * 3, st.seed + (sign &gt; 0 and 10 or 20)) * 0.12
		set(st, side .. "Shoulder", A(-sw + r * 1.15 + twitch, 0, sign * (0.12 + r * 0.15)))
		set(st, side .. "Elbow", A(0.25 + math.max(0, -math.sin(ph)) * 0.35 * w + r * 0.3, 0, 0))
		set(st, side .. "Wrist", A(0.15 + twitch * 2 - r * 0.4, 0, 0))
		for i = 1, 4 do
			local fn = noise(now * (attacking and 12 or 4), st.seed + i * 7 + sign * 3)
			local curl = 0.25 + fn * 0.35 - r * 0.2
			set(st, side .. "F" .. i .. "a", A(curl, 0, 0))
			set(st, side .. "F" .. i .. "b", A(curl * 1.3, 0, 0))
		end
	end
	arm("L", p + math.pi, -1)
	arm("R", p, 1)

	-- шаги: каждые полпериода одна нога бьёт о пол
	local side = s &gt;= 0 and 1 or -1
	if side ~= st.lastSide then
		st.lastSide = side
		if w &gt; 0.25 then
			local foot = side &gt; 0 and st.footR or st.footL
			local pos = foot and foot.Position or st.root.Position
			Sound.play("MonsterStep", foot or st.root, {
				Volume = 0.6 + 0.5 * math.min(w, 1.4),
				PlaybackSpeed = 0.85 + math.random() * 0.2,
				RollOffMinDistance = 10,
				RollOffMaxDistance = 110,
			})
			if Animator.onFootstep then
				Animator.onFootstep(pos, w)
			end
		end
	end
end

local started = false
function Animator.start()
	if started then
		return
	end
	started = true
	RunService.RenderStepped:Connect(function(dt)
		for model, st in pairs(tracked) do
			if model.Parent and st.root.Parent then
				step(st, dt)
			else
				tracked[model] = nil
			end
		end
	end)
end

-- камера трясётся от шагов рядом
function Animator.shakeAmountFor(position)
	local cam = workspace.CurrentCamera
	if not cam then
		return 0
	end
	local d = (cam.CFrame.Position - position).Magnitude
	return math.clamp(1 - d / 35, 0, 1)
end

local _ = Players
return Animator
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D9C"><Properties><string name="Name">Sound</string><ProtectedString name="Source">-- Проигрывание звуков по ключу из Config.Sounds. Если ID = 0 — тихо пропускаем (без ошибок).
-- Все звуки идут через SoundGroup'ы SoundService.Master -&gt; Music / SFX, чтобы работал ползунок громкости.
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)

local Sound = {}

local MUSIC_KEYS = { MenuMusic = true, Ambience = true, AmbienceMorgue = true, AmbienceForest = true, Wind = true }

local function ensureGroup(parent, name)
	local g = parent:FindFirstChild(name)
	if not g and RunService:IsClient() then
		g = parent:WaitForChild(name, 5) -- группы лежат в плейсе, ждём репликацию
	end
	if not g then
		g = Instance.new("SoundGroup")
		g.Name = name
		g.Volume = 1
		g.Parent = parent
	end
	return g
end

-- группы создаёт сервер (реплицируются), клиент только меняет Volume у себя
local master = ensureGroup(SoundService, "Master")
local musicGroup = ensureGroup(master, "Music")
local sfxGroup = ensureGroup(master, "SFX")
Sound.groups = { master = master, music = musicGroup, sfx = sfxGroup }

function Sound.id(key)
	local v = Config.Sounds[key]
	if v == nil or v == 0 or v == "" then
		return nil
	end
	if typeof(v) == "number" then
		return "rbxassetid://" .. tostring(v)
	end
	return tostring(v)
end

-- создать Sound (не запуская). parent = часть/аттачмент для 3D, nil = 2D
function Sound.make(key, parent, props)
	local id = Sound.id(key)
	if not id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = id
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 8
	s.RollOffMaxDistance = 90
	s.SoundGroup = MUSIC_KEYS[key] and musicGroup or sfxGroup
	if props then
		for k, v in pairs(props) do
			s[k] = v
		end
	end
	s.Parent = parent or SoundService
	return s
end

-- одноразовый звук
function Sound.play(key, parent, props)
	local s = Sound.make(key, parent, props)
	if not s then
		return nil
	end
	if not s.Looped then
		s.Ended:Connect(function()
			s:Destroy()
		end)
		Debris:AddItem(s, 25)
	end
	s:Play()
	return s
end

-- звук в точке пространства
function Sound.playAt(key, position, props)
	if not Sound.id(key) then
		return nil
	end
	local a = Instance.new("Attachment")
	a.WorldPosition = position
	a.Parent = workspace.Terrain
	Debris:AddItem(a, 25)
	return Sound.play(key, a, props)
end

-- громкость (клиент): значения 0..1
function Sound.setVolumes(masterV, musicV, sfxV)
	if RunService:IsClient() then
		master.Volume = math.clamp(masterV or 1, 0, 1)
		musicGroup.Volume = math.clamp(musicV or 1, 0, 1)
		sfxGroup.Volume = math.clamp(sfxV or 1, 0, 1)
	end
end

return Sound
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004D9D"><Properties><string name="Name">UI</string><ProtectedString name="Source">-- Криповый UI-кит: кнопки с мерцанием, окна, тосты, виньетка
local TweenService = game:GetService("TweenService")
local Sound = require(script.Parent.Sound)

local UI = {}

UI.Colors = {
	Bg = Color3.fromRGB(6, 5, 5),
	Panel = Color3.fromRGB(14, 11, 11),
	Panel2 = Color3.fromRGB(22, 16, 16),
	Red = Color3.fromRGB(150, 14, 14),
	BrightRed = Color3.fromRGB(235, 40, 40),
	Text = Color3.fromRGB(222, 212, 200),
	Dim = Color3.fromRGB(125, 115, 110),
	Gold = Color3.fromRGB(235, 185, 70),
	Green = Color3.fromRGB(110, 200, 110),
}

local function safeFont(name, fallback)
	local ok, f = pcall(function()
		return Enum.Font[name]
	end)
	if ok and f then
		return f
	end
	return fallback
end

-- шрифты с кириллицей
UI.FontTitle = safeFont("Oswald", Enum.Font.SourceSansBold)
UI.FontMono = safeFont("RobotoMono", Enum.Font.Code)
UI.FontText = safeFont("SourceSans", Enum.Font.SourceSans)
UI.FontBold = safeFont("SourceSansBold", Enum.Font.SourceSansBold)

function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(r)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 6) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Red,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function UI.tween(obj, time, props, style, dir)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function UI.label(props)
	local base = {
		BackgroundTransparency = 1,
		Font = UI.FontText,
		TextColor3 = UI.Colors.Text,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	return UI.new("TextLabel", base)
end

-- жуткая кнопка: мерцает при наведении, текст краснеет
function UI.button(props, onClick)
	local base = {
		AutoButtonColor = false,
		BackgroundColor3 = UI.Colors.Panel2,
		BackgroundTransparency = 0.15,
		Font = UI.FontTitle,
		TextColor3 = UI.Colors.Text,
		TextSize = 20,
		Text = "КНОПКА",
	}
	for k, v in pairs(props or {}) do
		if k ~= "NoStroke" then
			base[k] = v
		end
	end
	local btn = UI.new("TextButton", base)
	if not props or props.NoStroke ~= true then
		UI.stroke(UI.Colors.Red, 1, 0.4).Parent = btn
	end
	local normalColor = btn.TextColor3
	local hovering = false
	btn.MouseEnter:Connect(function()
		hovering = true
		Sound.play("UIHover", nil, { Volume = 0.5, PlaybackSpeed = 0.9 + math.random() * 0.2 })
		UI.tween(btn, 0.12, { TextColor3 = UI.Colors.BrightRed })
		task.spawn(function()
			for _ = 1, 6 do
				if not hovering then
					break
				end
				btn.TextTransparency = math.random() &lt; 0.5 and 0.6 or 0
				task.wait(0.03 + math.random() * 0.05)
			end
			btn.TextTransparency = 0
		end)
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		btn.TextTransparency = 0
		UI.tween(btn, 0.2, { TextColor3 = normalColor })
	end)
	btn.Activated:Connect(function()
		Sound.play("UIClick", nil, { Volume = 0.7 })
		if onClick then
			onClick()
		end
	end)
	return btn
end

-- чёрная виньетка по краям экрана
function UI.vignette(parent, strength)
	strength = strength or 0
	local holder = UI.new("Frame", {
		Name = "Vignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = parent,
	})
	local function edge(rot, size, pos, anchor)
		local f = UI.new("Frame", {
			Size = size,
			Position = pos,
			AnchorPoint = anchor,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			BackgroundTransparency = strength,
			ZIndex = 1,
			Parent = holder,
		})
		UI.new("UIGradient", {
			Rotation = rot,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = f,
		})
		return f
	end
	edge(0, UDim2.fromScale(0.28, 1), UDim2.fromScale(0, 0), Vector2.new(0, 0))
	edge(180, UDim2.fromScale(0.28, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0))
	edge(90, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0), Vector2.new(0, 0))
	edge(-90, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 1), Vector2.new(0, 1))
	return holder
end

-- окно-панель с заголовком и крестиком
function UI.window(parent, titleText, size)
	local win = UI.new("Frame", {
		Name = "Window",
		Size = size or UDim2.fromOffset(760, 480),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	}, {
		UI.corner(4),
		UI.stroke(UI.Colors.Red, 2, 0.2),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(980, 640) }),
	})
	UI.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(30, 14, 14), Color3.fromRGB(8, 6, 6)),
		Parent = win,
	})
	local title = UI.label({
		Name = "Title",
		Text = titleText,
		Font = UI.FontTitle,
		TextSize = 30,
		TextColor3 = UI.Colors.BrightRed,
		Size = UDim2.new(1, -80, 0, 44),
		Position = UDim2.fromOffset(18, 6),
		ZIndex = 21,
		Parent = win,
	})
	local line = UI.new("Frame", {
		Size = UDim2.new(1, -36, 0, 1),
		Position = UDim2.fromOffset(18, 52),
		BackgroundColor3 = UI.Colors.Red,
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = win,
	})
	local close = UI.button({
		Text = "✕",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -50, 0, 8),
		TextSize = 22,
		ZIndex = 22,
		Parent = win,
	})
	local content = UI.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -36, 1, -72),
		Position = UDim2.fromOffset(18, 62),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = win,
	})
	local api = { frame = win, content = content, title = title, line = line, onClose = nil }
	function api.open()
		win.Visible = true
		win.Size = (size or UDim2.fromOffset(760, 480)) - UDim2.fromOffset(40, 30)
		UI.tween(win, 0.18, { Size = size or UDim2.fromOffset(760, 480) }, Enum.EasingStyle.Back)
		task.spawn(function()
			for _ = 1, 5 do
				title.TextTransparency = math.random() &lt; 0.5 and 0.7 or 0
				task.wait(0.05)
			end
			title.TextTransparency = 0
		end)
	end
	function api.close()
		win.Visible = false
		if api.onClose then
			api.onClose()
		end
	end
	close.Activated:Connect(api.close)
	return api
end

-- всплывающее уведомление
local toastHolders = {}
function UI.toast(screenGui, text, color)
	local holder = toastHolders[screenGui]
	if not holder or not holder.Parent then
		holder = UI.new("Frame", {
			Name = "Toasts",
			Size = UDim2.new(0, 420, 1, -40),
			Position = UDim2.new(1, -20, 0, 20),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			ZIndex = 50,
			Parent = screenGui,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 6),
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		toastHolders[screenGui] = holder
	end
	local t = UI.label({
		Text = text,
		Font = UI.FontMono,
		TextSize = 16,
		TextColor3 = color or UI.Colors.Text,
		BackgroundColor3 = Color3.fromRGB(10, 6, 6),
		BackgroundTransparency = 0.15,
		Size = UDim2.fromOffset(400, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 51,
		Parent = holder,
	}, nil)
	UI.padding(10).Parent = t
	UI.stroke(UI.Colors.Red, 1, 0.3).Parent = t
	task.delay(4, function()
		if t.Parent then
			UI.tween(t, 0.4, { TextTransparency = 1, BackgroundTransparency = 1 })
			task.wait(0.45)
			t:Destroy()
		end
	end)
	return t
end

-- глитч-заголовок: три слоя (белый + красный + голубой со сдвигом)
function UI.glitchTitle(parent, text, size, position, textSize)
	local holder = UI.new("Frame", {
		Size = size,
		Position = position,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = parent,
	})
	local function layer(color, z, tr)
		return UI.label({
			Text = text,
			Font = UI.FontTitle,
			TextSize = textSize,
			TextColor3 = color,
			TextTransparency = tr,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = false,
			ZIndex = z,
			Parent = holder,
		})
	end
	local cyan = layer(Color3.fromRGB(60, 220, 255), 5, 0.55)
	local red = layer(Color3.fromRGB(255, 20, 20), 6, 0.25)
	local main = layer(Color3.fromRGB(235, 225, 215), 7, 0)
	local alive = true
	task.spawn(function()
		while alive and holder.Parent do
			local glitch = math.random() &lt; 0.12
			if glitch then
				for _ = 1, math.random(3, 8) do
					red.Position = UDim2.fromOffset(math.random(-9, 9), math.random(-3, 3))
					cyan.Position = UDim2.fromOffset(math.random(-9, 9), math.random(-3, 3))
					main.Position = UDim2.fromOffset(math.random(-3, 3), 0)
					main.TextTransparency = math.random() &lt; 0.3 and 0.8 or 0
					task.wait(0.03)
				end
			end
			red.Position = UDim2.fromOffset(2, 1)
			cyan.Position = UDim2.fromOffset(-2, 0)
			main.Position = UDim2.fromOffset(0, 0)
			main.TextTransparency = 0
			task.wait(0.08 + math.random() * 0.25)
		end
	end)
	return holder, function()
		alive = false
	end
end

-- ползунок 0..1 (мышь + тач). onChange(value) вызывается при перетаскивании.
function UI.slider(props, value, onChange)
	local UserInputService = game:GetService("UserInputService")
	local holder = UI.new("Frame", {
		Size = props.Size or UDim2.fromOffset(240, 36),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 21,
		Parent = props.Parent,
	})
	local track = UI.new("Frame", {
		Size = UDim2.new(1, -60, 0, 6),
		Position = UDim2.new(0, 0, 0.5, -3),
		BackgroundColor3 = Color3.fromRGB(28, 14, 14),
		BorderSizePixel = 0,
		ZIndex = holder.ZIndex,
		Parent = holder,
	}, { UI.stroke(UI.Colors.Red, 1, 0.5) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(value, 1),
		BackgroundColor3 = props.Color or UI.Colors.Red,
		BorderSizePixel = 0,
		ZIndex = holder.ZIndex + 1,
		Parent = track,
	})
	local knob = UI.new("Frame", {
		Size = UDim2.fromOffset(14, 22),
		Position = UDim2.new(value, -7, 0.5, -11),
		BackgroundColor3 = UI.Colors.Text,
		BorderSizePixel = 0,
		ZIndex = holder.ZIndex + 2,
		Parent = track,
	}, { UI.corner(2) })
	local valueLabel = UI.label({
		Text = math.floor(value * 100 + 0.5) .. "%",
		Font = UI.FontMono,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(52, 36),
		Position = UDim2.new(1, -52, 0, 0),
		ZIndex = holder.ZIndex + 1,
		Parent = holder,
	})
	local hit = UI.new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		ZIndex = holder.ZIndex + 3,
		Parent = track,
	})
	local dragging = false
	local api = { frame = holder, value = value }
	local function setFromX(x)
		local v = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		v = math.floor(v * 100 + 0.5) / 100
		api.value = v
		fill.Size = UDim2.fromScale(v, 1)
		knob.Position = UDim2.new(v, -7, 0.5, -11)
		valueLabel.Text = math.floor(v * 100 + 0.5) .. "%"
		if onChange then
			onChange(v)
		end
	end
	function api.set(v)
		v = math.clamp(v or 0, 0, 1)
		api.value = v
		fill.Size = UDim2.fromScale(v, 1)
		knob.Position = UDim2.new(v, -7, 0.5, -11)
		valueLabel.Text = math.floor(v * 100 + 0.5) .. "%"
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				Sound.play("UIClick", nil, { Volume = 0.4 })
			end
		end
	end)
	return api
end

-- ряд вкладок. tabs = { {id=, text=}, ... }; onSelect(id)
function UI.tabs(parent, tabs, selectedId, onSelect, props)
	props = props or {}
	local row = UI.new("Frame", {
		Size = props.Size or UDim2.new(1, 0, 0, 40),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 21,
		Parent = parent,
	}, { UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local buttons = {}
	local api = { frame = row, selected = selectedId }
	local function paint()
		for id, b in pairs(buttons) do
			local on = id == api.selected
			b.BackgroundColor3 = on and Color3.fromRGB(120, 18, 18) or UI.Colors.Panel2
			b.TextColor3 = on and UI.Colors.Text or UI.Colors.Dim
		end
	end
	for i, t in ipairs(tabs) do
		buttons[t.id] = UI.button({
			Text = t.text,
			TextSize = props.TextSize or 17,
			Size = UDim2.fromOffset(props.Width or 150, props.Height or 38),
			LayoutOrder = i,
			ZIndex = row.ZIndex + 1,
			Parent = row,
		}, function()
			api.selected = t.id
			paint()
			if onSelect then
				onSelect(t.id)
			end
		end)
	end
	function api.select(id)
		api.selected = id
		paint()
	end
	paint()
	return api
end

-- выбор одного варианта из списка (сложность, число игроков)
function UI.choice(parent, options, selectedId, onSelect, props)
	props = props or {}
	local row = UI.new("Frame", {
		Size = props.Size or UDim2.new(1, 0, 0, 44),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 21,
		Parent = parent,
	}, { UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local buttons = {}
	local api = { frame = row, selected = selectedId }
	local function paint()
		for id, b in pairs(buttons) do
			local on = id == api.selected
			local opt = b:GetAttribute("Color")
			b.BackgroundColor3 = on and (opt or Color3.fromRGB(120, 18, 18)) or UI.Colors.Panel2
			b.BackgroundTransparency = on and 0.35 or 0.15
			b.TextColor3 = on and Color3.new(1, 1, 1) or UI.Colors.Dim
		end
	end
	for i, o in ipairs(options) do
		local b = UI.button({
			Text = o.text,
			TextSize = props.TextSize or 16,
			Size = UDim2.fromOffset(props.Width or 110, props.Height or 40),
			LayoutOrder = i,
			ZIndex = row.ZIndex + 1,
			Parent = row,
		}, function()
			api.selected = o.id
			paint()
			if onSelect then
				onSelect(o.id)
			end
		end)
		if o.color then
			b:SetAttribute("Color", o.color)
		end
		buttons[o.id] = b
	end
	function api.select(id)
		api.selected = id
		paint()
	end
	paint()
	return api
end

return UI
</ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00004D9E"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00004D9F"><Properties><string name="Name">Core</string></Properties><Item class="ModuleScript" referent="RBX00004DA0"><Properties><string name="Name">BattlePassService</string><ProtectedString name="Source">-- Серверная логика батлпасса: опыт и выдача наград
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local Config = require(ReplicatedStorage.Shared.Config)
local BattlePass = require(ReplicatedStorage.Shared.BattlePass)

local BPService = {}

function BPService.addXP(player, amount)
	local data = DataService.get(player)
	if not data or amount &lt;= 0 then
		return
	end
	local before = BattlePass.tierFromXP(data.xp)
	data.xp += math.floor(amount)
	local after = BattlePass.tierFromXP(data.xp)
	if after &gt; before then
		Remotes.notify(player, "БАТЛПАСС: уровень " .. after .. "! Забери награду в лобби.", Color3.fromRGB(235, 40, 40))
	end
end

local function grantReward(player, data, reward)
	if reward.type == "coins" then
		data.coins += reward.amount
	elseif reward.type == "revive" then
		data.revives += reward.amount
	elseif reward.type == "flashlight" then
		data.flashlights[reward.id] = true
	elseif reward.type == "title" then
		data.titles[reward.id] = true
	end
end

function BPService.claim(player, tier, track)
	local data = DataService.get(player)
	if not data then
		return false, "Данные ещё загружаются"
	end
	tier = tonumber(tier)
	if not tier or tier &lt; 1 or tier &gt; BattlePass.MaxTier or tier ~= math.floor(tier) then
		return false, "Неверный уровень"
	end
	if track ~= "free" and track ~= "premium" then
		return false, "?"
	end
	if BattlePass.tierFromXP(data.xp) &lt; tier then
		return false, "Уровень ещё не открыт"
	end
	if track == "premium" and not ShopService.hasPass(player, "PremiumPass") then
		return false, "Нужен ПРЕМИУМ БАТЛПАСС"
	end
	local k = tostring(tier)
	if data.bpClaimed[track][k] then
		return false, "Уже получено"
	end
	local reward = BattlePass.Tiers[tier][track]
	if not reward then
		return false, "Нет награды"
	end
	data.bpClaimed[track][k] = true
	grantReward(player, data, reward)
	ShopService.applyCosmetics(player)
	DataService.push(player)
	return true, "Получено: " .. BattlePass.describe(reward)
end

function BPService.start()
	Remotes.ClaimReward.OnServerInvoke = function(player, tier, track)
		return BPService.claim(player, tier, track)
	end
end

local _ = Config
return BPService
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA1"><Properties><string name="Name">DataService</string><ProtectedString name="Source">--[[
	Сохранение прогресса (DataStore). Общий для лобби и игрового плейса
	(оба плейса должны быть в одном Experience).
	Защита от гонки при телепорте: в TeleportData передаём savedAt, и
	принимающий сервер ждёт, пока в DataStore появится версия не старше.
]]
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Remotes = require(script.Parent.Remotes)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local BattlePass = require(Shared.BattlePass)

local DataService = {}
DataService.passChecker = nil -- function(player) -&gt; table of pass flags (ставит ShopService)

local STORE_NAME = "Palata13_PlayerData_v1"
local store = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)
if not storeOk then
	store = nil
end

local profiles = {}
local loadedEvent = Instance.new("BindableEvent")
DataService.Loaded = loadedEvent.Event

local function defaults()
	return {
		version = 1,
		coins = 100,
		xp = 0,
		bpClaimed = { free = {}, premium = {} },
		flashlights = { Standard = true },
		flashlight = "Standard",
		titles = { Newbie = true },
		title = "Newbie",
		revives = 0,
		perks = {},
		stats = { escapes = 0, deaths = 0, games = 0, generators = 0, nightmareEscapes = 0, mapsEscaped = {} },
		receipts = {},
		receiptOrder = {},
		savedAt = 0,
		settings = { master = 1, music = 0.6, sfx = 1, sensitivity = 1, grain = true, flicker = true, crouchToggle = true },
	}
end

local function merge(data, def)
	for k, v in pairs(def) do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			merge(data[k], v)
		end
	end
	return data
end

local function key(player)
	return "u_" .. player.UserId
end

local function setupLeaderstats(player, data)
	local ls = player:FindFirstChild("leaderstats") or Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = ls:FindFirstChild("Монеты") or Instance.new("IntValue")
	coins.Name = "Монеты"
	coins.Value = data.coins
	coins.Parent = ls
	local tier = ls:FindFirstChild("Уровень") or Instance.new("IntValue")
	tier.Name = "Уровень"
	tier.Value = BattlePass.tierFromXP(data.xp)
	tier.Parent = ls
	ls.Parent = player
end

local function snapshot(player, data)
	-- то, что уходит клиенту
	local passes = DataService.passChecker and DataService.passChecker(player) or {}
	return {
		coins = data.coins,
		xp = data.xp,
		tier = BattlePass.tierFromXP(data.xp),
		bpClaimed = data.bpClaimed,
		flashlights = data.flashlights,
		flashlight = data.flashlight,
		titles = data.titles,
		title = data.title,
		revives = data.revives,
		perks = data.perks,
		stats = data.stats,
		passes = passes,
		settings = data.settings,
	}
end

-- настройки клиента (громкость и т.п.) — проверяем типы и диапазоны
local SETTING_RANGES = { master = { 0, 1 }, music = { 0, 1 }, sfx = { 0, 1 }, sensitivity = { 0.2, 3 } }
local SETTING_BOOLS = { grain = true, flicker = true, crouchToggle = true }
function DataService.applySettings(player, tbl)
	local data = profiles[player]
	if not data or type(tbl) ~= "table" then
		return false
	end
	for k, range in pairs(SETTING_RANGES) do
		local v = tbl[k]
		if type(v) == "number" and v == v then
			data.settings[k] = math.clamp(v, range[1], range[2])
		end
	end
	for k in pairs(SETTING_BOOLS) do
		if type(tbl[k]) == "boolean" then
			data.settings[k] = tbl[k]
		end
	end
	return true
end

function DataService.push(player)
	local data = profiles[player]
	if not data then
		return
	end
	setupLeaderstats(player, data)
	Remotes.DataUpdated:FireClient(player, snapshot(player, data))
end

function DataService.get(player)
	return profiles[player]
end

function DataService.waitFor(player, timeout)
	local t0 = os.clock()
	while not profiles[player] and player.Parent and os.clock() - t0 &lt; (timeout or 30) do
		task.wait(0.2)
	end
	return profiles[player]
end

function DataService.update(player, fn)
	local data = profiles[player]
	if not data then
		return false
	end
	fn(data)
	DataService.push(player)
	return true
end

function DataService.saveAsync(player)
	local data = profiles[player]
	if not data then
		return false, 0
	end
	data.savedAt = os.time() + os.clock() % 1
	if not store then
		return true, data.savedAt
	end
	local ok, err
	for attempt = 1, 3 do
		ok, err = pcall(function()
			store:SetAsync(key(player), data, { player.UserId })
		end)
		if ok then
			break
		end
		task.wait(attempt)
	end
	if not ok then
		warn("[Палата13] Не удалось сохранить", player.Name, err)
	end
	return ok, data.savedAt
end

local function loadPlayer(player)
	local expectedSavedAt = 0
	pcall(function()
		local join = player:GetJoinData()
		local td = join and join.TeleportData
		if type(td) == "table" then
			if type(td.savedAt) == "number" then
				expectedSavedAt = td.savedAt
			elseif type(td.savedAt) == "table" then
				expectedSavedAt = tonumber(td.savedAt[tostring(player.UserId)]) or 0
			end
		end
	end)

	local data = nil
	if store then
		for attempt = 1, 8 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				if type(result) == "table" and (result.savedAt or 0) + 0.001 &lt; expectedSavedAt and attempt &lt; 8 then
					-- предыдущий сервер ещё не дописал данные — подождём
					task.wait(1.5)
				else
					data = result
					break
				end
			else
				warn("[Палата13] Ошибка загрузки", result)
				if RunService:IsStudio() then
					warn("[Палата13] В Studio включи: Game Settings → Security → Enable Studio Access to API Services")
					break
				end
				task.wait(attempt)
			end
		end
	end
	if not player.Parent then
		return
	end
	if type(data) ~= "table" then
		data = defaults()
	else
		data = merge(data, defaults())
	end
	profiles[player] = data
	setupLeaderstats(player, data)
	loadedEvent:Fire(player, data)
	DataService.push(player)
end

-- квитанции покупок (защита от двойного начисления)
function DataService.hasReceipt(data, purchaseId)
	return data.receipts[purchaseId] == true
end

function DataService.addReceipt(data, purchaseId)
	data.receipts[purchaseId] = true
	table.insert(data.receiptOrder, purchaseId)
	while #data.receiptOrder &gt; 50 do
		local old = table.remove(data.receiptOrder, 1)
		data.receipts[old] = nil
	end
end

function DataService.start()
	Remotes.GetData.OnServerInvoke = function(player)
		local data = DataService.waitFor(player, 20)
		if not data then
			return nil
		end
		return snapshot(player, data)
	end
	Remotes.Settings.OnServerEvent:Connect(function(player, tbl)
		DataService.applySettings(player, tbl)
	end)

	Players.PlayerAdded:Connect(loadPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(loadPlayer, p)
	end

	Players.PlayerRemoving:Connect(function(player)
		if profiles[player] then
			if not player:GetAttribute("AlreadySaved") then
				DataService.saveAsync(player)
			end
			profiles[player] = nil
		end
	end)

	task.spawn(function()
		while true do
			task.wait(120)
			for _, p in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.saveAsync, p)
			end
		end
	end)

	game:BindToClose(function()
		local threads = 0
		for _, p in ipairs(Players:GetPlayers()) do
			threads += 1
			task.spawn(function()
				DataService.saveAsync(p)
				threads -= 1
			end)
		end
		local t0 = os.clock()
		while threads &gt; 0 and os.clock() - t0 &lt; 25 do
			task.wait(0.1)
		end
	end)
end

local _ = HttpService
return DataService
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA2"><Properties><string name="Name">FlashlightService</string><ProtectedString name="Source">--[[
	Серверная часть фонарика: вкл/выкл, батарея, звук щелчка (3D — слышат другие),
	луч "ServerBeam" на голове — его видят другие игроки (и монстр замечает свет).
	У самого игрока он скрыт — ему светит красивый локальный фонарь.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(script.Parent.Remotes)
local Config = require(ReplicatedStorage.Shared.Config)
local Sound = require(ReplicatedStorage.Shared.Sound)

local FS = {}
FS.infinite = false -- в лобби батарея бесконечная
FS.actionHandlers = {} -- доп. обработчики Action (name -&gt; fn(player, ...))

-- шина шума: любой громкий поступок игрока (щелчок фонарика, дверца шкафа, генератор)
-- fn(player, position, kind) — kind совпадает с ключами Difficulty.hear
local noiseEvent = Instance.new("BindableEvent")
FS.Noise = noiseEvent.Event
function FS.emitNoise(player, position, kind)
	noiseEvent:Fire(player, position, kind)
end

local function beamOf(player)
	local char = player.Character
	return char and char:FindFirstChild("ServerBeam")
end

function FS.setOn(player, on)
	if on and (player:GetAttribute("Battery") or 0) &lt;= 0 then
		on = false
	end
	if player:GetAttribute("FlashlightOn") == on then
		return
	end
	player:SetAttribute("FlashlightOn", on)
	local beam = beamOf(player)
	if beam then
		for _, l in ipairs(beam:GetChildren()) do
			if l:IsA("Light") then
				l.Enabled = on
			end
		end
		Sound.play(on and "FlashlightOn" or "FlashlightOff", beam, { Volume = 0.8, RollOffMaxDistance = 40 })
		FS.emitNoise(player, beam.Position, "flashlight")
	end
end

-- ПРИСЯДКА: поза через Motor6D.C0 (видно другим игрокам), скорость ставит клиент
local CROUCH_POSE = {
	Root = { CFrame.new(0, -0.6, 0) * CFrame.Angles(0.1, 0, 0) },
	Waist = { CFrame.Angles(0.35, 0, 0) },
	LeftHip = { CFrame.Angles(0.95, 0, 0) },
	RightHip = { CFrame.Angles(0.95, 0, 0) },
	LeftKnee = { CFrame.Angles(-1.35, 0, 0) },
	RightKnee = { CFrame.Angles(-1.35, 0, 0) },
	LeftAnkle = { CFrame.Angles(0.4, 0, 0) },
	RightAnkle = { CFrame.Angles(0.4, 0, 0) },
	RootJoint = { CFrame.new(0, -0.7, 0) * CFrame.Angles(0.25, 0, 0) }, -- R6
}
local baseC0 = {} -- [motor] = C0 до присядки

function FS.setCrouch(player, on)
	on = on == true
	if player:GetAttribute("Crouching") == on then
		return
	end
	player:SetAttribute("Crouching", on)
	local char = player.Character
	if not char then
		return
	end
	for _, m in ipairs(char:GetDescendants()) do
		if m:IsA("Motor6D") and CROUCH_POSE[m.Name] then
			if baseC0[m] == nil then
				baseC0[m] = m.C0
			end
			m.C0 = on and (baseC0[m] * CROUCH_POSE[m.Name][1]) or baseC0[m]
		end
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		Sound.play("Cloth", hrp, { Volume = 0.5, RollOffMaxDistance = 25 })
	end
end

function FS.addBattery(player, amount)
	local b = player:GetAttribute("Battery") or 0
	player:SetAttribute("Battery", math.clamp(b + amount, 0, 100))
end

local function makeBeam(player, char)
	local head = char:WaitForChild("Head", 10)
	if not head then
		return
	end
	local old = char:FindFirstChild("ServerBeam")
	if old then
		old:Destroy()
	end
	local p = Instance.new("Part")
	p.Name = "ServerBeam"
	p.Size = Vector3.new(0.3, 0.3, 0.6)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	local w = Instance.new("Weld")
	w.Name = "AimWeld"
	w.Part0 = head
	w.Part1 = p
	w.C0 = CFrame.new(0.4, 0, -0.6)
	w.Parent = p
	local s = Instance.new("SpotLight")
	s.Face = Enum.NormalId.Front
	s.Angle = 45
	s.Range = 55
	s.Brightness = 2.5
	s.Shadows = true
	s.Enabled = player:GetAttribute("FlashlightOn") == true
	local color = player:GetAttribute("FlashColor")
	if typeof(color) == "Color3" then
		s.Color = color
	end
	s.Parent = p
	p.Parent = char
	player:GetAttributeChangedSignal("FlashColor"):Connect(function()
		local c = player:GetAttribute("FlashColor")
		if typeof(c) == "Color3" and s.Parent then
			s.Color = c
		end
	end)
end

function FS.start(infinite)
	FS.infinite = infinite == true
	local function onPlayer(player)
		player:SetAttribute("Battery", 100)
		player:SetAttribute("FlashlightOn", false)
		player:SetAttribute("Crouching", false)
		player.CharacterAdded:Connect(function(char)
			player:SetAttribute("Crouching", false)
			for m in pairs(baseC0) do
				if not m:IsDescendantOf(game) then
					baseC0[m] = nil
				end
			end
			makeBeam(player, char)
		end)
		if player.Character then
			task.spawn(makeBeam, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end

	Remotes.Action.OnServerEvent:Connect(function(player, name, ...)
		if name == "flashlight" then
			FS.setOn(player, not player:GetAttribute("FlashlightOn"))
		elseif name == "aim" then
			local pitch = ...
			if type(pitch) == "number" and pitch == pitch then
				pitch = math.clamp(pitch, -1.3, 1.3)
				local beam = beamOf(player)
				local weld = beam and beam:FindFirstChild("AimWeld")
				if weld then
					weld.C0 = CFrame.new(0.4, 0, -0.6) * CFrame.Angles(pitch, 0, 0)
				end
			end
		elseif name == "sprint" then
			local on = ...
			player:SetAttribute("Sprinting", on == true)
			if on then
				FS.setCrouch(player, false)
			end
		elseif name == "crouch" then
			local on = ...
			FS.setCrouch(player, on == true)
		else
			local h = FS.actionHandlers[name]
			if h then
				h(player, ...)
			end
		end
	end)

	task.spawn(function()
		local dt = 0.25
		while true do
			task.wait(dt)
			if not FS.infinite then
				for _, player in ipairs(Players:GetPlayers()) do
					if player:GetAttribute("FlashlightOn") then
						local drain = Config.Player.BatteryDrainPerSec * dt
						if player:GetAttribute("BigBattery") then
							drain *= 0.5
						end
						local b = (player:GetAttribute("Battery") or 0) - drain
						if b &lt;= 0 then
							b = 0
							player:SetAttribute("Battery", 0)
							FS.setOn(player, false)
							Remotes.notify(player, "Батарея села. Темнота смотрит на тебя.", Color3.fromRGB(235, 40, 40))
						else
							player:SetAttribute("Battery", b)
						end
					end
				end
			end
		end
	end)
end

return FS
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA3"><Properties><string name="Name">Remotes</string><ProtectedString name="Source">-- Создаёт все RemoteEvent / RemoteFunction в ReplicatedStorage.Remotes
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local events = { "DataUpdated", "Notify", "Action", "Jumpscare", "RoundUpdate", "Teleporting", "Power", "Results", "Scare", "Settings", "Sonar", "Repair" }
local functions = { "GetData", "ShopRequest", "ClaimReward", "UseRevive", "Gate" }

for _, name in ipairs(events) do
	local e = folder:FindFirstChild(name)
	if not e then
		e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
	end
	Remotes[name] = e
end
for _, name in ipairs(functions) do
	local f = folder:FindFirstChild(name)
	if not f then
		f = Instance.new("RemoteFunction")
		f.Name = name
		f.Parent = folder
	end
	Remotes[name] = f
end

function Remotes.notify(player, text, color)
	Remotes.Notify:FireClient(player, text, color)
end

function Remotes.notifyAll(text, color)
	Remotes.Notify:FireAllClients(text, color)
end

return Remotes
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA4"><Properties><string name="Name">ShopService</string><ProtectedString name="Source">--[[
	Магазин: Game Pass'ы, Developer Products (за Робуксы), покупка фонариков за монеты,
	экипировка фонариков и титулов.
	ProcessReceipt слушается в обоих плейсах (в раунде можно купить возрождение).
]]
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local Config = require(ReplicatedStorage.Shared.Config)
local BattlePass = require(ReplicatedStorage.Shared.BattlePass)

local ShopService = {}
ShopService.onRevivePurchased = nil -- function(player) -&gt; true, если возродили в раунде
ShopService.isLobby = false

local passCache = {} -- [player][key] = bool

function ShopService.hasPass(player, key)
	local id = Config.GamePasses[key]
	if not id or id == 0 then
		return false
	end
	passCache[player] = passCache[player] or {}
	local cached = passCache[player][key]
	if cached ~= nil then
		return cached
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
	end)
	local value = ok and owns == true
	if ok then
		passCache[player][key] = value
	end
	return value
end

local function passFlags(player)
	local flags = {}
	for key in pairs(Config.GamePasses) do
		flags[key] = ShopService.hasPass(player, key)
	end
	return flags
end
DataService.passChecker = passFlags

-- цвет фонарика + титул в атрибутах и над головой
function ShopService.applyCosmetics(player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local fl = Config.getFlashlight(data.flashlight)
	player:SetAttribute("FlashColor", fl.color)
	player:SetAttribute("FlashlightId", fl.id)
	local titleId = data.title
	if ShopService.hasPass(player, "VIP") then
		data.titles.VIP = true
	end
	local t = Config.getTitle(titleId) or Config.getTitle("Newbie")
	player:SetAttribute("Title", t.name)
	player:SetAttribute("BigBattery", ShopService.hasPass(player, "BigBattery"))
	player:SetAttribute("VIP", ShopService.hasPass(player, "VIP"))

	-- перки -&gt; атрибуты (их читают сервер раунда, ИИ и клиент)
	local perks = data.perks or {}
	for _, perk in ipairs(Config.Perks) do
		if perk.stat then
			player:SetAttribute("Perk_" .. perk.stat, perks[perk.id] and perk.value or nil)
		end
	end

	local char = player.Character
	if ShopService.isLobby and Config.ShowTitlesAboveHead and char then
		local head = char:FindFirstChild("Head")
		if head then
			local bb = head:FindFirstChild("TitleTag")
			if not bb then
				bb = Instance.new("BillboardGui")
				bb.Name = "TitleTag"
				bb.Size = UDim2.fromOffset(220, 26)
				bb.StudsOffset = Vector3.new(0, 2.6, 0)
				bb.MaxDistance = 60
				bb.AlwaysOnTop = false
				local l = Instance.new("TextLabel")
				l.Name = "L"
				l.Size = UDim2.fromScale(1, 1)
				l.BackgroundTransparency = 1
				l.Font = Enum.Font.SourceSansBold
				l.TextSize = 18
				l.TextStrokeTransparency = 0.4
				l.Parent = bb
				bb.Parent = head
			end
			bb.L.Text = "« " .. t.name .. " »"
			bb.L.TextColor3 = t.color
		end
	end
end

local function grantProduct(player, key)
	local reward = Config.ProductRewards[key]
	if not reward then
		return false
	end
	local data = DataService.get(player)
	if not data then
		return false
	end
	if reward.coins then
		data.coins += reward.coins
		Remotes.notify(player, "+" .. reward.coins .. " монет. Спасибо за покупку!", Color3.fromRGB(235, 185, 70))
	end
	if reward.tiers then
		local tier = BattlePass.tierFromXP(data.xp)
		if tier &lt; BattlePass.MaxTier then
			data.xp = (tier + 1) * BattlePass.XPPerTier
		else
			data.coins += 300 -- батлпасс уже закрыт — компенсация
		end
		Remotes.notify(player, "Уровень батлпасса повышен!", Color3.fromRGB(235, 40, 40))
	end
	if reward.revive then
		local used = false
		if ShopService.onRevivePurchased then
			used = ShopService.onRevivePurchased(player) == true
		end
		if not used then
			data.revives += reward.revive
			Remotes.notify(player, "+1 жетон возрождения", Color3.fromRGB(110, 200, 110))
		end
	end
	return true
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.waitFor(player, 15)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if DataService.hasReceipt(data, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = Config.productKeyById(info.ProductId)
	if not key then
		warn("[Палата13] Неизвестный продукт", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not grantProduct(player, key) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	DataService.addReceipt(data, info.PurchaseId)
	local ok = DataService.saveAsync(player)
	DataService.push(player)
	if not ok then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function handleShopRequest(player, action, arg)
	local data = DataService.get(player)
	if not data then
		return false, "Данные ещё загружаются"
	end
	if action == "buyFlashlight" then
		local fl = nil
		for _, f in ipairs(Config.Flashlights) do
			if f.id == arg then
				fl = f
			end
		end
		if not fl then
			return false, "Нет такого фонарика"
		end
		if fl.source == "bp" then
			return false, "Только из батлпасса"
		end
		if data.flashlights[fl.id] then
			return false, "Уже куплено"
		end
		if data.coins &lt; fl.price then
			return false, "Не хватает монет"
		end
		data.coins -= fl.price
		data.flashlights[fl.id] = true
		data.flashlight = fl.id
		ShopService.applyCosmetics(player)
		DataService.push(player)
		return true, "Куплено: " .. fl.name
	elseif action == "equipFlashlight" then
		if not data.flashlights[arg] then
			return false, "Не куплено"
		end
		data.flashlight = arg
		ShopService.applyCosmetics(player)
		DataService.push(player)
		return true, "Экипировано"
	elseif action == "equipTitle" then
		if arg == "VIP" and ShopService.hasPass(player, "VIP") then
			data.titles.VIP = true
		end
		if not data.titles[arg] then
			return false, "Титул не получен"
		end
		data.title = arg
		ShopService.applyCosmetics(player)
		DataService.push(player)
		return true, "Титул установлен"
	elseif action == "buyPerk" then
		local perk = Config.getPerk(arg)
		if not perk then
			return false, "Нет такого товара"
		end
		if not perk.consumable and data.perks[perk.id] then
			return false, "Уже куплено"
		end
		if data.coins &lt; perk.price then
			return false, "Не хватает монет"
		end
		data.coins -= perk.price
		if perk.consumable then
			data.revives += 1
		else
			data.perks[perk.id] = true
		end
		ShopService.applyCosmetics(player)
		DataService.push(player)
		return true, "Куплено: " .. perk.name
	end
	return false, "?"
end

function ShopService.start(isLobby)
	ShopService.isLobby = isLobby == true
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = Config.passKeyById(passId)
		if key then
			passCache[player] = passCache[player] or {}
			passCache[player][key] = true
			local data = DataService.get(player)
			if key == "VIP" and data then
				data.titles.VIP = true
			end
			Remotes.notify(player, "Пропуск активирован. Оно теперь знает твоё имя.", Color3.fromRGB(235, 185, 70))
			ShopService.applyCosmetics(player)
			DataService.push(player)
		end
	end)

	Remotes.ShopRequest.OnServerInvoke = function(player, action, arg)
		if type(action) ~= "string" then
			return false, "?"
		end
		return handleShopRequest(player, action, arg)
	end

	DataService.Loaded:Connect(function(player)
		ShopService.applyCosmetics(player)
	end)

	local function onPlayer(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			ShopService.applyCosmetics(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		passCache[p] = nil
	end)
end

return ShopService
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00004DA8"><Properties><string name="Name">MonsterAI</string><ProtectedString name="Source">--[[
	ИИ Пациента 13.
	Состояния: Sleep -&gt; Patrol -&gt; Investigate (услышал) -&gt; Chase (засёк) -&gt; Search (потерял) -&gt; Attack
	Восприятие зависит от сложности (Config.Difficulties):
	  - blind = true  : не видит вообще. Слышит шаги (радиус зависит от присядки/шага/бега),
	                    щелчок фонарика, шкафчики и генераторы (события шума). Чувствует вплотную (sense).
	  - blind = false : видит (дальше, если у игрока включён фонарик) И слышит.
	  - sonar &gt; 0     : каждые N секунд эхо-крик — выдаёт всех, кто в этот момент двигается.
	- игроки в шкафчиках невидимы, если монстр не видел/не слышал, как они туда залезли
	- с каждым генератором быстрее, после включения света — в ярости
]]
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Sound = require(ReplicatedStorage.Shared.Sound)
local Remotes = require(ServerScriptService.Core.Remotes)

local C = Config.Monster

local AI = {}
AI.__index = AI

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function AI.new(model, map, opts)
	local self = setmetatable({}, AI)
	self.model = model
	self.hum = model:FindFirstChildOfClass("Humanoid")
	self.root = model:FindFirstChild("HumanoidRootPart")
	self.head = model:FindFirstChild("Head") or self.root
	self.map = map
	self.opts = opts or {}
	self.diff = self.opts.difficulty or Config.getDifficulty("Medium")
	self.state = "Sleep"
	self.target = nil
	self.lastSeen = 0
	self.lastSeenPos = nil
	self.investigatePos = nil
	self.investigatePriority = 0
	self.searchUntil = 0
	self.enraged = false
	self.generators = 0
	self.alive = true
	self.exposed = {}
	self.cooldownUntil = 0
	self.lastScream = 0
	self.lastSonar = os.clock()
	self.lastSniff = 0
	self.patrolGoal = nil
	self.waypoints = nil
	self.wpIndex = 1
	self.pathDest = nil
	self.pathTime = 0
	self.lastPos = self.root.Position
	self.lastStuckCheck = os.clock()
	self.stuckCount = 0

	self.nodes = {}
	local nodesFolder = map:FindFirstChild("AINodes")
	if nodesFolder then
		for _, n in ipairs(nodesFolder:GetChildren()) do
			if n:IsA("BasePart") then
				table.insert(self.nodes, n.Position)
			end
		end
	end

	self.path = PathfindingService:CreatePath({
		AgentRadius = 2.6,
		AgentHeight = 10,
		AgentCanJump = false,
		WaypointSpacing = 6,
	})

	self.ray = RaycastParams.new()
	self.ray.FilterType = Enum.RaycastFilterType.Exclude
	self.ray.RespectCanCollide = true

	self.hum.WalkSpeed = 0
	self.hum.AutoRotate = true
	model:SetAttribute("State", "Sleep")
	model:SetAttribute("Blind", self.diff.blind == true)
	model:SetAttribute("Difficulty", self.diff.id)

	-- дыхание (3D, слышно из-за угла)
	self.breath = Sound.make("MonsterBreath", self.head, {
		Looped = true,
		Volume = 0.6,
		RollOffMinDistance = 6,
		RollOffMaxDistance = 70,
	})
	if self.breath then
		self.breath:Play()
	end

	-- шум от действий игроков (фонарик, шкафчики, генераторы)
	if self.opts.noiseSignal then
		self.noiseConn = self.opts.noiseSignal:Connect(function(player, position, kind)
			self:onNoise(player, position, kind)
		end)
	end
	return self
end

function AI:setState(s)
	if self.state == s then
		return
	end
	self.state = s
	self.model:SetAttribute("State", s)
	if self.breath then
		self.breath.PlaybackSpeed = (s == "Chase") and 1.35 or 1
		self.breath.Volume = (s == "Chase") and 1 or 0.6
	end
end

function AI:refreshFilter()
	local list = { self.model }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local lf = workspace:FindFirstChild("LocalFlashlight")
	if lf then
		table.insert(list, lf)
	end
	local pickups = workspace:FindFirstChild("Pickups")
	if pickups then
		table.insert(list, pickups)
	end
	self.ray.FilterDescendantsInstances = list
end

function AI:isCandidate(player)
	if self.opts.isAlive and not self.opts.isAlive(player) then
		return false
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health &lt;= 0 then
		return false
	end
	return true, hrp
end

function AI:eye()
	return self.head.Position
end

function AI:lineClear(fromPos, toPos)
	local dir = toPos - fromPos
	if dir.Magnitude &lt; 0.1 then
		return true
	end
	local hit = workspace:Raycast(fromPos, dir, self.ray)
	return hit == nil
end

-- радиус, на котором слышно шаги игрока прямо сейчас (0 = стоит на месте и молчит)
function AI:noiseRadius(player, hrp)
	local hear = self.diff.hear
	local vel = flat(hrp.AssemblyLinearVelocity).Magnitude
	local r
	if player:GetAttribute("Sprinting") and vel &gt; 4 then
		r = hear.sprint
	elseif player:GetAttribute("Crouching") then
		r = (vel &gt; 1) and hear.crouch or 0
	elseif vel &gt; 1 then
		r = hear.walk
	else
		r = 0
	end
	local perk = player:GetAttribute("Perk_noise")
	if type(perk) == "number" then
		r *= perk
	end
	if self.enraged then
		r *= 1.25
	end
	return r
end

function AI:canSee(player)
	if self.diff.blind then
		return false
	end
	local ok, hrp = self:isCandidate(player)
	if not ok then
		return false
	end
	if player:GetAttribute("Hiding") and not self.exposed[player] then
		return false
	end
	local eye = self:eye()
	local targetPos = hrp.Position + Vector3.new(0, 1.2, 0)
	local toT = targetPos - eye
	local dist = toT.Magnitude
	local range = player:GetAttribute("FlashlightOn") and self.diff.flashlightSight or self.diff.sight
	if self.enraged then
		range += 30
	end
	if player:GetAttribute("Crouching") then
		range *= 0.75 -- в присяде тебя сложнее заметить за мебелью
	end
	if dist &gt; range then
		return false
	end
	if dist &gt; 14 then
		local look = flat(self.root.CFrame.LookVector)
		local d = flat(toT)
		if look.Magnitude &gt; 0 and d.Magnitude &gt; 0 then
			local ang = math.deg(math.acos(math.clamp(look.Unit:Dot(d.Unit), -1, 1)))
			if ang &gt; self.diff.fov / 2 then
				return false
			end
		end
	end
	if player:GetAttribute("Hiding") then
		return true -- видел, как залез в шкаф
	end
	return self:lineClear(eye, targetPos)
end

-- слышит ли шаги игрока (и чувствует ли вплотную)
function AI:canHear(player)
	local ok, hrp = self:isCandidate(player)
	if not ok then
		return false
	end
	if player:GetAttribute("Hiding") and not self.exposed[player] then
		return false
	end
	local dist = (hrp.Position - self.root.Position).Magnitude
	if dist &lt;= self.diff.sense and math.abs(hrp.Position.Y - self.root.Position.Y) &lt; 8 then
		return true -- дыхание в упор
	end
	local r = self:noiseRadius(player, hrp)
	return r &gt; 0 and dist &lt;= r
end

-- одиночный шум (щелчок, дверца, генератор)
function AI:onNoise(player, position, kind)
	if not self.alive or self.state == "Sleep" or self.state == "Attack" then
		return
	end
	local range = self.diff.hear[kind] or 0
	if range &lt;= 0 then
		return
	end
	local perk = player and player:GetAttribute("Perk_noise")
	if type(perk) == "number" then
		range *= perk
	end
	local d = (position - self.root.Position).Magnitude
	if d &gt; range then
		return
	end
	if self.state == "Chase" then
		return
	end
	local priority = (kind == "interact") and 2 or 1
	if self.state ~= "Investigate" or priority &gt;= self.investigatePriority then
		self.investigatePos = position
		self.investigatePriority = priority
		self:setState("Investigate")
		self:sniff()
	end
end

function AI:notifyHide(player)
	if self.target == player and os.clock() - self.lastSeen &lt; 1.5 then
		self.exposed[player] = true
	else
		self.exposed[player] = nil
	end
end

function AI:notifyUnhide(player)
	self.exposed[player] = nil
end

function AI:speedFor(state)
	local sp = self.diff.speed
	local bonus = self.generators * C.ChaseSpeedPerGenerator + (self.enraged and C.EnragedBonus or 0)
	if state == "Chase" then
		return sp.chase + bonus
	elseif state == "Investigate" or state == "Search" then
		return sp.investigate + bonus * 0.5
	end
	return sp.patrol + bonus * 0.3
end

function AI:computePath(dest)
	local ok = pcall(function()
		self.path:ComputeAsync(self.root.Position, dest)
	end)
	self.pathTime = os.clock()
	self.pathDest = dest
	if ok and self.path.Status == Enum.PathStatus.Success then
		self.waypoints = self.path:GetWaypoints()
		self.wpIndex = math.min(2, #self.waypoints)
		return true
	end
	self.waypoints = nil
	return false
end

-- движение к точке; возвращает true, когда дошёл
function AI:moveTowards(dest, repathEvery)
	local pos = self.root.Position
	if (flat(dest) - flat(pos)).Magnitude &lt; 4 then
		return true
	end
	-- прямая видимость — идём напрямую (быстрее и страшнее)
	local destAtRoot = Vector3.new(dest.X, pos.Y, dest.Z)
	local right = self.root.CFrame.RightVector * 2.4
	if (destAtRoot - pos).Magnitude &lt; 70
		and self:lineClear(pos, destAtRoot)
		and self:lineClear(pos + Vector3.new(0, 3.5, 0), destAtRoot + Vector3.new(0, 3.5, 0))
		and self:lineClear(pos + right, destAtRoot + right)
		and self:lineClear(pos - right, destAtRoot - right)
	then
		self.waypoints = nil
		self.hum:MoveTo(dest)
		return false
	end
	if
		not self.waypoints
		or not self.pathDest
		or (self.pathDest - dest).Magnitude &gt; 6
		or os.clock() - self.pathTime &gt; (repathEvery or 2)
	then
		if not self:computePath(dest) then
			self.hum:MoveTo(dest)
			return false
		end
	end
	local wp = self.waypoints[self.wpIndex]
	while wp and (flat(wp.Position) - flat(self.root.Position)).Magnitude &lt; 3.5 do
		self.wpIndex += 1
		wp = self.waypoints[self.wpIndex]
	end
	if not wp then
		self.waypoints = nil
		return true
	end
	self.hum:MoveTo(wp.Position)
	return false
end

function AI:pickPatrolGoal()
	if #self.nodes == 0 then
		return self.root.Position
	end
	-- иногда он "чувствует" игрока и идёт в его сторону
	if math.random() &lt; (self.enraged and 0.8 or C.HuntChance) then
		local candidates = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local ok, hrp = self:isCandidate(p)
			if ok then
				table.insert(candidates, hrp.Position)
			end
		end
		if #candidates &gt; 0 then
			local target = candidates[math.random(1, #candidates)]
			local best, bestD = nil, math.huge
			for _, n in ipairs(self.nodes) do
				local d = (n - target).Magnitude + math.random() * 40
				if d &lt; bestD then
					best, bestD = n, d
				end
			end
			if best then
				return best
			end
		end
	end
	return self.nodes[math.random(1, #self.nodes)]
end

function AI:scream()
	if os.clock() - self.lastScream &gt; 18 then
		self.lastScream = os.clock()
		Sound.play("MonsterScream", self.head, {
			Volume = 0.9,
			PlaybackSpeed = 1.15,
			RollOffMinDistance = 12,
			RollOffMaxDistance = 160,
		})
	end
end

function AI:sniff()
	if os.clock() - self.lastSniff &gt; 4 then
		self.lastSniff = os.clock()
		self.model:SetAttribute("Sniff", os.clock())
		Sound.play("MonsterSniff", self.head, { Volume = 0.8, RollOffMinDistance = 8, RollOffMaxDistance = 80 })
	end
end

-- ЭХО-КРИК (режим Кошмар): выдаёт всех, кто двигается
function AI:sonar()
	self.lastSonar = os.clock()
	self.model:SetAttribute("Sonar", os.clock())
	Sound.play("Sonar", self.head, { Volume = 1.2, RollOffMinDistance = 20, RollOffMaxDistance = 400 })
	Remotes.Sonar:FireAllClients(self.root.Position)
	task.delay(0.6, function()
		if not self.alive then
			return
		end
		local best, bestD = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			local ok, hrp = self:isCandidate(p)
			if ok and not p:GetAttribute("Hiding") then
				local vel = flat(hrp.AssemblyLinearVelocity).Magnitude
				local d = (hrp.Position - self.root.Position).Magnitude
				if vel &gt; 0.8 and d &lt; 180 and d &lt; bestD then
					best, bestD = p, d
				end
			end
		end
		if best and self.state ~= "Attack" then
			local _, hrp = self:isCandidate(best)
			if bestD &lt; 55 then
				self.target = best
				self.lastSeen = os.clock()
				self.lastSeenPos = hrp.Position
				self:setState("Chase")
				self:scream()
			else
				self.investigatePos = hrp.Position
				self.investigatePriority = 3
				self:setState("Investigate")
			end
			Remotes.notify(best, "ОНО УСЛЫШАЛО ТЕБЯ. ЗАМРИ.", Color3.fromRGB(235, 40, 40))
		end
	end)
end

function AI:catch(player)
	local ok, hrp = self:isCandidate(player)
	if not ok then
		return
	end
	self:setState("Attack")
	self.target = nil
	self.hum:MoveTo(self.root.Position)
	player:SetAttribute("Caught", true)
	if player:GetAttribute("Hiding") and self.opts.onDragOut then
		self.opts.onDragOut(player)
	end
	hrp.Anchored = true
	local look = Vector3.new(hrp.Position.X, self.root.Position.Y, hrp.Position.Z)
	if (look - self.root.Position).Magnitude &gt; 0.1 then
		self.root.Anchored = true
		self.root.CFrame = CFrame.lookAt(self.root.Position, look)
	end
	-- жертву разворачиваем лицом к монстру
	local facePos = Vector3.new(self.root.Position.X, hrp.Position.Y, self.root.Position.Z)
	if (facePos - hrp.Position).Magnitude &gt; 0.1 then
		hrp.CFrame = CFrame.lookAt(hrp.Position, facePos)
	end
	Remotes.Jumpscare:FireClient(player, self.model)
	Sound.play("MonsterScream", self.head, { Volume = 1.3, RollOffMinDistance = 15, RollOffMaxDistance = 180 })
	task.wait(2.4)
	if self.opts.onCatch then
		self.opts.onCatch(player)
	end
	self.exposed[player] = nil
	self.root.Anchored = false
	pcall(function()
		self.root:SetNetworkOwner(nil)
	end)
	self.cooldownUntil = os.clock() + 3
	self:setState("Patrol")
	self.patrolGoal = self:pickPatrolGoal()
end

function AI:wake()
	if self.state ~= "Sleep" then
		return
	end
	self:setState("Patrol")
	self:scream()
	pcall(function()
		self.root:SetNetworkOwner(nil)
	end)
	task.spawn(function()
		self:loop()
	end)
end

function AI:hunt()
	-- идёт к ближайшему игроку (после запуска генератора)
	local best, bestD = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, hrp = self:isCandidate(p)
		if ok and not p:GetAttribute("Hiding") then
			local d = (hrp.Position - self.root.Position).Magnitude
			if d &lt; bestD then
				best, bestD = hrp.Position, d
			end
		end
	end
	if best then
		self.investigatePos = best
		self.investigatePriority = 2
		self:setState("Investigate")
	end
end

function AI:stop()
	self.alive = false
	if self.breath then
		self.breath:Stop()
	end
	if self.noiseConn then
		self.noiseConn:Disconnect()
	end
end

function AI:loseTime(player)
	local t = self.diff.loseTime
	local perk = player and player:GetAttribute("Perk_lose")
	if type(perk) == "number" then
		t *= perk
	end
	return t
end

function AI:loop()
	local filterTick = 0
	while self.alive and self.model.Parent and self.hum.Health &gt; 0 do
		local dt = task.wait(0.1)
		filterTick += dt
		if filterTick &gt; 1 then
			filterTick = 0
			self:refreshFilter()
		end
		if self.state == "Attack" or os.clock() &lt; self.cooldownUntil then
			continue
		end

		if self.diff.sonar &gt; 0 and os.clock() - self.lastSonar &gt; self.diff.sonar then
			self:sonar()
		end

		-- кого видим / слышим
		local seen, seenD, seenHrp = nil, math.huge, nil
		local heardPos, heardD = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			local ok, hrp = self:isCandidate(p)
			if ok then
				local d = (hrp.Position - self.root.Position).Magnitude
				if self:canSee(p) then
					if d &lt; seenD then
						seen, seenD, seenHrp = p, d, hrp
					end
				elseif self:canHear(p) then
					if self.diff.blind then
						-- слепой: "видит" ушами — преследует источник шума
						if d &lt; seenD then
							seen, seenD, seenHrp = p, d, hrp
						end
					elseif d &lt; heardD then
						heardPos, heardD = hrp.Position, d
					end
				end
			end
		end

		if seen then
			if self.state ~= "Chase" then
				self:scream()
				if self.diff.blind then
					self:sniff()
				end
			end
			self.target = seen
			self.lastSeen = os.clock()
			self.lastSeenPos = seenHrp.Position
			self:setState("Chase")
		elseif heardPos and self.state ~= "Chase" then
			self.investigatePos = heardPos
			self.investigatePriority = 1
			self:setState("Investigate")
			self:sniff()
		end

		local state = self.state
		self.hum.WalkSpeed = self:speedFor(state)

		if state == "Chase" then
			local ok, hrp = false, nil
			if self.target then
				ok, hrp = self:isCandidate(self.target)
			end
			if not ok then
				self.target = nil
				self:setState("Search")
				self.searchUntil = os.clock() + 5
			else
				local d = (hrp.Position - self.root.Position).Magnitude
				local hiddenSafe = self.target:GetAttribute("Hiding") and not self.exposed[self.target]
				if d &lt;= C.KillRange and not hiddenSafe and math.abs(hrp.Position.Y - self.root.Position.Y) &lt; 8 then
					self:catch(self.target)
					continue
				end
				if os.clock() - self.lastSeen &gt; self:loseTime(self.target) or hiddenSafe then
					self.target = nil
					self:setState("Search")
					self.searchUntil = os.clock() + 6
				else
					-- пока засёк — бежит к игроку, потерял — к последней точке (недолго "чует")
					local fresh = self.diff.blind and 0.8 or 2
					local dest = (os.clock() - self.lastSeen &lt; fresh) and hrp.Position or self.lastSeenPos
					self:moveTowards(dest, 0.6)
				end
			end
		elseif state == "Investigate" then
			if not self.investigatePos or self:moveTowards(self.investigatePos, 1.5) then
				self.investigatePriority = 0
				self:setState("Search")
				self.searchUntil = os.clock() + 4
			end
		elseif state == "Search" then
			if self.lastSeenPos and (flat(self.lastSeenPos) - flat(self.root.Position)).Magnitude &gt; 5 then
				if self:moveTowards(self.lastSeenPos, 1.5) then
					self.lastSeenPos = nil
				end
			else
				-- осматривается / прислушивается: резкие повороты на месте
				if math.random() &lt; 0.15 then
					local a = math.random() * math.pi * 2
					self.hum:MoveTo(self.root.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * 3)
					if self.diff.blind then
						self:sniff()
					end
				end
			end
			if os.clock() &gt; self.searchUntil then
				self.lastSeenPos = nil
				self:setState("Patrol")
				self.patrolGoal = self:pickPatrolGoal()
			end
		elseif state == "Patrol" then
			if not self.patrolGoal then
				self.patrolGoal = self:pickPatrolGoal()
			end
			if self:moveTowards(self.patrolGoal, 4) then
				self.patrolGoal = self:pickPatrolGoal()
			end
		end

		-- застрял?
		if os.clock() - self.lastStuckCheck &gt; 1.5 then
			local moved = (flat(self.root.Position) - flat(self.lastPos)).Magnitude
			self.lastPos = self.root.Position
			self.lastStuckCheck = os.clock()
			if moved &lt; 1 and self.state ~= "Search" then
				self.stuckCount += 1
				self.waypoints = nil
				if self.stuckCount &gt;= 2 then
					self.stuckCount = 0
					if self.state == "Patrol" or self.state == "Investigate" then
						self:setState("Patrol")
						self.patrolGoal = self:pickPatrolGoal()
					end
					-- небольшой сдвиг назад
					self.hum:MoveTo(self.root.Position - self.root.CFrame.LookVector * 4)
				end
			else
				self.stuckCount = 0
			end
		end
	end
end

return AI
</ProtectedString></Properties></Item>
</Item>
<Item class="Script" referent="RBX00004DA9"><Properties><string name="Name">Main</string><ProtectedString name="Source">--[[
	ПАЛАТА 13 — сервер раунда (игровой плейс).
	Карта выбирается у врат в лобби и приходит в TeleportData: { map, difficulty, maxPlayers }.
	Все карты лежат в ServerStorage.Maps.&lt;id&gt; и клонируются в workspace.Map на старте раунда.
	Цель: найти предохранители, вставить в генераторы, починить их (удерживать E),
	включить свет -&gt; открыть ворота -&gt; выбежать в зону выхода.
	В Studio карту/сложность можно задать атрибутами workspace: TestMap, TestDifficulty.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local TeleportService = game:GetService("TeleportService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Core = ServerScriptService:WaitForChild("Core")
local Remotes = require(Core.Remotes)
local DataService = require(Core.DataService)
local ShopService = require(Core.ShopService)
local BPService = require(Core.BattlePassService)
local FS = require(Core.FlashlightService)
local MonsterAI = require(Core.MonsterAI)

local Config = require(ReplicatedStorage.Shared.Config)
local Sound = require(ReplicatedStorage.Shared.Sound)

Players.CharacterAutoLoads = false

DataService.start()
ShopService.start(false)
BPService.start()
FS.start(false)

local Maps = ServerStorage:WaitForChild("Maps")
local Monsters = ServerStorage:WaitForChild("Monsters")

local R = Config.Round
local round = nil -- текущий раунд
local ai = nil
local Map = nil
local pickupFolder = Instance.new("Folder")
pickupFolder.Name = "Pickups"
pickupFolder.Parent = workspace

-- НАСТРОЙКИ СЕССИИ (из телепорта) -------------------------------------------
local session = { map = nil, difficulty = nil, maxPlayers = Config.MaxPlayersPerRound }

local function readTeleportData(player)
	local ok, td = pcall(function()
		local join = player:GetJoinData()
		return join and join.TeleportData
	end)
	if not ok or type(td) ~= "table" then
		return
	end
	if type(td.map) == "string" and Maps:FindFirstChild(td.map) and not session.map then
		session.map = td.map
	end
	if type(td.difficulty) == "string" and not session.difficulty then
		for _, d in ipairs(Config.Difficulties) do
			if d.id == td.difficulty then
				session.difficulty = d.id
			end
		end
	end
	if type(td.maxPlayers) == "number" then
		session.maxPlayers = math.clamp(math.floor(td.maxPlayers), 1, Config.MaxPlayersPerRound)
	end
end

local function resolveSession()
	local mapId = session.map or workspace:GetAttribute("TestMap")
	if type(mapId) ~= "string" or not Maps:FindFirstChild(mapId) then
		mapId = Maps:FindFirstChild("Hospital") and "Hospital" or (Maps:GetChildren()[1] and Maps:GetChildren()[1].Name)
	end
	local diffId = session.difficulty or workspace:GetAttribute("TestDifficulty")
	local diff = Config.getDifficulty(diffId)
	return mapId, diff
end

workspace:SetAttribute("RoundState", "Waiting")
workspace:SetAttribute("Power", false)
workspace:SetAttribute("GensDone", 0)
workspace:SetAttribute("GensNeeded", 3)
workspace:SetAttribute("TimeLeft", R.TimeLimit)

local function message(text, color)
	Remotes.RoundUpdate:FireAllClients("message", text, color)
end

local function shuffle(t)
	for i = #t, 2, -1 do
		local j = math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

local function ps(player)
	return round and round.players[player]
end

local function isAlive(player)
	local s = ps(player)
	return s ~= nil and s.alive and not s.escaped and not player:GetAttribute("Caught")
end

local function partsOf(obj)
	local list = {}
	if obj then
		if obj:IsA("BasePart") then
			table.insert(list, obj)
		end
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(list, d)
			end
		end
	end
	return list
end

-- КАРТА ---------------------------------------------------------------------
local function applyLighting(mapCfg)
	local l = mapCfg.lighting or {}
	Lighting.FogEnd = l.fog or 400
	Lighting.FogStart = 0
	if l.ambient then
		Lighting.Ambient = l.ambient
	end
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm and l.density then
		atm.Density = l.density
	end
	local grade = Lighting:FindFirstChild("Grade")
	if grade and l.tint then
		grade.TintColor = l.tint
	end
end

local function loadMap(mapId)
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local template = Maps:FindFirstChild(mapId)
	local m = template:Clone()
	m.Name = "Map"
	m.Parent = workspace
	Map = m
	workspace:SetAttribute("Map", mapId)
	applyLighting(Config.getMap(mapId))
	return m
end

-- ПРЕДМЕТЫ ---------------------------------------------------------------
local function makeFuse(position)
	local m = Instance.new("Model")
	m.Name = "Fuse"
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Cylinder
	body.Size = Vector3.new(1.4, 0.55, 0.55)
	body.Material = Enum.Material.Glass
	body.Color = Color3.fromRGB(255, 190, 60)
	body.Transparency = 0.25
	body.Anchored = true
	body.CanCollide = false
	body.CFrame = CFrame.new(position + Vector3.new(0, 0.35, 0)) * CFrame.Angles(0, math.random() * 6.28, 0)
	body.Parent = m
	for _, x in ipairs({ -0.6, 0.6 }) do
		local cap = Instance.new("Part")
		cap.Shape = Enum.PartType.Cylinder
		cap.Size = Vector3.new(0.22, 0.62, 0.62)
		cap.Material = Enum.Material.Metal
		cap.Color = Color3.fromRGB(170, 170, 160)
		cap.Anchored = true
		cap.CanCollide = false
		cap.CFrame = body.CFrame * CFrame.new(x, 0, 0)
		cap.Parent = m
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 170, 50)
	glow.Range = 7
	glow.Brightness = 0.9
	glow.Parent = body
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Взять"
	prompt.ObjectText = "Предохранитель"
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	m.PrimaryPart = body
	m.Parent = pickupFolder
	prompt.Triggered:Connect(function(player)
		if not isAlive(player) or not m.Parent then
			return
		end
		if player:GetAttribute("Fuse") then
			Remotes.notify(player, "Ты уже несёшь предохранитель. Найди генератор.")
			return
		end
		Sound.playAt("Pickup", body.Position, { Volume = 0.8 })
		m:Destroy()
		player:SetAttribute("Fuse", true)
		Remotes.notify(player, "Предохранитель у тебя. Вставь его в любой генератор.", Color3.fromRGB(255, 190, 60))
	end)
	return m
end

local function makeBattery(position)
	local p = Instance.new("Part")
	p.Name = "Battery"
	p.Size = Vector3.new(0.5, 0.9, 0.5)
	p.Shape = Enum.PartType.Block
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(40, 140, 60)
	p.Anchored = true
	p.CanCollide = false
	p.CFrame = CFrame.new(position + Vector3.new(0, 0.45, 0)) * CFrame.Angles(0, math.random() * 6.28, 0)
	local tip = Instance.new("Part")
	tip.Size = Vector3.new(0.25, 0.15, 0.25)
	tip.Material = Enum.Material.Metal
	tip.Color = Color3.fromRGB(200, 200, 190)
	tip.Anchored = true
	tip.CanCollide = false
	tip.CFrame = p.CFrame * CFrame.new(0, 0.52, 0)
	tip.Parent = p
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(120, 255, 140)
	glow.Range = 5
	glow.Brightness = 0.6
	glow.Parent = p
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Взять"
	prompt.ObjectText = "Батарейка"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = p
	p.Parent = pickupFolder
	prompt.Triggered:Connect(function(player)
		if not isAlive(player) or not p.Parent then
			return
		end
		if (player:GetAttribute("Battery") or 0) &gt;= 99 then
			Remotes.notify(player, "Батарея и так полная.")
			return
		end
		Sound.playAt("Pickup", p.Position, { Volume = 0.6, PlaybackSpeed = 1.2 })
		p:Destroy()
		FS.addBattery(player, 40)
		Remotes.notify(player, "+40% батареи", Color3.fromRGB(120, 255, 140))
	end)
	return p
end

local function spawnPickups(fuseCount)
	pickupFolder:ClearAllChildren()
	local spawns = Map:FindFirstChild("Spawns")
	local fuseSpots, batSpots = {}, {}
	if spawns then
		for _, s in ipairs(spawns:FindFirstChild("Fuse") and spawns.Fuse:GetChildren() or {}) do
			table.insert(fuseSpots, s.Position)
		end
		for _, s in ipairs(spawns:FindFirstChild("Battery") and spawns.Battery:GetChildren() or {}) do
			table.insert(batSpots, s.Position)
		end
	end
	shuffle(fuseSpots)
	for i = 1, math.min(fuseCount, #fuseSpots) do
		makeFuse(fuseSpots[i])
	end
	shuffle(batSpots)
	for i = 1, math.min(R.Batteries, #batSpots) do
		makeBattery(batSpots[i])
	end
end

-- ШКАФЧИКИ -------------------------------------------------------------
local lockers = {}
local lockerConns = {}

local function exitLocker(player)
	for locker, occ in pairs(lockers) do
		if occ == player then
			lockers[locker] = nil
			local door = locker:FindFirstChild("Door")
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and door then
				hrp.Anchored = false
				hrp.CFrame = door.CFrame * CFrame.new(0, 0, -3)
			end
			if door then
				Sound.playAt("MetalBang", door.Position, { Volume = 0.25, PlaybackSpeed = 1.7 })
				FS.emitNoise(player, door.Position, "interact")
			end
		end
	end
	player:SetAttribute("Hiding", false)
	if ai then
		ai:notifyUnhide(player)
	end
end

local function setupLockers()
	local folder = Map:FindFirstChild("Lockers")
	if not folder then
		return
	end
	for _, locker in ipairs(folder:GetChildren()) do
		local door = locker:FindFirstChild("Door")
		local inside = locker:FindFirstChild("Inside")
		if door and inside then
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = "Спрятаться / Выйти"
			prompt.ObjectText = "Укрытие"
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 7
			prompt.RequiresLineOfSight = false
			prompt.Parent = door
			table.insert(lockerConns, prompt.Triggered:Connect(function(player)
				if lockers[locker] == player then
					exitLocker(player)
					return
				end
				if not isAlive(player) or player:GetAttribute("Hiding") then
					return
				end
				if lockers[locker] then
					Remotes.notify(player, "Здесь уже кто-то есть...")
					return
				end
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then
					return
				end
				FS.setCrouch(player, false)
				lockers[locker] = player
				hrp.Anchored = true
				hrp.CFrame = inside.CFrame
				player:SetAttribute("Hiding", true)
				FS.setOn(player, false)
				Sound.playAt("MetalBang", door.Position, { Volume = 0.25, PlaybackSpeed = 1.6 })
				FS.emitNoise(player, door.Position, "interact")
				if ai then
					ai:notifyHide(player)
				end
			end))
		end
	end
end

-- ГЕНЕРАТОРЫ / ВОРОТА ---------------------------------------------------------
local gens = {}
local doorStates = {}
local gateConns = {}

local function rememberDoors(obj)
	for _, p in ipairs(partsOf(obj)) do
		if not doorStates[p] then
			doorStates[p] = p.CFrame
		end
	end
end

local function openDoors(obj, defaultOffset, defaultTime)
	if not obj then
		return
	end
	local offset = obj:GetAttribute("OpenOffset")
	if typeof(offset) ~= "Vector3" then
		offset = defaultOffset
	end
	local time = obj:GetAttribute("OpenTime") or defaultTime
	local sndPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
	if sndPart then
		Sound.playAt("GateOpen", sndPart.Position, { Volume = 1.2, RollOffMaxDistance = 220 })
	end
	for _, p in ipairs(partsOf(obj)) do
		TweenService:Create(p, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			CFrame = doorStates[p] + offset,
		}):Play()
	end
end

local function exitGates()
	local list = {}
	local folder = Map:FindFirstChild("ExitGates")
	if folder then
		for _, g in ipairs(folder:GetChildren()) do
			table.insert(list, g)
		end
	end
	local single = Map:FindFirstChild("ExitGate")
	if single then
		table.insert(list, single)
	end
	return list
end

local function exitZones()
	local list = {}
	local folder = Map:FindFirstChild("ExitZones")
	if folder then
		for _, z in ipairs(folder:GetChildren()) do
			if z:IsA("BasePart") then
				table.insert(list, z)
			end
		end
	end
	local single = Map:FindFirstChild("ExitZone")
	if single then
		table.insert(list, single)
	end
	return list
end

local function setIndicators(g)
	for i, ind in ipairs(g.indicators) do
		local on
		if g.done then
			on = true
		elseif g.fused then
			on = (i - 1) / math.max(1, #g.indicators) &lt; g.progress
		else
			on = false
		end
		ind.Material = Enum.Material.Neon
		ind.Color = on and Color3.fromRGB(60, 255, 90) or (g.fused and Color3.fromRGB(255, 170, 40) or Color3.fromRGB(120, 10, 10))
	end
	g.model:SetAttribute("Progress", g.progress)
	g.model:SetAttribute("Fused", g.fused)
	g.model:SetAttribute("Done", g.done)
end

local function powerOn()
	if workspace:GetAttribute("Power") then
		return
	end
	workspace:SetAttribute("Power", true)
	message("ТОК ПОДАН. ВОРОТА ОТКРЫВАЮТСЯ. БЕГИ К ВЫХОДУ.", Color3.fromRGB(255, 60, 60))
	for _, g in ipairs(gens) do
		local engine = g.model:FindFirstChild("Engine") or g.slot
		Sound.playAt("GeneratorOn", engine.Position, { Volume = 1.5, RollOffMaxDistance = 250 })
	end
	openDoors(Map:FindFirstChild("EntranceDoor"), Vector3.new(0, 12, 0), 3)
	for _, gate in ipairs(exitGates()) do
		openDoors(gate, Vector3.new(0, -13, 0), 5)
	end
	if ai then
		ai.enraged = true
		ai.model:SetAttribute("Enraged", true)
		ai:hunt()
	end
end

local function repairMult(player)
	local perk = player:GetAttribute("Perk_repair")
	local m = type(perk) == "number" and perk or 1
	if round and round.difficulty.id == "Easy" then
		m *= 1.2
	end
	return m
end

local function generatorDone(g, player)
	g.done = true
	g.progress = 1
	g.repairing = nil
	g.prompt.Enabled = false
	setIndicators(g)
	round.gensDone += 1
	workspace:SetAttribute("GensDone", round.gensDone)
	local engine = g.model:FindFirstChild("Engine") or g.slot
	Sound.playAt("GeneratorOn", engine.Position, { Volume = 1.1, RollOffMaxDistance = 180 })
	FS.emitNoise(player, engine.Position, "interact")
	-- включаем лампы самого генератора
	for _, d in ipairs(g.model:GetDescendants()) do
		if d:IsA("Light") then
			d.Enabled = true
		elseif d:IsA("ParticleEmitter") and d.Name == "Exhaust" then
			d.Enabled = true
		end
	end
	local s = ps(player)
	if s then
		s.generators += 1
		s.coins += Config.Rewards.Generator.coins
		s.xp += Config.Rewards.Generator.xp
	end
	if ai then
		ai.generators = round.gensDone
	end
	if round.gensDone &gt;= round.gensNeeded then
		powerOn()
	else
		message(string.format("ГЕНЕРАТОР %d/%d ЗАПУЩЕН. Оно слышало это...", round.gensDone, round.gensNeeded), Color3.fromRGB(255, 190, 60))
	end
end

local function setupGenerators()
	gens = {}
	local list = {}
	local folder = Map:FindFirstChild("Generators")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			table.insert(list, m)
		end
	end
	local single = Map:FindFirstChild("Generator")
	if single then
		table.insert(list, single)
	end
	for _, model in ipairs(list) do
		local slot = model:FindFirstChild("Slot", true)
		if slot then
			local g = { model = model, slot = slot, indicators = {}, fused = false, done = false, progress = 0, repairing = nil, holdStart = 0 }
			for i = 1, 8 do
				local ind = model:FindFirstChild("I" .. i, true)
				if ind then
					table.insert(g.indicators, ind)
				end
			end
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = "Вставить предохранитель"
			prompt.ObjectText = "Генератор"
			prompt.HoldDuration = 0.6
			prompt.MaxActivationDistance = 9
			prompt.RequiresLineOfSight = false
			prompt.Parent = slot
			g.prompt = prompt
			setIndicators(g)

			prompt.PromptButtonHoldBegan:Connect(function(player)
				if not round or not isAlive(player) or not g.fused or g.done or g.repairing then
					return
				end
				g.repairing = player
				g.holdStart = os.clock()
				player:SetAttribute("Repairing", model.Name)
				Sound.playAt("GeneratorCrank", slot.Position, { Volume = 0.8, RollOffMaxDistance = 90 })
				FS.emitNoise(player, slot.Position, "interact")
				local sparks = slot:FindFirstChild("Sparks")
				if sparks then
					sparks.Enabled = true
				end
			end)
			prompt.PromptButtonHoldEnded:Connect(function(player)
				if g.repairing ~= player then
					return
				end
				g.repairing = nil
				player:SetAttribute("Repairing", nil)
				local sparks = slot:FindFirstChild("Sparks")
				if sparks then
					sparks.Enabled = false
				end
				if not g.done then
					prompt.HoldDuration = math.max(0.3, R.RepairTime * (1 - g.progress) / repairMult(player))
				end
			end)
			prompt.Triggered:Connect(function(player)
				if not round or not isAlive(player) or g.done then
					return
				end
				if not g.fused then
					if not player:GetAttribute("Fuse") then
						Remotes.notify(player, "Нужен предохранитель. Ищи их по карте.")
						return
					end
					player:SetAttribute("Fuse", false)
					g.fused = true
					setIndicators(g)
					Sound.playAt("FuseInsert", slot.Position, { Volume = 1, RollOffMaxDistance = 120 })
					FS.emitNoise(player, slot.Position, "interact")
					local s = ps(player)
					if s then
						s.fuses += 1
						s.coins += Config.Rewards.Fuse.coins
						s.xp += Config.Rewards.Fuse.xp
					end
					prompt.ActionText = "Чинить (держи E)"
					prompt.HoldDuration = R.RepairTime / repairMult(player)
					Remotes.notify(player, "Теперь почини его: держи E. Это шумно.", Color3.fromRGB(255, 190, 60))
					return
				end
				-- удержание завершено полностью
				g.progress = 1
				g.repairing = nil
				player:SetAttribute("Repairing", nil)
				generatorDone(g, player)
			end)
			table.insert(gens, g)
		end
	end
	-- прогресс починки тикает, пока игрок держит кнопку (частичный прогресс сохраняется)
	task.spawn(function()
		local myRound = round
		while round == myRound and round and not round.ended do
			task.wait(0.25)
			for _, g in ipairs(gens) do
				local p = g.repairing
				if p and not g.done then
					if not isAlive(p) or not p.Parent then
						g.repairing = nil
					else
						g.progress = math.min(0.999, g.progress + 0.25 * repairMult(p) / R.RepairTime)
						setIndicators(g)
						p:SetAttribute("RepairProgress", g.progress)
						if math.random() &lt; 0.3 then
							FS.emitNoise(p, g.slot.Position, "interact")
						end
					end
				end
			end
		end
	end)
	return #gens
end

-- ИГРОКИ -----------------------------------------------------------------
local function dropFuse(player, position)
	if player:GetAttribute("Fuse") then
		player:SetAttribute("Fuse", false)
		if position then
			makeFuse(position - Vector3.new(0, 2.6, 0))
		end
	end
end

local function spawnCharacter(player)
	player:SetAttribute("Caught", false)
	player:SetAttribute("Hiding", false)
	player:SetAttribute("Dead", false)
	player:SetAttribute("Escaped", false)
	player:SetAttribute("Repairing", nil)
	player:LoadCharacter()
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	hum.WalkSpeed = Config.Player.WalkSpeed
	hum.JumpPower = 38
	hum.UseJumpPower = true
	hum.Died:Connect(function()
		local s = ps(player)
		if s and s.alive and not s.escaped then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			dropFuse(player, hrp and hrp.Position)
			s.alive = false
			player:SetAttribute("Dead", true)
		end
	end)
	local spawnPart = Map and Map:FindFirstChild("SpawnLocation")
	if spawnPart then
		char:PivotTo(spawnPart.CFrame * CFrame.new(math.random(-3, 3), 3, math.random(-3, 3)))
	end
	return char
end

local function killPlayer(player)
	local s = ps(player)
	if not s or not s.alive then
		return
	end
	exitLocker(player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	dropFuse(player, hrp and hrp.Position)
	s.alive = false
	s.coins += Config.Rewards.Death.coins
	s.xp += Config.Rewards.Death.xp
	player:SetAttribute("Dead", true)
	player:SetAttribute("Caught", false)
	player:SetAttribute("Repairing", nil)
	FS.setOn(player, false)
	if char then
		-- тело остаётся лежать — страшная находка для других
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hrp then
			hrp.Anchored = false
		end
		if hum then
			hum.BreakJointsOnDeath = true
			hum.Health = 0
		end
	end
	local data = DataService.get(player)
	if data then
		data.stats.deaths += 1
	end
	message(player.DisplayName .. " больше не отвечает...", Color3.fromRGB(200, 40, 40))
end

local function revive(player)
	local s = ps(player)
	if not round or round.ended or not s or s.alive or s.escaped then
		return false
	end
	s.alive = true
	task.spawn(function()
		spawnCharacter(player)
		player:SetAttribute("Battery", 60)
		Remotes.notify(player, "Ты вернулся. Оно знает.", Color3.fromRGB(110, 200, 110))
	end)
	return true
end

ShopService.onRevivePurchased = function(player)
	return revive(player)
end

Remotes.UseRevive.OnServerInvoke = function(player)
	local s = ps(player)
	if not s or s.alive or s.escaped or not round or round.ended then
		return false, "Сейчас нельзя"
	end
	local data = DataService.get(player)
	if not data or data.revives &lt;= 0 then
		return false, "Нет жетонов"
	end
	data.revives -= 1
	DataService.push(player)
	return revive(player), "Возрождение..."
end

-- запасные батарейки (перк): автоматически, когда батарея села
local function watchBattery(player)
	player:GetAttributeChangedSignal("Battery"):Connect(function()
		local b = player:GetAttribute("Battery") or 0
		local spare = player:GetAttribute("SpareBatteries") or 0
		if b &lt;= 0 and spare &gt; 0 and isAlive(player) then
			player:SetAttribute("SpareBatteries", spare - 1)
			FS.addBattery(player, 40)
			Remotes.notify(player, "Запасная батарейка вставлена (осталось " .. (spare - 1) .. ")", Color3.fromRGB(120, 255, 140))
		end
	end)
end

local function onPlayer(player)
	readTeleportData(player)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMaxZoomDistance = 0.5
	watchBattery(player)
	if round and not round.ended then
		-- опоздавший: если раунд идёт &lt; 90 сек, запускаем в игру, иначе зритель
		round.players[player] = { alive = false, escaped = false, fuses = 0, generators = 0, coins = 0, xp = 0, joined = os.clock() }
		if os.clock() - round.start &lt; 90 then
			round.players[player].alive = true
			task.spawn(spawnCharacter, player)
		else
			player:SetAttribute("Dead", true)
			Remotes.notify(player, "Раунд уже идёт. Ты наблюдаешь.")
		end
		Remotes.RoundUpdate:FireClient(player, "intro", round.mapId, round.difficulty.id)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	onPlayer(p)
end

Players.PlayerRemoving:Connect(function(player)
	exitLocker(player)
	if round then
		local s = round.players[player]
		if s and player:GetAttribute("Fuse") then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			dropFuse(player, hrp and hrp.Position)
		end
		round.players[player] = nil
	end
end)

-- МОНСТР -----------------------------------------------------------------
local function spawnMonster(diff)
	local template = diff.blind and Monsters:FindFirstChild("Blind") or Monsters:FindFirstChild("Patient")
	template = template or Monsters:FindFirstChildOfClass("Model")
	if not template then
		warn("[Палата13] Нет ServerStorage.Monsters")
		return nil
	end
	local old = workspace:FindFirstChild("Monster")
	if old then
		old:Destroy()
	end
	local m = template:Clone()
	m.Name = "Monster"
	local spawnPart = Map:FindFirstChild("MonsterSpawn")
	if spawnPart then
		m:PivotTo(spawnPart.CFrame + Vector3.new(0, 5, 0))
	end
	m.Parent = workspace
	return MonsterAI.new(m, Map, {
		difficulty = diff,
		isAlive = isAlive,
		noiseSignal = FS.Noise,
		onCatch = function(player)
			killPlayer(player)
		end,
		onDragOut = function(player)
			exitLocker(player)
		end,
	})
end

-- РАУНД ------------------------------------------------------------------
local function countAlive()
	local n = 0
	for p, s in pairs(round.players) do
		if p.Parent and s.alive and not s.escaped then
			n += 1
		end
	end
	return n
end

local function grantTitles(player, data, s)
	local diff, mapId = round.difficulty, round.mapId
	if s.escaped then
		data.stats.mapsEscaped = data.stats.mapsEscaped or {}
		data.stats.mapsEscaped[mapId] = (data.stats.mapsEscaped[mapId] or 0) + 1
		for _, t in ipairs(Config.Titles) do
			if t.source == "map:" .. mapId and not data.titles[t.id] then
				data.titles[t.id] = true
				Remotes.notify(player, "Новый титул: «" .. t.name .. "»", Color3.fromRGB(235, 185, 70))
			end
		end
		if diff.id == "Nightmare" then
			data.stats.nightmareEscapes = (data.stats.nightmareEscapes or 0) + 1
			if not data.titles.Unkillable then
				data.titles.Unkillable = true
				Remotes.notify(player, "Новый титул: «Неубиваемый»", Color3.fromRGB(255, 255, 255))
			end
		end
	end
end

local function finishRound()
	round.ended = true
	workspace:SetAttribute("RoundState", "Ended")
	if ai then
		ai:stop()
	end
	local savedAt = {}
	for player, s in pairs(round.players) do
		if player.Parent then
			local data = DataService.get(player)
			local survived = os.clock() - round.start
			local surviveXP = math.floor(survived / 10) * Config.Rewards.SurviveXPPer10s
			s.xp += surviveXP
			if s.escaped then
				s.coins += Config.Rewards.Escape.coins
				s.xp += Config.Rewards.Escape.xp
			end
			s.xp = math.floor(s.xp * round.difficulty.xpMult)
			s.coins = math.floor(s.coins * round.difficulty.coinMult)
			local vip = ShopService.hasPass(player, "VIP")
			local coins = vip and s.coins * 2 or s.coins
			if data then
				data.coins += coins
				data.stats.games += 1
				data.stats.generators = (data.stats.generators or 0) + s.generators
				if s.escaped then
					data.stats.escapes += 1
				end
				grantTitles(player, data, s)
			end
			BPService.addXP(player, s.xp)
			DataService.push(player)
			Remotes.Results:FireClient(player, {
				escaped = s.escaped,
				fuses = s.fuses,
				generators = s.generators,
				coins = coins,
				vip = vip,
				xp = s.xp,
				time = math.floor(survived),
				totalGens = round.gensDone,
				map = round.mapId,
				difficulty = round.difficulty.id,
			})
		end
	end
	task.wait(R.ReturnToLobbyDelay)

	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, t = DataService.saveAsync(player)
		if ok then
			savedAt[tostring(player.UserId)] = t
		end
		table.insert(list, player)
	end

	if Config.LobbyPlaceId == 0 or RunService:IsStudio() then
		message(RunService:IsStudio() and "В Studio телепорт в лобби не работает. Новый раунд..." or "LobbyPlaceId не задан в Config. Новый раунд...")
		return false
	end
	for _, p in ipairs(list) do
		p:SetAttribute("AlreadySaved", true)
	end
	Remotes.Teleporting:FireAllClients()
	task.wait(1.2)
	local options = Instance.new("TeleportOptions")
	options:SetTeleportData({ savedAt = savedAt, from = "game" })
	local ok, err = pcall(function()
		return TeleportService:TeleportAsync(Config.LobbyPlaceId, list, options)
	end)
	if not ok then
		warn("[Палата13] Телепорт в лобби не удался:", err)
		for _, p in ipairs(list) do
			p:SetAttribute("AlreadySaved", nil)
		end
		message("Телепорт не удался. Новый раунд...")
		return false
	end
	return true
end

TeleportService.TeleportInitFailed:Connect(function(player, _, msg)
	player:SetAttribute("AlreadySaved", nil)
	Remotes.notify(player, "Ошибка телепорта: " .. tostring(msg) .. ". Перезайди в игру.")
end)

local function resetMap(mapId, diff)
	for _, c in ipairs(lockerConns) do
		c:Disconnect()
	end
	lockerConns = {}
	for _, c in ipairs(gateConns) do
		c:Disconnect()
	end
	gateConns = {}
	doorStates = {}
	lockers = {}
	for _, p in ipairs(Players:GetPlayers()) do
		p:SetAttribute("Hiding", false)
	end
	loadMap(mapId)
	workspace:SetAttribute("Power", false)
	workspace:SetAttribute("GensDone", 0)
	setupLockers()
	rememberDoors(Map:FindFirstChild("EntranceDoor"))
	for _, gate in ipairs(exitGates()) do
		rememberDoors(gate)
	end
	local total = setupGenerators()
	local needed = math.clamp(diff.generators, 1, math.max(1, total))
	workspace:SetAttribute("GensNeeded", needed)
	spawnPickups(needed + 1)
	return needed
end

local function runRound()
	-- ждём игроков (остальные из группы ещё грузятся)
	workspace:SetAttribute("RoundState", "Waiting")
	while #Players:GetPlayers() == 0 do
		task.wait(0.5)
	end
	local mapId, diff = resolveSession()
	workspace:SetAttribute("Map", mapId)
	workspace:SetAttribute("Difficulty", diff.id)
	workspace:SetAttribute("Blind", diff.blind == true)
	Remotes.RoundUpdate:FireAllClients("intro", mapId, diff.id)
	for i = R.WaitForPlayers, 1, -1 do
		workspace:SetAttribute("TimeLeft", i)
		Remotes.RoundUpdate:FireAllClients("waiting", i)
		task.wait(1)
	end

	round = { players = {}, fuses = 0, gensDone = 0, gensNeeded = 0, start = os.clock(), ended = false, mapId = mapId, difficulty = diff }
	round.gensNeeded = resetMap(mapId, diff)
	for _, player in ipairs(Players:GetPlayers()) do
		round.players[player] = { alive = true, escaped = false, fuses = 0, generators = 0, coins = 0, xp = 0, joined = os.clock() }
		player:SetAttribute("Battery", 100)
		player:SetAttribute("Fuse", false)
		player:SetAttribute("FlashlightOn", false)
		player:SetAttribute("AlreadySaved", nil)
		local spare = player:GetAttribute("Perk_battery")
		player:SetAttribute("SpareBatteries", type(spare) == "number" and spare or 0)
		task.spawn(spawnCharacter, player)
	end
	workspace:SetAttribute("RoundState", "Playing")
	local mapCfg = Config.getMap(mapId)
	message(string.format("%s · %s\nГЕНЕРАТОРОВ НУЖНО: %d. НЕ ШУМИ.", mapCfg.name, diff.name, round.gensNeeded), Color3.fromRGB(235, 225, 215))

	ai = spawnMonster(diff)
	local woke = false
	local timeLimit = diff.timeLimit or R.TimeLimit
	while true do
		task.wait(0.25)
		local elapsed = os.clock() - round.start
		local left = math.max(0, timeLimit - elapsed)
		workspace:SetAttribute("TimeLeft", math.floor(left))

		if not woke and elapsed &gt;= (diff.wakeDelay or R.MonsterWakeDelay) and ai then
			woke = true
			ai:wake()
			message(diff.blind and "ОНО ПРОСНУЛОСЬ. ОНО СЛЕПОЕ. ОНО СЛУШАЕТ." or "ОНО ПРОСНУЛОСЬ. НЕ СВЕТИ ЕМУ В ГЛАЗА.", Color3.fromRGB(255, 40, 40))
		end

		-- побег
		if workspace:GetAttribute("Power") then
			local zones = exitZones()
			for player, s in pairs(round.players) do
				if s.alive and not s.escaped then
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if hrp then
						for _, zone in ipairs(zones) do
							local rel = zone.CFrame:PointToObjectSpace(hrp.Position)
							local half = zone.Size / 2
							if math.abs(rel.X) &lt;= half.X and math.abs(rel.Y) &lt;= half.Y + 4 and math.abs(rel.Z) &lt;= half.Z then
								s.escaped = true
								player:SetAttribute("Escaped", true)
								FS.setOn(player, false)
								message(player.DisplayName .. " выбрался наружу!", Color3.fromRGB(110, 220, 110))
								if char then
									char:Destroy()
								end
								break
							end
						end
					end
				end
			end
		end

		-- время вышло: оно забирает всех
		if left &lt;= 0 then
			for player, s in pairs(round.players) do
				if s.alive and not s.escaped and player.Parent then
					Remotes.Jumpscare:FireClient(player, workspace:FindFirstChild("Monster"))
				end
			end
			task.wait(2.4)
			for player, s in pairs(round.players) do
				if s.alive and not s.escaped then
					killPlayer(player)
				end
			end
		end

		if countAlive() == 0 then
			break
		end
	end
	local anyEscaped = false
	for _, s in pairs(round.players) do
		if s.escaped then
			anyEscaped = true
		end
	end
	message(anyEscaped and "РАУНД ОКОНЧЕН. КТО-ТО ВЫБРАЛСЯ." or "НИКТО НЕ ВЫШЕЛ.", Color3.fromRGB(255, 60, 60))
	task.wait(2.5)
	return finishRound()
end

task.spawn(function()
	while true do
		local teleported = runRound()
		if teleported then
			-- сервер опустеет и закроется; если кто-то остался — новый раунд
			task.wait(10)
		end
		local m = workspace:FindFirstChild("Monster")
		if m then
			m:Destroy()
		end
		ai = nil
		round = nil
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				p.Character:Destroy()
			end
			p:SetAttribute("Dead", false)
			p:SetAttribute("Escaped", false)
		end
	end
end)

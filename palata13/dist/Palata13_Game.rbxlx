><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="ParticleEmitter" referent="RBX00008610"><Properties><string name="Name">Ink</string><Content name="Texture"><url>rbxasset://textures/particles/smoke_main.dds</url></Content><ColorSequence name="Color">0 0.03922 0.03137 0.03137 0 1 0 0 0 0 </ColorSequence><NumberSequence name="Size">0 1.2 0 1 3.5 0 </NumberSequence><NumberSequence name="Transparency">0 1 0 0.25 0.75 0 1 1 0 </NumberSequence><NumberRange name="Lifetime">1.5 3 </NumberRange><float name="Rate">5</float><NumberRange name="Speed">0.3 1 </NumberRange><Vector2 name="SpreadAngle"><X>60</X><Y>60</Y></Vector2><float name="LightEmission">0</float><Vector3 name="Acceleration"><X>0</X><Y>0.6</Y><Z>0</Z></Vector3><NumberRange name="RotSpeed">-30 30 </NumberRange><NumberRange name="Rotation">0 360 </NumberRange><float name="Drag">0</float><bool name="Enabled">true</bool><float name="ZOffset">-0.5</float><token name="EmissionDirection">1</token><float name="LightInfluence">0.4</float></Properties></Item></Item><Item class="Part" referent="RBX00008611"><Properties><string name="Name">Dust</string><bool name="Anchored">false</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><CoordinateFrame name="CFrame"><X>0</X><Y>0.8</Y><Z>0.2</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3><Color3uint8 name="Color3uint8">4279636496</Color3uint8><token name="Material">272</token><float name="Transparency">1</float><float name="Reflectance">0</float><bool name="CastShadow">true</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Massless">true</bool></Properties><Item class="Weld" referent="RBX00008612"><Properties><string name="Name">W</string><Ref name="Part0">RBX0000831F</Ref><Ref name="Part1">RBX00008611</Ref><CoordinateFrame name="C0"><X>0</X><Y>-4.6</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><CoordinateFrame name="C1"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="ParticleEmitter" referent="RBX00008613"><Properties><string name="Name">Dust</string><Content name="Texture"><url>rbxasset://textures/particles/smoke_main.dds</url></Content><ColorSequence name="Color">0 0.23529 0.21569 0.19608 0 1 0.15686 0.14902 0.13725 0 </ColorSequence><NumberSequence name="Size">0 0.6 0 1 2.2 0 </NumberSequence><NumberSequence name="Transparency">0 0.7 0 1 1 0 </NumberSequence><NumberRange name="Lifetime">0.8 1.6 </NumberRange><float name="Rate">0</float><NumberRange name="Speed">0.5 1.5 </NumberRange><Vector2 name="SpreadAngle"><X>80</X><Y>80</Y></Vector2><float name="LightEmission">0</float><Vector3 name="Acceleration"><X>0</X><Y>0</Y><Z>0</Z></Vector3><NumberRange name="RotSpeed">-30 30 </NumberRange><NumberRange name="Rotation">0 360 </NumberRange><float name="Drag">0</float><bool name="Enabled">false</bool><float name="ZOffset">0</float><token name="EmissionDirection">1</token><float name="LightInfluence">0.4</float></Properties></Item></Item></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX00004DA5"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00004DA6"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00004DA7"><Properties><string name="Name">Signs</string><ProtectedString name="Source">--[[
	Signs: создаёт надписи (SurfaceGui) на деталях, у которых есть StringValue "SignText".
	Стиль берётся из StringValue "SignStyle": plain / room / exit / blood / gold / big.
]]
local STYLES = {
	plain = { color = Color3.fromRGB(215, 208, 190), font = Enum.Font.Antique, stroke = 0.5, light = 1 },
	room = { color = Color3.fromRGB(230, 232, 222), font = Enum.Font.SourceSansSemibold, stroke = 1, light = 1 },
	exit = { color = Color3.fromRGB(130, 255, 160), font = Enum.Font.GothamBold, stroke = 1, light = 0, bright = 2 },
	blood = { color = Color3.fromRGB(125, 6, 8), font = Enum.Font.Antique, stroke = 1, light = 1, rot = true },
	gold = { color = Color3.fromRGB(255, 205, 90), font = Enum.Font.Antique, stroke = 0.4, light = 0, bright = 1.4 },
	big = { color = Color3.fromRGB(190, 182, 160), font = Enum.Font.Antique, stroke = 0.7, light = 1 },
}

local function make(value)
	local part = value.Parent
	if not part or not part:IsA("BasePart") or part:FindFirstChild("SignGui") then
		return
	end
	local styleValue = part:FindFirstChild("SignStyle")
	local style = STYLES[styleValue and styleValue.Value or "plain"] or STYLES.plain
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = style.light
	gui.Brightness = style.bright or 1
	gui.MaxDistance = 160
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = value.Value
	t.TextScaled = true
	t.Font = style.font
	t.TextColor3 = style.color
	t.TextStrokeTransparency = style.stroke
	t.TextStrokeColor3 = Color3.new(0, 0, 0)
	if style.rot then
		t.Rotation = math.random(-5, 5)
	end
	t.Parent = gui
	gui.Parent = part
end

for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("StringValue") and d.Name == "SignText" then
		make(d)
	end
end
workspace.DescendantAdded:Connect(function(d)
	if d:IsA("StringValue") and d.Name == "SignText" then
		task.defer(make, d)
	end
end)
</ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX00004DAA"><Properties><string name="Name">Main</string><ProtectedString name="Source">--[[
	ПАЛАТА 13 — клиент раунда: HUD, бег, ПРИСЯДКА, покачивание камеры, свет, звуки,
	скример, наблюдение, интро карты, настройки (громкость), эхо-крик Кошмара.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Sound = require(Shared:WaitForChild("Sound"))
local UI = require(Shared:WaitForChild("UI"))
local ClientData = require(Shared:WaitForChild("ClientData"))
local Animator = require(Shared:WaitForChild("MonsterAnimator"))
local FL = require(Shared:WaitForChild("FlashlightClient"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local P = Config.Player
local Colors = UI.Colors

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

ClientData.start()
Animator.start()
local fl = FL.start()

-- НАСТРОЙКИ -------------------------------------------------------------------
local settings = { master = 1, music = 0.6, sfx = 1, sensitivity = 1, crouchToggle = true }
local function applySettings()
	Sound.setVolumes(settings.master, settings.music, settings.sfx)
	UserInputService.MouseDeltaSensitivity = settings.sensitivity
end
local function loadSettings(d)
	if d and d.settings then
		for k, v in pairs(d.settings) do
			settings[k] = v
		end
	end
	applySettings()
end
loadSettings(ClientData.get())
local settingsLoaded = ClientData.get() ~= nil
ClientData.Changed:Connect(function(d)
	if not settingsLoaded then
		settingsLoaded = true
		loadSettings(d)
	end
end)
local saveToken = 0
local function saveSettings()
	saveToken += 1
	local my = saveToken
	task.delay(0.8, function()
		if my == saveToken then
			Remotes.Settings:FireServer(settings)
		end
	end)
end

-- GUI -----------------------------------------------------------------------
local gui = UI.new("ScreenGui", {
	Name = "HUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 5,
	Parent = player:WaitForChild("PlayerGui"),
})
UI.vignette(gui, 0.6)

local function bar(name, yOffset, color, text)
	local holder = UI.new("Frame", {
		Name = name,
		Size = UDim2.fromOffset(240, 32),
		Position = UDim2.new(0, 24, 1, yOffset),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = gui,
	})
	local lbl = UI.label({
		Text = text,
		Font = UI.FontMono,
		TextSize = 13,
		TextColor3 = Colors.Dim,
		Size = UDim2.new(1, 0, 0, 14),
		ZIndex = 5,
		Parent = holder,
	})
	local back = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 9),
		Position = UDim2.fromOffset(0, 19),
		BackgroundColor3 = Color3.fromRGB(18, 10, 10),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = holder,
	}, { UI.stroke(Colors.Red, 1, 0.6) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = back,
	})
	return holder, fill, lbl
end

local batteryHolder, batteryFill, batteryLabel = bar("Battery", -64, Color3.fromRGB(230, 220, 160), "ФОНАРИК 100%")
local staminaHolder, staminaFill, staminaLabel = bar("Stamina", -24, Color3.fromRGB(170, 40, 40), "ДЫХАНИЕ")
local noiseHolder, noiseFill, noiseLabel = bar("Noise", -104, Color3.fromRGB(200, 120, 40), "ШУМ")

local mapLabel = UI.label({
	Text = "",
	Font = UI.FontTitle,
	TextSize = 18,
	TextColor3 = Colors.Dim,
	Size = UDim2.fromOffset(420, 22),
	Position = UDim2.fromOffset(24, 18),
	TextStrokeTransparency = 0.6,
	ZIndex = 5,
	Parent = gui,
})
local diffLabel = UI.label({
	Text = "",
	Font = UI.FontMono,
	TextSize = 13,
	TextColor3 = Colors.Dim,
	Size = UDim2.fromOffset(420, 16),
	Position = UDim2.fromOffset(24, 42),
	ZIndex = 5,
	Parent = gui,
})

local objective = UI.label({
	Text = "ГЕНЕРАТОРЫ  0/3",
	Font = UI.FontTitle,
	TextSize = 22,
	TextColor3 = Colors.Text,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromOffset(520, 28),
	Position = UDim2.new(0.5, 0, 0, 18),
	AnchorPoint = Vector2.new(0.5, 0),
	TextStrokeTransparency = 0.5,
	ZIndex = 5,
	Parent = gui,
})
local timerLabel = UI.label({
	Text = "15:00",
	Font = UI.FontMono,
	TextSize = 15,
	TextColor3 = Colors.Dim,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromOffset(200, 18),
	Position = UDim2.new(0.5, 0, 0, 48),
	AnchorPoint = Vector2.new(0.5, 0),
	ZIndex = 5,
	Parent = gui,
})
local carryLabel = UI.label({
	Text = "⚡ У ТЕБЯ ПРЕДОХРАНИТЕЛЬ — ВСТАВЬ ЕГО В ГЕНЕРАТОР",
	Font = UI.FontBold,
	TextSize = 16,
	TextColor3 = Colors.Gold,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromOffset(560, 22),
	Position = UDim2.new(0.5, 0, 0, 72),
	AnchorPoint = Vector2.new(0.5, 0),
	TextStrokeTransparency = 0.4,
	Visible = false,
	ZIndex = 5,
	Parent = gui,
})
local hint = UI.label({
	Text = UserInputService.TouchEnabled and "кнопки справа: свет / бег / присесть" or "F — фонарик   ·   SHIFT — бег   ·   C — присесть   ·   E — взаимодействие   ·   M — настройки",
	Font = UI.FontMono,
	TextSize = 13,
	TextColor3 = Colors.Dim,
	TextTransparency = 0.3,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromOffset(760, 18),
	Position = UDim2.new(0.5, 0, 1, -18),
	AnchorPoint = Vector2.new(0.5, 1),
	ZIndex = 5,
	Parent = gui,
})
task.delay(50, function()
	UI.tween(hint, 2, { TextTransparency = 1 })
end)

-- прогресс починки генератора
local repairHolder = UI.new("Frame", {
	Size = UDim2.fromOffset(360, 44),
	Position = UDim2.new(0.5, 0, 0.62, 0),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 7,
	Parent = gui,
})
UI.label({
	Text = "ЧИНИШЬ ГЕНЕРАТОР — ЭТО ШУМНО",
	Font = UI.FontMono,
	TextSize = 14,
	TextColor3 = Colors.Gold,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.new(1, 0, 0, 18),
	ZIndex = 7,
	Parent = repairHolder,
})
local repairBack = UI.new("Frame", {
	Size = UDim2.new(1, 0, 0, 12),
	Position = UDim2.fromOffset(0, 24),
	BackgroundColor3 = Color3.fromRGB(18, 10, 10),
	BorderSizePixel = 0,
	ZIndex = 7,
	Parent = repairHolder,
}, { UI.stroke(Colors.Gold, 1, 0.4) })
local repairFill = UI.new("Frame", {
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = Colors.Gold,
	BorderSizePixel = 0,
	ZIndex = 8,
	Parent = repairBack,
})

local msg = UI.label({
	Text = "",
	Font = UI.FontTitle,
	TextSize = 30,
	TextColor3 = Colors.Text,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.new(1, -80, 0, 90),
	Position = UDim2.fromScale(0.5, 0.24),
	AnchorPoint = Vector2.new(0.5, 0.5),
	TextTransparency = 1,
	TextStrokeTransparency = 0.3,
	ZIndex = 10,
	Parent = gui,
})
local msgToken = 0
local function showMessage(text, color, duration)
	msgToken += 1
	local my = msgToken
	msg.Text = text
	msg.TextColor3 = color or Colors.Text
	msg.TextTransparency = 1
	UI.tween(msg, 0.25, { TextTransparency = 0 })
	task.spawn(function()
		for _ = 1, 6 do
			if my ~= msgToken then
				return
			end
			msg.TextTransparency = math.random() &lt; 0.5 and 0.55 or 0
			msg.Position = UDim2.new(0.5, math.random(-4, 4), 0.24, math.random(-2, 2))
			task.wait(0.04)
		end
		msg.TextTransparency = 0
		msg.Position = UDim2.fromScale(0.5, 0.24)
	end)
	task.delay(duration or 4.5, function()
		if my == msgToken then
			UI.tween(msg, 0.9, { TextTransparency = 1 })
		end
	end)
end

-- оверлей шкафчика: смотрим сквозь щели
local lockerOverlay = UI.new("Frame", {
	Name = "Locker",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 8,
	Parent = gui,
})
for i = 0, 13 do
	UI.new("Frame", {
		Size = UDim2.new(1, 0, 1 / 14, -5),
		Position = UDim2.fromScale(0, i / 14),
		BackgroundColor3 = Color3.fromRGB(6, 6, 7),
		BorderSizePixel = 0,
		ZIndex = 8,

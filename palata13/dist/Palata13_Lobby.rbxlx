		generators = 4,
		timeLimit = 780,
		sonar = 30, -- секунд между эхо-криками (0 = нет)
		sense = 9,
		xpMult = 2,
		coinMult = 2,
	},
}

-- 9) РАУНД ------------------------------------------------------------------
Config.Round = {
	Fuses = 5, -- запасной параметр (реально = генераторов + 1)
	Batteries = 16,
	TimeLimit = 900,
	MonsterWakeDelay = 25,
	ReturnToLobbyDelay = 12,
	WaitForPlayers = 15,
	RepairTime = 14, -- секунд удержания на одном генераторе
	IntroTime = 9, -- показ сюжета карты
}

Config.Monster = {
	PatrolSpeed = 9,
	InvestigateSpeed = 13,
	ChaseSpeed = 17,
	ChaseSpeedPerGenerator = 0.6,
	EnragedBonus = 2.5,
	SightRange = 90,
	FlashlightSightRange = 125,
	HearSprintRange = 45,
	FOV = 150,
	KillRange = 5.5,
	LoseTargetTime = 6,
	HuntChance = 0.45, -- шанс что патруль пойдёт к случайному игроку
}

Config.Player = {
	WalkSpeed = 12,
	SprintSpeed = 20,
	CrouchSpeed = 6.5,
	StaminaMax = 100,
	StaminaDrain = 20,
	StaminaRegen = 13,
	BatteryDrainPerSec = 0.55,
	-- шум игрока (множитель к радиусу слуха монстра)
	Noise = { crouch = 1, walk = 1, sprint = 1 },
}

-- хелперы ------------------------------------------------------------------
function Config.getFlashlight(id)
	for _, f in ipairs(Config.Flashlights) do
		if f.id == id then
			return f
		end
	end
	return Config.Flashlights[1]
end

function Config.getTitle(id)
	for _, t in ipairs(Config.Titles) do
		if t.id == id then
			return t
		end
	end
	return nil
end

function Config.getMap(id)
	for _, m in ipairs(Config.Maps) do
		if m.id == id then
			return m
		end
	end
	return Config.Maps[1]
end

function Config.getDifficulty(id)
	for _, d in ipairs(Config.Difficulties) do
		if d.id == id then
			return d
		end
	end
	return Config.Difficulties[2]
end

function Config.getPerk(id)
	for _, p in ipairs(Config.Perks) do
		if p.id == id then
			return p
		end
	end
	return nil
end

function Config.productKeyById(productId)
	for key, id in pairs(Config.Products) do
		if id ~= 0 and id == productId then
			return key
		end
	end
	return nil
end

function Config.passKeyById(passId)
	for key, id in pairs(Config.GamePasses) do
		if id ~= 0 and id == passId then
			return key
		end
	end
	return nil
end

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000006EC">
        <Properties>
          <string name="Name">FlashlightClient</string>
          <ProtectedString name="Source">--[[
	Локальный фонарик (клиент). Сервер решает вкл/выкл и батарею (атрибуты игрока),
	а тут красивый луч из камеры: плавное запаздывание, покачивание при ходьбе,
	мерцание при низком заряде и когда Пациент рядом.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FL = {}

function FL.start()
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local action = remotes:WaitForChild("Action")

	local part = Instance.new("Part")
	part.Name = "LocalFlashlight"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Parent = workspace

	local beam = Instance.new("SpotLight")
	beam.Face = Enum.NormalId.Front
	beam.Angle = 50
	beam.Range = 62
	beam.Brightness = 2.6
	beam.Shadows = true
	beam.Parent = part

	local hot = Instance.new("SpotLight")
	hot.Face = Enum.NormalId.Front
	hot.Angle = 20
	hot.Range = 75
	hot.Brightness = 1.6
	hot.Shadows = false
	hot.Parent = part

	local fill = Instance.new("PointLight")
	fill.Range = 7
	fill.Brightness = 0.25
	fill.Shadows = false
	fill.Parent = part

	local api = { part = part, forceFlicker = 0, disabled = false, steady = false }
	local current = workspace.CurrentCamera.CFrame
	local swayT = 0
	local flickerUntil = 0
	local flickerOn = true

	local function isOn()
		return player:GetAttribute("FlashlightOn") == true and not api.disabled
	end

	local function hideServerBeam(char)
		if not char then
			return
		end
		local function apply(d)
			if d:IsA("Light") and d.Parent and d.Parent.Name == "ServerBeam" then
				d.Brightness = 0
			end
		end
		for _, d in ipairs(char:GetDescendants()) do
			apply(d)
		end
		char.DescendantAdded:Connect(apply)
	end
	hideServerBeam(player.Character)
	player.CharacterAdded:Connect(hideServerBeam)

	function api.toggle()
		action:FireServer("flashlight")
	end

	ContextActionService:BindAction("Flashlight", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			api.toggle()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonL1)
	ContextActionService:SetTitle("Flashlight", "Фонарь")
	ContextActionService:SetPosition("Flashlight", UDim2.new(1, -200, 1, -150))

	local lastPitchSent = 0
	local lastSend = 0

	RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera
		local on = isOn()
		local color = player:GetAttribute("FlashColor")
		if typeof(color) == "Color3" then
			beam.Color = color
			hot.Color = color
			fill.Color = color
		end
		local big = player:GetAttribute("BigBattery") == true
		beam.Range = big and 78 or 62
		hot.Range = big and 90 or 75

		-- сглаженное следование за камерой + покачивание
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local moveSpeed = hum and hum.MoveDirection.Magnitude * hum.WalkSpeed or 0
		swayT += dt * (1 + moveSpeed * 0.45)
		local swayAmt = 0.012 + moveSpeed * 0.0018
		local sway = CFrame.Angles(math.sin(swayT * 2) * swayAmt, math.sin(swayT) * swayAmt * 1.4, 0)
		local target = cam.CFrame * CFrame.new(0.45, -0.35, -0.2) * sway
		current = current:Lerp(target, math.clamp(dt * 16, 0, 1))
		part.CFrame = current

		-- мерцание
		local battery = player:GetAttribute("Battery") or 100
		local monsterNear = 0
		local monster = workspace:FindFirstChild("Monster")
		if monster and monster:FindFirstChild("HumanoidRootPart") then
			local d = (monster.HumanoidRootPart.Position - cam.CFrame.Position).Magnitude
			monsterNear = math.clamp(1 - d / 32, 0, 1)
		end
		local flickerChance = 0
		if battery &lt; 20 then
			flickerChance += (20 - battery) / 20 * 0.06
		end
		flickerChance += (api.steady and 0 or monsterNear * 0.18) + api.forceFlicker
		local now = os.clock()
		if now &gt; flickerUntil then
			if math.random() &lt; flickerChance then
				flickerOn = false
				flickerUntil = now + 0.03 + math.random() * 0.12
			else
				flickerOn = true
			end
		end
		local lit = on and flickerOn
		local dim = (battery &lt; 10) and (0.45 + battery / 20) or 1
		beam.Enabled = lit
		hot.Enabled = lit
		fill.Enabled = lit
		beam.Brightness = 2.6 * dim
		hot.Brightness = 1.6 * dim

		-- отправляем серверу наклон луча, чтобы другие видели, куда ты светишь
		if on and now - lastSend &gt; 0.2 then
			local pitch = math.asin(math.clamp(cam.CFrame.LookVector.Y, -1, 1))
			if math.abs(pitch - lastPitchSent) &gt; 0.05 then
				lastPitchSent = pitch
				lastSend = now
				action:FireServer("aim", pitch)
			end
		end
	end)

	return api
end

return FL
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000006ED">
        <Properties>
          <string name="Name">MonsterAnimator</string>
          <ProtectedString name="Source">--[[
	Процедурные анимации Пациента 13 (клиент):
	- ходьба / бег с рваной походкой (хромание, длинные руки волочатся)
	- дыхание в покое, дёрганья головы, подёргивание пальцев
	- режим погони: наклон вперёд, руки тянутся к жертве, челюсть открыта
	- атака: пасть раскрывается настежь, руки вверх
	- звуки шагов из стоп + тряска камеры рядом
	Работает через Motor6D.C0 (без загрузки анимаций на сайт).
]]
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Sound = require(script.Parent.Sound)

local Animator = {}
Animator.onFootstep = nil -- function(position, intensity)

local tracked = {}
local clock = os.clock

local function noise(t, seed)
	return math.noise(t, seed or 0, 0)
end

local function collectJoints(model)
	local joints = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then
			joints[d.Name] = { motor = d, base = d.C0 }
		end
	end
	return joints
end

function Animator.track(model)
	if tracked[model] then
		return
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local joints = collectJoints(model)
	local st = {
		model = model,
		root = root,
		joints = joints,
		phase = 0,
		walk = 0,
		lastSide = 0,
		headTarget = Vector3.zero,
		headCurrent = Vector3.zero,
		nextTwitch = clock() + 1,
		jaw = 0,
		lean = 0,
		reach = 0,
		seed = math.random() * 100,
		footL = model:FindFirstChild("LFoot", true),
		footR = model:FindFirstChild("RFoot", true),
		blind = model:GetAttribute("Blind") == true,
		sniffUntil = 0,
		sonarUntil = 0,
		listen = 0,
		eyes = {},
		dust = nil,
		rage = nil,
	}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("PointLight") and d.Parent and d.Parent.Name == "Eye" then
			table.insert(st.eyes, d)
		elseif d:IsA("ParticleEmitter") and d.Name == "Dust" then
			st.dust = d
		elseif d:IsA("PointLight") and d.Name == "Rage" then
			st.rage = d
		end
	end
	model:GetAttributeChangedSignal("Sniff"):Connect(function()
		st.sniffUntil = clock() + 1.6
		st.listen = (math.random() &lt; 0.5) and -1 or 1
	end)
	model:GetAttributeChangedSignal("Sonar"):Connect(function()
		st.sonarUntil = clock() + 1.1
	end)
	model:GetAttributeChangedSignal("Blind"):Connect(function()
		st.blind = model:GetAttribute("Blind") == true
	end)
	tracked[model] = st
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			tracked[model] = nil
		end
	end)
end

local function set(st, name, cf)
	local j = st.joints[name]
	if j then
		j.motor.C0 = j.base * cf
	end
end

local A = CFrame.Angles

local function step(st, dt)
	local now = clock()
	local state = st.model:GetAttribute("State") or "Patrol"
	local vel = st.root.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local moving = math.clamp(speed / 9, 0, 1.6)
	st.walk += (moving - st.walk) * math.min(dt * 6, 1)
	local w = st.walk

	-- частота шага растёт со скоростью
	st.phase += dt * (2.2 + speed * 0.32)
	local p = st.phase
	local s = math.sin(p)
	local c = math.cos(p)

	local chasing = state == "Chase"
	local attacking = state == "Attack"
	local leanTarget = chasing and -0.38 or (attacking and 0.15 or -0.08)
	st.lean += (leanTarget - st.lean) * math.min(dt * 4, 1)
	local reachTarget = chasing and 1 or (attacking and 1.4 or 0)
	st.reach += (reachTarget - st.reach) * math.min(dt * 5, 1)
	local jawTarget = attacking and 1 or (chasing and 0.55 or 0.08 + 0.06 * math.sin(now * 1.7))
	st.jaw += (jawTarget - st.jaw) * math.min(dt * (attacking and 18 or 6), 1)

	local breath = math.sin(now * (chasing and 5 or 1.6)) * 0.035
	local limp = 0.2 -- асимметрия походки: правая нога "хромает"

	-- таз / корпус
	local bob = -math.abs(s) * 0.32 * w
	set(st, "RootJoint", CFrame.new(0, bob, 0) * A(st.lean * 0.4, s * 0.12 * w, s * 0.09 * w))
	set(st, "Waist", A(st.lean + breath - math.abs(c) * 0.06 * w, -s * 0.22 * w, -s * 0.06 * w))

	-- голова: резкие неестественные дёрганья
	if now &gt; st.nextTwitch then
		st.nextTwitch = now + (chasing and 0.25 or 0.5) + math.random() * (chasing and 0.6 or 2.2)
		st.headTarget = Vector3.new((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.9, (math.random() - 0.5) * 1.3)
	end
	local sniffing = now &lt; st.sniffUntil
	local sonar = now &lt; st.sonarUntil
	if sniffing then
		-- прислушивается: голова набок, ухом вперёд, мелкая дрожь
		st.headTarget = Vector3.new(0.15, st.listen * 1.1, st.listen * 0.7)
	elseif sonar then
		st.headTarget = Vector3.new(-0.9, 0, 0) -- запрокидывает голову для крика
	elseif st.blind and not chasing then
		-- слепой постоянно "сканирует" ушами
		st.headTarget = Vector3.new(0.1 + noise(now * 0.7, st.seed + 40) * 0.3, noise(now * 0.5, st.seed + 41) * 1.6, noise(now * 0.6, st.seed + 42) * 0.8)
	end
	st.headCurrent = st.headCurrent:Lerp(st.headTarget, math.min(dt * (sniffing and 30 or 22), 1)) -- очень быстрый рывок
	local hc = st.headCurrent
	local shiver = noise(now * 9, st.seed) * (sniffing and 0.12 or 0.05)
	set(st, "NeckBase", A(-st.lean * 0.6 + 0.1, hc.Y * 0.3, 0))
	set(st, "Neck", A(hc.X - st.lean * 0.5 + shiver, hc.Y, hc.Z + shiver))

	-- челюсть (при эхо-крике пасть раскрыта до предела)
	local tremble = (chasing or attacking) and noise(now * 30, st.seed + 3) * 0.08 or 0
	local jawOpen = sonar and 1.3 or st.jaw
	set(st, "Jaw", A(-jawOpen * 0.85 + tremble, 0, 0))

	-- глаза и "ярость"
	local eyeBright = attacking and 3 or (chasing and 1.8 or 0.35)
	for _, e in ipairs(st.eyes) do
		e.Brightness = eyeBright + noise(now * 6, st.seed + 50) * 0.2
	end
	if st.rage then
		st.rage.Brightness = (st.model:GetAttribute("Enraged") and 0.8 or 0) + (attacking and 1.5 or 0)
	end
	if st.dust then
		st.dust.Enabled = w &gt; 0.3
		st.dust.Rate = 6 + w * 10
	end

	-- ноги (колени согнуты, шаг широкий)
	local legSwing = 0.65 * w
	local function leg(side, ph, amp)
		local sp = math.sin(ph)
		local lift = math.max(0, math.cos(ph))
		set(st, side .. "Hip", A(sp * legSwing * amp + 0.1, 0, 0))
		set(st, side .. "Knee", A(-(lift * 1.0 * w + 0.05), 0, 0))
		set(st, side .. "Ankle", A(-sp * 0.35 * w + lift * 0.4 * w, 0, 0))
	end
	leg("L", p, 1)
	leg("R", p + math.pi, 1 - limp)

	-- руки: длинные, болтаются с запаздыванием; в погоне тянутся вперёд
	local r = st.reach
	local function arm(side, ph, sign)
		local sw = math.sin(ph - 0.5) * 0.55 * w
		local twitch = noise(now * 3, st.seed + (sign &gt; 0 and 10 or 20)) * 0.12
		set(st, side .. "Shoulder", A(-sw + r * 1.15 + twitch, 0, sign * (0.12 + r * 0.15)))
		set(st, side .. "Elbow", A(0.25 + math.max(0, -math.sin(ph)) * 0.35 * w + r * 0.3, 0, 0))
		set(st, side .. "Wrist", A(0.15 + twitch * 2 - r * 0.4, 0, 0))
		for i = 1, 4 do
			local fn = noise(now * (attacking and 12 or 4), st.seed + i * 7 + sign * 3)
			local curl = 0.25 + fn * 0.35 - r * 0.2
			set(st, side .. "F" .. i .. "a", A(curl, 0, 0))
			set(st, side .. "F" .. i .. "b", A(curl * 1.3, 0, 0))
		end
	end
	arm("L", p + math.pi, -1)
	arm("R", p, 1)

	-- шаги: каждые полпериода одна нога бьёт о пол
	local side = s &gt;= 0 and 1 or -1
	if side ~= st.lastSide then
		st.lastSide = side
		if w &gt; 0.25 then
			local foot = side &gt; 0 and st.footR or st.footL
			local pos = foot and foot.Position or st.root.Position
			Sound.play("MonsterStep", foot or st.root, {
				Volume = 0.6 + 0.5 * math.min(w, 1.4),
				PlaybackSpeed = 0.85 + math.random() * 0.2,
				RollOffMinDistance = 10,
				RollOffMaxDistance = 110,
			})
			if Animator.onFootstep then
				Animator.onFootstep(pos, w)
			end
		end
	end
end

local started = false
function Animator.start()
	if started then
		return
	end
	started = true
	RunService.RenderStepped:Connect(function(dt)
		for model, st in pairs(tracked) do
			if model.Parent and st.root.Parent then
				step(st, dt)
			else
				tracked[model] = nil
			end
		end
	end)
end

-- камера трясётся от шагов рядом
function Animator.shakeAmountFor(position)
	local cam = workspace.CurrentCamera
	if not cam then
		return 0
	end
	local d = (cam.CFrame.Position - position).Magnitude
	return math.clamp(1 - d / 35, 0, 1)
end

local _ = Players
return Animator
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000006EE">
        <Properties>
          <string name="Name">Sound</string>
          <ProtectedString name="Source">-- Проигрывание звуков по ключу из Config.Sounds. Если ID = 0 — тихо пропускаем (без ошибок).
-- Все звуки идут через SoundGroup'ы SoundService.Master -&gt; Music / SFX, чтобы работал ползунок громкости.
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)

local Sound = {}

local MUSIC_KEYS = { MenuMusic = true, Ambience = true, AmbienceMorgue = true, AmbienceForest = true, Wind = true }

local function ensureGroup(parent, name)
	local g = parent:FindFirstChild(name)
	if not g and RunService:IsClient() then
		g = parent:WaitForChild(name, 5) -- группы лежат в плейсе, ждём репликацию
	end
	if not g then
		g = Instance.new("SoundGroup")
		g.Name = name
		g.Volume = 1
		g.Parent = parent
	end
	return g
end

-- группы создаёт сервер (реплицируются), клиент только меняет Volume у себя
local master = ensureGroup(SoundService, "Master")
local musicGroup = ensureGroup(master, "Music")
local sfxGroup = ensureGroup(master, "SFX")
Sound.groups = { master = master, music = musicGroup, sfx = sfxGroup }

function Sound.id(key)
	local v = Config.Sounds[key]
	if v == nil or v == 0 or v == "" then
		return nil
	end
	if typeof(v) == "number" then
		return "rbxassetid://" .. tostring(v)
	end
	return tostring(v)
end

-- создать Sound (не запуская). parent = часть/аттачмент для 3D, nil = 2D
function Sound.make(key, parent, props)
	local id = Sound.id(key)
	if not id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = id
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 8
	s.RollOffMaxDistance = 90
	s.SoundGroup = MUSIC_KEYS[key] and musicGroup or sfxGroup
	if props then
		for k, v in pairs(props) do
			s[k] = v
		end
	end
	s.Parent = parent or SoundService
	return s
end

-- одноразовый звук
function Sound.play(key, parent, props)
	local s = Sound.make(key, parent, props)
	if not s then
		return nil
	end
	if not s.Looped then
		s.Ended:Connect(function()
			s:Destroy()
		end)
		Debris:AddItem(s, 25)
	end
	s:Play()
	return s
end

-- звук в точке пространства
function Sound.playAt(key, position, props)
	if not Sound.id(key) then
		return nil
	end
	local a = Instance.new("Attachment")
	a.WorldPosition = position
	a.Parent = workspace.Terrain
	Debris:AddItem(a, 25)
	return Sound.play(key, a, props)
end

-- громкость (клиент): значения 0..1
function Sound.setVolumes(masterV, musicV, sfxV)
	if RunService:IsClient() then
		master.Volume = math.clamp(masterV or 1, 0, 1)
		musicGroup.Volume = math.clamp(musicV or 1, 0, 1)
		sfxGroup.Volume = math.clamp(sfxV or 1, 0, 1)
	end
end

return Sound
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000006EF">
        <Properties>
          <string name="Name">UI</string>
          <ProtectedString name="Source">-- Криповый UI-кит: кнопки с мерцанием, окна, тосты, виньетка
local TweenService = game:GetService("TweenService")
local Sound = require(script.Parent.Sound)

local UI = {}

UI.Colors = {
	Bg = Color3.fromRGB(6, 5, 5),
	Panel = Color3.fromRGB(14, 11, 11),
	Panel2 = Color3.fromRGB(22, 16, 16),
	Red = Color3.fromRGB(150, 14, 14),
	BrightRed = Color3.fromRGB(235, 40, 40),
	Text = Color3.fromRGB(222, 212, 200),
	Dim = Color3.fromRGB(125, 115, 110),
	Gold = Color3.fromRGB(235, 185, 70),
	Green = Color3.fromRGB(110, 200, 110),
}

local function safeFont(name, fallback)
	local ok, f = pcall(function()
		return Enum.Font[name]
	end)
	if ok and f then
		return f
	end
	return fallback
end

-- шрифты с кириллицей
UI.FontTitle = safeFont("Oswald", Enum.Font.SourceSansBold)
UI.FontMono = safeFont("RobotoMono", Enum.Font.Code)
UI.FontText = safeFont("SourceSans", Enum.Font.SourceSans)
UI.FontBold = safeFont("SourceSansBold", Enum.Font.SourceSansBold)

function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(r)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 6) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Red,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function UI.tween(obj, time, props, style, dir)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function UI.label(props)
	local base = {
		BackgroundTransparency = 1,
		Font = UI.FontText,
		TextColor3 = UI.Colors.Text,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	return UI.new("TextLabel", base)
end

-- жуткая кнопка: мерцает при наведении, текст краснеет
function UI.button(props, onClick)
	local base = {
		AutoButtonColor = false,
		BackgroundColor3 = UI.Colors.Panel2,
		BackgroundTransparency = 0.15,
		Font = UI.FontTitle,
		TextColor3 = UI.Colors.Text,
		TextSize = 20,
		Text = "КНОПКА",
	}
	for k, v in pairs(props or {}) do
		if k ~= "NoStroke" then
			base[k] = v
		end
	end
	local btn = UI.new("TextButton", base)
	if not props or props.NoStroke ~= true then
		UI.stroke(UI.Colors.Red, 1, 0.4).Parent = btn
	end
	local normalColor = btn.TextColor3
	local hovering = false
	btn.MouseEnter:Connect(function()
		hovering = true
		Sound.play("UIHover", nil, { Volume = 0.5, PlaybackSpeed = 0.9 + math.random() * 0.2 })
		UI.tween(btn, 0.12, { TextColor3 = UI.Colors.BrightRed })
		task.spawn(function()
			for _ = 1, 6 do
				if not hovering then
					break
				end
				btn.TextTransparency = math.random() &lt; 0.5 and 0.6 or 0
				task.wait(0.03 + math.random() * 0.05)
			end
			btn.TextTransparency = 0
		end)
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		btn.TextTransparency = 0
		UI.tween(btn, 0.2, { TextColor3 = normalColor })
	end)
	btn.Activated:Connect(function()
		Sound.play("UIClick", nil, { Volume = 0.7 })
		if onClick then
			onClick()
		end
	end)
	return btn
end

-- чёрная виньетка по краям экрана
function UI.vignette(parent, strength)
	strength = strength or 0
	local holder = UI.new("Frame", {
		Name = "Vignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = parent,
	})
	local function edge(rot, size, pos, anchor)
		local f = UI.new("Frame", {
			Size = size,
			Position = pos,
			AnchorPoint = anchor,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			BackgroundTransparency = strength,
			ZIndex = 1,
			Parent = holder,
		})
		UI.new("UIGradient", {
			Rotation = rot,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = f,
		})
		return f
	end
	edge(0, UDim2.fromScale(0.28, 1), UDim2.fromScale(0, 0), Vector2.new(0, 0))
	edge(180, UDim2.fromScale(0.28, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0))
	edge(90, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0), Vector2.new(0, 0))
	edge(-90, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 1), Vector2.new(0, 1))
	return holder
end

-- окно-панель с заголовком и крестиком
function UI.window(parent, titleText, size)
	local win = UI.new("Frame", {
		Name = "Window",
		Size = size or UDim2.fromOffset(760, 480),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	}, {
		UI.corner(4),
		UI.stroke(UI.Colors.Red, 2, 0.2),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(980, 640) }),
	})
	UI.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(30, 14, 14), Color3.fromRGB(8, 6, 6)),
		Parent = win,
	})
	local title = UI.label({
		Name = "Title",
		Text = titleText,
		Font = UI.FontTitle,
		TextSize = 30,
		TextColor3 = UI.Colors.BrightRed,
		Size = UDim2.new(1, -80, 0, 44),
		Position = UDim2.fromOffset(18, 6),
		ZIndex = 21,
		Parent = win,
	})
	local line = UI.new("Frame", {
		Size = UDim2.new(1, -36, 0, 1),
		Position = UDim2.fromOffset(18, 52),
		BackgroundColor3 = UI.Colors.Red,
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = win,
	})
	local close = UI.button({
		Text = "✕",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -50, 0, 8),
		TextSize = 22,
		ZIndex = 22,
		Parent = win,
	})
	local content = UI.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -36, 1, -72),
		Position = UDim2.fromOffset(18, 62),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = win,
	})
	local api = { frame = win, content = content, title = title, line = line, onClose = nil }
	function api.open()
		win.Visible = true
		win.Size = (size or UDim2.fromOffset(760, 480)) - UDim2.fromOffset(40, 30)
		UI.tween(win, 0.18, { Size = size or UDim2.fromOffset(760, 480) }, Enum.EasingStyle.Back)
		task.spawn(function()
			for _ = 1, 5 do
				title.TextTransparency = math.random() &lt; 0.5 and 0.7 or 0
				task.wait(0.05)
			end
			title.TextTransparency = 0
		end)
	end
	function api.close()
		win.Visible = false
		if api.onClose then
			api.onClose()
		end
	end
	close.Activated:Connect(api.close)
	return api
end

-- всплывающее уведомление
local toastHolders = {}
function UI.toast(screenGui, text, color)
	local holder = toastHolders[screenGui]
	if not holder or not holder.Parent then
		holder = UI.new("Frame", {
			Name = "Toasts",
			Size = UDim2.new(0, 420, 1, -40),
			Position = UDim2.new(1, -20, 0, 20),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			ZIndex = 50,
			Parent = screenGui,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 6),
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		toastHolders[screenGui] = holder
	end
	local t = UI.label({
		Text = text,
		Font = UI.FontMono,
		TextSize = 16,
		TextColor3 = color or UI.Colors.Text,
		BackgroundColor3 = Color3.fromRGB(10, 6, 6),
		BackgroundTransparency = 0.15,
		Size = UDim2.fromOffset(400, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 51,
		Parent = holder,
	}, nil)
	UI.padding(10).Parent = t
	UI.stroke(UI.Colors.Red, 1, 0.3).Parent = t
	task.delay(4, function()
		if t.Parent then
			UI.tween(t, 0.4, { TextTransparency = 1, BackgroundTransparency = 1 })
			task.wait(0.45)
			t:Destroy()
		end
	end)
	return t
end

-- глитч-заголовок: три слоя (белый + красный + голубой со сдвигом)
function UI.glitchTitle(parent, text, size, position, textSize)
	local holder = UI.new("Frame", {
		Size = size,
		Position = position,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = parent,
	})
	local function layer(color, z, tr)
		return UI.label({
			Text = text,
			Font = UI.FontTitle,
			TextSize = textSize,
			TextColor3 = color,
			TextTransparency = tr,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = false,
			ZIndex = z,
			Parent = holder,
		})
	end
	local cyan = layer(Color3.fromRGB(60, 220, 255), 5, 0.55)
	local red = layer(Color3.fromRGB(255, 20, 20), 6, 0.25)
	local main = layer(Color3.fromRGB(235, 225, 215), 7, 0)
	local alive = true
	task.spawn(function()
		while alive and holder.Parent do
			local glitch = math.random() &lt; 0.12
			if glitch then
				for _ = 1, math.random(3, 8) do
					red.Position = UDim2.fromOffset(math.random(-9, 9), math.random(-3, 3))
					cyan.Position = UDim2.fromOffset(math.random(-9, 9), math.random(-3, 3))
					main.Position = UDim2.fromOffset(math.random(-3, 3), 0)
					main.TextTransparency = math.random() &lt; 0.3 and 0.8 or 0
					task.wait(0.03)
				end
			end
			red.Position = UDim2.fromOffset(2, 1)
			cyan.Position = UDim2.fromOffset(-2, 0)
			main.Position = UDim2.fromOffset(0, 0)
			main.TextTransparency = 0
			task.wait(0.08 + math.random() * 0.25)
		end
	end)
	return holder, function()
		alive = false
	end
end

-- ползунок 0..1 (мышь + тач). onChange(value) вызывается при перетаскивании.
function UI.slider(props, value, onChange)
	local UserInputService = game:GetService("UserInputService")
	local holder = UI.new("Frame", {
		Size = props.Size or UDim2.fromOffset(240, 36),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 21,
		Parent = props.Parent,
	})
	local track = UI.new("Frame", {
		Size = UDim2.new(1, -60, 0, 6),
		Position = UDim2.new(0, 0, 0.5, -3),
		BackgroundColor3 = Color3.fromRGB(28, 14, 14),
		BorderSizePixel = 0,
		ZIndex = holder.ZIndex,
		Parent = holder,
	}, { UI.stroke(UI.Colors.Red, 1, 0.5) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(value, 1),
		BackgroundColor3 = props.Color or UI.Colors.Red,
		BorderSizePixel = 0,
		ZIndex = holder.ZIndex + 1,
		Parent = track,
	})
	local knob = UI.new("Frame", {
		Size = UDim2.fromOffset(14, 22),
		Position = UDim2.new(value, -7, 0.5, -11),
		BackgroundColor3 = UI.Colors.Text,
		BorderSizePixel = 0,
		ZIndex = holder.ZIndex + 2,
		Parent = track,
	}, { UI.corner(2) })
	local valueLabel = UI.label({
		Text = math.floor(value * 100 + 0.5) .. "%",
		Font = UI.FontMono,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(52, 36),
		Position = UDim2.new(1, -52, 0, 0),
		ZIndex = holder.ZIndex + 1,
		Parent = holder,
	})
	local hit = UI.new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		ZIndex = holder.ZIndex + 3,
		Parent = track,
	})
	local dragging = false
	local api = { frame = holder, value = value }
	local function setFromX(x)
		local v = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		v = math.floor(v * 100 + 0.5) / 100
		api.value = v
		fill.Size = UDim2.fromScale(v, 1)
		knob.Position = UDim2.new(v, -7, 0.5, -11)
		valueLabel.Text = math.floor(v * 100 + 0.5) .. "%"
		if onChange then
			onChange(v)
		end
	end
	function api.set(v)
		v = math.clamp(v or 0, 0, 1)
		api.value = v
		fill.Size = UDim2.fromScale(v, 1)
		knob.Position = UDim2.new(v, -7, 0.5, -11)
		valueLabel.Text = math.floor(v * 100 + 0.5) .. "%"
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				Sound.play("UIClick", nil, { Volume = 0.4 })
			end
		end
	end)
	return api
end

-- ряд вкладок. tabs = { {id=, text=}, ... }; onSelect(id)
function UI.tabs(parent, tabs, selectedId, onSelect, props)
	props = props or {}
	local row = UI.new("Frame", {
		Size = props.Size or UDim2.new(1, 0, 0, 40),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 21,
		Parent = parent,
	}, { UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local buttons = {}
	local api = { frame = row, selected = selectedId }
	local function paint()
		for id, b in pairs(buttons) do
			local on = id == api.selected
			b.BackgroundColor3 = on and Color3.fromRGB(120, 18, 18) or UI.Colors.Panel2
			b.TextColor3 = on and UI.Colors.Text or UI.Colors.Dim
		end
	end
	for i, t in ipairs(tabs) do
		buttons[t.id] = UI.button({
			Text = t.text,
			TextSize = props.TextSize or 17,
			Size = UDim2.fromOffset(props.Width or 150, props.Height or 38),
			LayoutOrder = i,
			ZIndex = row.ZIndex + 1,
			Parent = row,
		}, function()
			api.selected = t.id
			paint()
			if onSelect then
				onSelect(t.id)
			end
		end)
	end
	function api.select(id)
		api.selected = id
		paint()
	end
	paint()
	return api
end

-- выбор одного варианта из списка (сложность, число игроков)
function UI.choice(parent, options, selectedId, onSelect, props)
	props = props or {}
	local row = UI.new("Frame", {
		Size = props.Size or UDim2.new(1, 0, 0, 44),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 21,
		Parent = parent,
	}, { UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local buttons = {}
	local api = { frame = row, selected = selectedId }
	local function paint()
		for id, b in pairs(buttons) do
			local on = id == api.selected
			local opt = b:GetAttribute("Color")
			b.BackgroundColor3 = on and (opt or Color3.fromRGB(120, 18, 18)) or UI.Colors.Panel2
			b.BackgroundTransparency = on and 0.35 or 0.15
			b.TextColor3 = on and Color3.new(1, 1, 1) or UI.Colors.Dim
		end
	end
	for i, o in ipairs(options) do
		local b = UI.button({
			Text = o.text,
			TextSize = props.TextSize or 16,
			Size = UDim2.fromOffset(props.Width or 110, props.Height or 40),
			LayoutOrder = i,
			ZIndex = row.ZIndex + 1,
			Parent = row,
		}, function()
			api.selected = o.id
			paint()
			if onSelect then
				onSelect(o.id)
			end
		end)
		if o.color then
			b:SetAttribute("Color", o.color)
		end
		buttons[o.id] = b
	end
	function api.select(id)
		api.selected = id
		paint()
	end
	paint()
	return api
end

return UI
